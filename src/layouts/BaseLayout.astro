---
import '../styles/global.css';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import jakartaLatinWoff2 from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_META,
  LOCALE_SOURCE_STORAGE_KEY,
  LOCALE_STORAGE_KEY,
  getHreflangAlternates,
  localizedPath,
  stripLocalePrefix,
  type Locale,
} from '../i18n/config.ts';
import { getDict, getRuntimePayload } from '../i18n/index.ts';

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  canonicalPath?: string;
  breadcrumbLabel?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
  bodyClass?: string;
  skipHref?: string;
}

const {
  locale = DEFAULT_LOCALE,
  title,
  description,
  canonicalPath = Astro.url.pathname,
  breadcrumbLabel,
  ogType = 'website',
  structuredData,
  robots = 'index, follow',
  bodyClass = 'min-h-screen flex flex-col bg-canvas text-body selection:bg-link-soft selection:text-ink',
  skipHref = '#main-content',
} = Astro.props;

const meta = LOCALE_META[locale];
const dict = getDict(locale);
const siteOrigin = Astro.site ? Astro.site.origin : 'https://onlinerulerplus.com';

const baseRoute = stripLocalePrefix(canonicalPath);
const effectiveCanonicalPath = localizedPath(locale, baseRoute);
const canonicalUrl =
  effectiveCanonicalPath === '/' ? `${siteOrigin}/` : `${siteOrigin}${effectiveCanonicalPath}`;

const homePath = localizedPath(locale, '/');
const homeUrl = homePath === '/' ? `${siteOrigin}/` : `${siteOrigin}${homePath}`;

const hreflangAlternates = getHreflangAlternates(siteOrigin, baseRoute);
const ogImageUrl = `${siteOrigin}/og-image.png`;
const ogImageAlt = dict.meta.ogImageAlt;

const organizationSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteOrigin}/#organization`,
  name: 'Online Ruler Plus',
  url: `${siteOrigin}/`,
  logo: {
    '@type': 'ImageObject',
    url: ogImageUrl,
    width: 1200,
    height: 630,
  },
  description: dict.meta.orgDescription,
  knowsAbout: dict.meta.knowsAbout,
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'support@onlinerulerplus.com',
    contactType: 'customer support',
    availableLanguage: [...LOCALES],
  },
};

const websiteSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${homeUrl}#website`,
  url: homeUrl,
  name: 'Online Ruler Plus',
  inLanguage: meta.bcp47,
  publisher: {
    '@id': `${siteOrigin}/#organization`,
  },
};

const extraSchemas: Record<string, unknown>[] = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];

const hasExplicitBreadcrumb = extraSchemas.some(
  (item) => item['@type'] === 'BreadcrumbList',
);

const breadcrumbSchema: Record<string, unknown> | null =
  baseRoute !== '/' && !hasExplicitBreadcrumb
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        '@id': `${canonicalUrl}#breadcrumb`,
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Online Ruler Plus',
            item: homeUrl,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: breadcrumbLabel || title.split(/[|—:]/)[0].trim(),
            item: canonicalUrl,
          },
        ],
      }
    : null;

const fullStructuredData: Record<string, unknown>[] = [
  organizationSchema,
  websiteSchema,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...extraSchemas,
];

const runtimePayloadJson = JSON.stringify(getRuntimePayload(locale)).replace(/</g, '\\u003c');
const skipLabel = skipHref === '#ruler-tool' ? dict.nav.skipToWorkspace : dict.nav.skipToMain;
---

<!doctype html>
<html lang={meta.bcp47}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={interLatinWoff2} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={jakartaLatinWoff2} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />
    {hreflangAlternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Online Ruler Plus" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script is:inline define:vars={{ LOCALES, LOCALE_STORAGE_KEY, LOCALE_SOURCE_STORAGE_KEY }}>
      (() => {
        try {
          const savedTheme = localStorage.getItem('orp:theme');
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
          }
          const rawPrefs = localStorage.getItem('orp:preferences:v1');
          if (rawPrefs) {
            const parsedPrefs = JSON.parse(rawPrefs);
            if (parsedPrefs && parsedPrefs.focusMode === true) {
              document.documentElement.dataset.focusMode = 'true';
            }
          }
          if (window.location.search.includes('embed=1')) {
            document.documentElement.dataset.embedMode = 'true';
          }
        } catch {
          // Ignore storage access errors
        }

        // First-visit browser locale detection on bare root (/): suggest non-intrusively without hijacking URL
        try {
          const path = window.location.pathname.replace(/\/+$/, '') || '/';
          if (path === '/') {
            const savedLocale = localStorage.getItem(LOCALE_STORAGE_KEY);
            if (!savedLocale) {
              const langs = Array.isArray(navigator.languages) && navigator.languages.length > 0
                ? navigator.languages
                : [navigator.language || 'en'];
              let matched = 'en';
              for (const raw of langs) {
                const tag = String(raw || '').trim().toLowerCase();
                if (!tag) continue;
                const primary = tag.split(/[-_]/)[0];
                const code = primary === 'in' ? 'id' : primary;
                if (LOCALES.includes(code)) {
                  matched = code;
                  break;
                }
              }
              if (matched !== 'en') {
                document.documentElement.dataset.suggestedLocale = matched;
              }
            }
          }
        } catch {
          // Ignore storage / navigation restrictions
        }
      })();
    </script>

    <script id="orp-i18n-data" type="application/json" set:html={runtimePayloadJson} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(fullStructuredData)}
    />
  </head>
  <body class={bodyClass}>
    <a
      href={skipHref}
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 apple-btn-primary-compact"
    >
      {skipLabel}
    </a>
    <slot />
  </body>
</html>
