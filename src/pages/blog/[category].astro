---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import HelpModal from '../../components/HelpModal.astro';
import Footer from '../../components/Footer.astro';
import {
  BLOG_CATEGORIES,
  BLOG_CATEGORY_MAP,
  estimateReadingTimeMinutes,
  formatEditorialDate,
  type BlogCategorySlug,
} from '../../lib/blog.ts';

export function getStaticPaths() {
  return BLOG_CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props as { category: (typeof BLOG_CATEGORIES)[number] };

const categoryPosts = (
  await getCollection('blog', ({ data }) => !data.draft && data.category === category.slug)
).sort(
  (a, b) => (b.data.updatedDate ?? b.data.pubDate).getTime() - (a.data.updatedDate ?? a.data.pubDate).getTime(),
);

const siteOrigin = Astro.site ? Astro.site.origin : 'https://onlinerulerplus.com';
const canonicalPath = `/blog/${category.slug}`;
const canonicalUrl = `${siteOrigin}${canonicalPath}`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Online Ruler Plus', item: `${siteOrigin}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteOrigin}/blog` },
      { '@type': 'ListItem', position: 3, name: category.name, item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${canonicalUrl}#collection`,
    url: canonicalUrl,
    name: category.seoTitle,
    description: category.description,
    inLanguage: 'en-US',
    isPartOf: { '@id': `${siteOrigin}/#website` },
    publisher: { '@id': `${siteOrigin}/#organization` },
  },
];
---

<BaseLayout
  locale="en"
  title={category.seoTitle}
  description={category.description}
  canonicalPath={canonicalPath}
  breadcrumbLabel={category.name}
  ogImage={category.ogImage}
  ogImageAlt={category.ogImageAlt}
  disableHreflang={true}
  structuredData={structuredData}
>
  <Header
    locale="en"
    subNavTitle={category.shortName}
    subNavCtaHref={category.primaryToolHref}
    subNavCtaLabel={category.primaryToolLabel}
  />
  <main id="main-content" class="flex-1">
    <section class="apple-page-hero border-b border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 type-caption text-ink-muted-80">
          <a href="/" class="hover:text-link hover:underline">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog" class="hover:text-link hover:underline">Blog</a>
          <span aria-hidden="true">/</span>
          <span class="font-medium text-ink" aria-current="page">{category.name}</span>
        </nav>

        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <p class="type-kicker">{category.code} · {categoryPosts.length} Guides</p>
            <h1 class="mt-2 type-hero-display text-ink">{category.name}</h1>
            <p class="speakable-summary mt-3 max-w-[64ch] type-lead-airy text-ink-muted-80">
              {category.intro}
            </p>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a href={category.primaryToolHref} class="apple-btn-primary">{category.primaryToolLabel}</a>
            <a href="/blog" class="apple-btn-secondary-pill">All Blog Guides</a>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-2" aria-label="Browse categories">
          <a href="/blog" class="apple-chip">All Categories</a>
          {
            BLOG_CATEGORIES.map((item) => (
              <a
                href={`/blog/${item.slug}`}
                aria-current={item.slug === category.slug ? 'page' : undefined}
                class:list={['apple-chip', item.slug === category.slug && 'is-active']}
              >
                {item.shortName}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="apple-tile-light">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            categoryPosts.map((post) => {
              const cat = BLOG_CATEGORY_MAP[post.data.category as BlogCategorySlug];
              const minutes = estimateReadingTimeMinutes(post.body);
              const displayDate = formatEditorialDate(post.data.updatedDate ?? post.data.pubDate);

              return (
                <article class="apple-utility-card flex flex-col justify-between hover:border-primary-focus transition-colors">
                  <div>
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <span class="rounded-full bg-canvas-parchment px-2.5 py-0.5 font-mono text-[11px] font-semibold text-link">
                        {cat.shortName}
                      </span>
                      <span class="font-mono text-[11px] text-ink-muted-48">
                        {minutes} min read · {displayDate}
                      </span>
                    </div>

                    <h2 class="mt-3 type-tagline text-ink">
                      <a href={`/blog/${post.id}`} class="hover:text-link transition-colors">
                        {post.data.title}
                      </a>
                    </h2>

                    <p class="mt-2.5 type-caption text-ink-muted-80">
                      {post.data.description}
                    </p>
                  </div>

                  <div class="mt-5 flex items-center justify-between border-t border-hairline pt-3.5">
                    <span class="font-mono text-[11px] text-ink-muted-48 truncate pr-2">
                      {post.data.primaryKeyword}
                    </span>
                    <a
                      href={`/blog/${post.id}`}
                      class="shrink-0 type-caption font-semibold text-link hover:underline"
                    >
                      Read guide →
                    </a>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
  <HelpModal locale="en" />
  <Footer locale="en" />
  <script src="../../scripts/app.ts"></script>
</BaseLayout>
