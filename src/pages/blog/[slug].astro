---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import HelpModal from '../../components/HelpModal.astro';
import Footer from '../../components/Footer.astro';
import {
  BLOG_CATEGORY_MAP,
  estimateReadingTimeMinutes,
  formatEditorialDate,
  resolveRelatedArticles,
} from '../../lib/blog.ts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  allPosts: CollectionEntry<'blog'>[];
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);

const category = BLOG_CATEGORY_MAP[post.data.category];
const readingMinutes = estimateReadingTimeMinutes(post.body);
const pubIso = post.data.pubDate.toISOString().slice(0, 10);
const modIso = (post.data.updatedDate ?? post.data.pubDate).toISOString().slice(0, 10);
const pubFormatted = formatEditorialDate(post.data.pubDate);
const modFormatted = post.data.updatedDate ? formatEditorialDate(post.data.updatedDate) : null;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const relatedPosts = resolveRelatedArticles(post, allPosts, 3);

const siteOrigin = Astro.site ? Astro.site.origin : 'https://onlinerulerplus.com';
const canonicalPath = `/blog/${post.id}`;
const canonicalUrl = `${siteOrigin}${canonicalPath}`;
const ogImageAbs = `${siteOrigin}${post.data.ogImage}`;

const structuredData: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Online Ruler Plus', item: `${siteOrigin}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteOrigin}/blog` },
      { '@type': 'ListItem', position: 3, name: category.name, item: `${siteOrigin}/blog/${category.slug}` },
      { '@type': 'ListItem', position: 4, name: post.data.title, item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${canonicalUrl}#article`,
    headline: post.data.title,
    description: post.data.description,
    image: {
      '@type': 'ImageObject',
      url: ogImageAbs,
      width: 1200,
      height: 630,
    },
    datePublished: pubIso,
    dateModified: modIso,
    inLanguage: 'en-US',
    articleSection: category.name,
    keywords: [post.data.primaryKeyword, ...post.data.secondaryKeywords].join(', '),
    author: { '@id': `${siteOrigin}/#organization` },
    publisher: { '@id': `${siteOrigin}/#organization` },
    mainEntityOfPage: canonicalUrl,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', '.speakable-summary'],
    },
  },
];

if (post.data.faqs.length > 0) {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    inLanguage: 'en-US',
    mainEntity: post.data.faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  });
}
---

<BaseLayout
  locale="en"
  title={post.data.seoTitle}
  description={post.data.description}
  canonicalPath={canonicalPath}
  breadcrumbLabel={post.data.title}
  ogType="article"
  ogImage={post.data.ogImage}
  ogImageAlt={post.data.ogImageAlt}
  disableHreflang={true}
  publishedTime={pubIso}
  modifiedTime={modIso}
  structuredData={structuredData}
>
  <Header
    locale="en"
    subNavTitle={category.shortName}
    subNavCtaHref={post.data.recommendedTools[0]?.href ?? '/#ruler-tool'}
    subNavCtaLabel={post.data.recommendedTools[0]?.label ?? 'Open Ruler'}
  />
  <main id="main-content" class="flex-1">
    <!-- Article Hero -->
    <header class="apple-page-hero border-b border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 type-caption text-ink-muted-80">
          <a href="/" class="hover:text-link hover:underline">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog" class="hover:text-link hover:underline">Blog</a>
          <span aria-hidden="true">/</span>
          <a href={`/blog/${category.slug}`} class="hover:text-link hover:underline">{category.name}</a>
          <span aria-hidden="true">/</span>
          <span class="font-medium text-ink truncate max-w-[40ch]" aria-current="page">{post.data.title}</span>
        </nav>

        <div class="max-w-4xl">
          <div class="flex flex-wrap items-center gap-3">
            <a
              href={`/blog/${category.slug}`}
              class="rounded-full bg-canvas px-3 py-1 border border-hairline font-mono text-xs font-semibold text-link hover:border-primary-focus"
            >
              {category.name}
            </a>
            <span class="font-mono text-xs text-ink-muted-80">{readingMinutes} min read</span>
            <span class="text-ink-muted-48">·</span>
            <time datetime={pubIso} class="font-mono text-xs text-ink-muted-80">
              Published {pubFormatted}
            </time>
            {modFormatted && modIso !== pubIso && (
              <>
                <span class="text-ink-muted-48">·</span>
                <time datetime={modIso} class="font-mono text-xs font-semibold text-ink">
                  Updated {modFormatted}
                </time>
              </>
            )}
          </div>

          <h1 class="mt-3 type-hero-display text-ink">{post.data.title}</h1>
          <p class="mt-3 max-w-[66ch] type-lead-airy text-ink-muted-80">
            {post.data.description}
          </p>
        </div>
      </div>
    </header>

    <!-- Editorial Body + Sticky TOC Sidebar -->
    <article class="apple-tile-light">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-start">
          <!-- Main Reading Column -->
          <div class="lg:col-span-8 max-w-[74ch]">
            <!-- Direct Answer Box -->
            <section
              aria-label="Direct Answer"
              class="speakable-summary rounded-[18px] border border-primary/25 bg-canvas-parchment p-5 sm:p-6"
            >
              <p class="type-kicker">Quick Answer</p>
              <p class="mt-1.5 type-body text-ink">{post.data.directAnswer}</p>
            </section>

            <!-- Hero Technical Diagram -->
            <figure class="mt-8 rounded-[18px] border border-hairline bg-surface-pearl p-3 sm:p-4">
              <div class="overflow-hidden rounded-[12px] border border-hairline/70 bg-canvas" style="aspect-ratio: 720 / 400;">
                <img
                  src={post.data.heroDiagram}
                  alt={post.data.heroDiagramAlt}
                  width="720"
                  height="400"
                  loading="eager"
                  decoding="async"
                  class="block h-full w-full object-contain"
                />
              </div>
              {post.data.heroDiagramCaption && (
                <figcaption class="mt-2.5 px-1 type-caption text-ink-muted-80">
                  {post.data.heroDiagramCaption}
                </figcaption>
              )}
            </figure>

            <!-- Markdown Article Body -->
            <div class="editorial-prose mt-8">
              <Content />
            </div>

            <!-- Contextual Tool Links -->
            <section aria-labelledby="article-tools-heading" class="mt-12 rounded-[18px] border border-hairline bg-canvas-parchment p-6">
              <p class="type-kicker">Interactive Tools on OnlineRulerPlus</p>
              <h2 id="article-tools-heading" class="mt-1 type-tagline text-ink">
                Try It in the Calibrated Workspace
              </h2>
              <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
                {
                  post.data.recommendedTools.map((tool) => (
                    <a
                      href={tool.href}
                      class="rounded-[14px] border border-hairline bg-canvas p-4 hover:border-primary-focus transition-colors"
                    >
                      <span class="type-body-strong text-link">{tool.label} →</span>
                      <p class="mt-1 type-fine-print text-ink-muted-80 leading-relaxed">{tool.desc}</p>
                    </a>
                  ))
                }
              </div>
            </section>

            <!-- Article FAQs -->
            {post.data.faqs.length > 0 && (
              <section id="article-faqs" aria-labelledby="article-faqs-heading" class="mt-12">
                <p class="type-kicker">Questions & Answers</p>
                <h2 id="article-faqs-heading" class="mt-1 type-display-md text-ink">
                  Frequently Asked Questions
                </h2>
                <div class="mt-5 space-y-3">
                  {
                    post.data.faqs.map((item) => (
                      <details open class="group apple-utility-card">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-ink">
                          <h3 class="type-body-strong text-ink">{item.q}</h3>
                          <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-canvas-parchment font-mono text-base text-link group-open:rotate-45 transition-transform">
                            +
                          </span>
                        </summary>
                        <p class="mt-3 max-w-[65ch] type-caption text-ink-muted-80 border-t border-hairline pt-3">
                          {item.a}
                        </p>
                      </details>
                    ))
                  }
                </div>
              </section>
            )}

            <!-- Trustworthy Sources -->
            <section id="sources" aria-labelledby="sources-heading" class="mt-12 border-t border-hairline pt-6">
              <h2 id="sources-heading" class="type-caption-strong text-ink uppercase tracking-wider">
                Standards & Verified Sources
              </h2>
              <ul class="mt-3 space-y-2 type-caption text-ink-muted-80">
                {
                  post.data.sources.map((src) => (
                    <li>
                      <a
                        href={src.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium text-link hover:underline"
                      >
                        {src.label}
                      </a>
                      {src.note && <span> — {src.note}</span>}
                    </li>
                  ))
                }
              </ul>
            </section>
          </div>

          <!-- Sticky Sidebar: TOC & Quick Launch -->
          <aside class="lg:col-span-4 lg:sticky lg:top-28 space-y-5">
            {tocHeadings.length > 0 && (
              <nav aria-label="Table of contents" class="apple-utility-card">
                <p class="type-kicker">On This Page</p>
                <ul class="mt-3 space-y-2 type-caption">
                  {
                    tocHeadings.map((h) => (
                      <li class={h.depth === 3 ? 'pl-3 border-l border-hairline' : ''}>
                        <a
                          href={`#${h.slug}`}
                          class="block text-ink-muted-80 hover:text-link transition-colors leading-snug"
                        >
                          {h.text}
                        </a>
                      </li>
                    ))
                  }
                  {post.data.faqs.length > 0 && (
                    <li>
                      <a href="#article-faqs" class="block text-ink-muted-80 hover:text-link transition-colors">
                        Frequently Asked Questions
                      </a>
                    </li>
                  )}
                </ul>
              </nav>
            )}

            <div class="rounded-[18px] bg-surface-tile-1 p-6 text-on-dark">
              <p class="font-mono text-xs font-semibold text-primary-on-dark">100% Client-Side Tool</p>
              <h2 class="mt-1.5 type-tagline text-on-dark">Measure Actual Size Now</h2>
              <p class="mt-2 type-caption text-body-muted">
                Calibrate once with a standard bank card (85.60 × 53.98 mm) and measure directly in inches, cm, mm, or CSS pixels.
              </p>
              <div class="mt-4 flex flex-col gap-2.5">
                <a href={post.data.recommendedTools[0]?.href ?? '/#ruler-tool'} class="apple-btn-primary text-center">
                  {post.data.recommendedTools[0]?.label ?? 'Open Online Ruler'}
                </a>
                <a
                  href="/#calibration"
                  class="inline-flex min-h-[44px] items-center justify-center rounded-full border border-white/30 px-6 py-2.5 text-[15.5px] font-medium text-white hover:border-white/60 hover:bg-white/10 transition-colors text-center"
                >
                  Calibrate Your Screen
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </article>

    <!-- Related Articles -->
    <section aria-labelledby="related-heading" class="apple-tile-parchment border-t border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="type-kicker">Continue Reading</p>
            <h2 id="related-heading" class="mt-1 type-display-md text-ink">Related Measurement Guides</h2>
          </div>
          <a href={`/blog/${category.slug}`} class="apple-btn-secondary-pill shrink-0">
            More in {category.shortName}
          </a>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
          {
            relatedPosts.map((rel) => {
              const relCat = BLOG_CATEGORY_MAP[rel.data.category];
              const relMins = estimateReadingTimeMinutes(rel.body);
              return (
                <article class="apple-utility-card flex flex-col justify-between hover:border-primary-focus transition-colors">
                  <div>
                    <div class="flex items-center justify-between gap-2">
                      <span class="rounded-full bg-canvas-parchment px-2.5 py-0.5 font-mono text-[11px] font-semibold text-link">
                        {relCat.shortName}
                      </span>
                      <span class="font-mono text-[11px] text-ink-muted-48">{relMins} min read</span>
                    </div>
                    <h3 class="mt-3 type-body-strong text-ink">
                      <a href={`/blog/${rel.id}`} class="hover:text-link transition-colors">
                        {rel.data.title}
                      </a>
                    </h3>
                    <p class="mt-2 type-caption text-ink-muted-80">{rel.data.description}</p>
                  </div>
                  <a href={`/blog/${rel.id}`} class="mt-4 type-caption font-semibold text-link hover:underline">
                    Read guide →
                  </a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
  <HelpModal locale="en" />
  <Footer locale="en" />
  <script src="../../scripts/app.ts"></script>
</BaseLayout>
