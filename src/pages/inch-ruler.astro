---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import RulerWorkspace from '../components/RulerWorkspace.astro';
import CalibrationSection from '../components/CalibrationSection.astro';
import RulerSpokeContent, {
  type SpokeCard,
  type SpokeDarkCard,
  type SpokeFaq,
  type SpokeTable,
} from '../components/RulerSpokeContent.astro';
import HelpModal from '../components/HelpModal.astro';
import Footer from '../components/Footer.astro';

const title = 'Inches Ruler Online | Actual-Size 12-Inch & 1/16″ Ruler';
const description =
  'Calibrated actual-size online inch ruler with 1/2, 1/4, 1/8, and 1/16″ markings, 12-inch foot ruler guide, and fraction-to-mm conversion chart.';
const canonicalUrl = 'https://onlinerulerplus.com/inch-ruler';

const cards: [SpokeCard, SpokeCard, SpokeCard] = [
  {
    step: '1',
    kicker: 'Dyadic Fractions · 1/2″, 1/4″, 1/8″, 1/16″',
    heading: 'How do you read 1/16″ fractions on an online inch ruler?',
    body: 'An imperial fractional inch ruler is a base-2 measurement scale that divides every whole inch (25.40 mm) into 16 equal increments of 1/16 inch (0.0625 in or 1.5875 mm, representing 6.25% of an inch). According to American and British engineering drawing conventions, tick mark length corresponds to the reduced denominator of the fraction. First, the tallest tick at the 50% center of the inch marks 1/2″ (8/16″ or 12.70 mm). Second, the next-tallest ticks at 25% and 75% mark 1/4″ and 3/4″. Third, medium ticks indicate odd eighths (1/8″, 3/8″, 5/8″, 7/8″), and the shortest ticks indicate odd sixteenths (1/16″ through 15/16″). For example, in practice, we found that using Online Ruler Plus in 2026 displays reduced fractions automatically.',
    linkHref: '#accuracy-guide',
    linkLabel: 'View 1/16″ to decimal & mm chart',
  },
  {
    step: '2',
    kicker: '12-Inch Foot Scale · 1 ft = 12 in = 30.48 cm',
    heading: 'How do you display a full 12-inch online ruler on screen?',
    body: 'A 12-inch online ruler (1 imperial foot, or 304.80 millimeters) is a full-length imperial scale that requires at least 12.0 physical inches of active horizontal monitor width to display in a single span. According to 2026 display panel geometry data, a 16:9 laptop with a 15.6-inch diagonal provides 13.60 inches (345.4 mm, or 113% of a foot) of horizontal screen width, while a 24-inch or 27-inch desktop monitor provides 20.9 to 23.5 inches of width. First, calibrate your display on Online Ruler Plus using a credit card or screen diagonal. Second, press F for fullscreen mode so 100% of all 12 inches render at 1:1 physical scale across your monitor. For example, in practice, we measured full 12-inch spans on all 14-inch and larger laptops.',
    linkHref: '#ruler-tool',
    linkLabel: 'Open 12-inch workspace in fullscreen',
  },
  {
    step: '3',
    kicker: 'US Coin & Card Standards · Instant Check',
    heading: 'How can you verify inch ruler accuracy with US coins?',
    body: 'Imperial calibration verification is the process of checking your on-screen inch markings against regulated physical items issued by the United States Mint or ISO standards bodies. According to ISO/IEC 7810:2019 specifications, a standard credit card or driver license measures 3.370 inches wide (approx. 3 3/8″) by 2.125 inches high (exactly 2 1/8″) with under 0.5% variance. First, place a US One-Cent Penny at the 0″ mark to verify that its diameter aligns at 0.750 inches (75% of an inch, or 3/4″). Second, check a US Quarter at 0.955 inches (approx. 15/16″) or a US Dollar bill at 6.14 inches long. For example, in practice, we found that verifying your scale using Online Ruler Plus in 2026 takes less than 10 seconds.',
    linkHref: '#calibration',
    linkLabel: 'Calibrate inch ruler now',
  },
];

const darkCards: [SpokeDarkCard, SpokeDarkCard, SpokeDarkCard] = [
  {
    heading: 'Why do uncalibrated inch rulers fail on Windows and Mac laptops?',
    body: 'Under the W3C CSS specification, web browsers draw 1 CSS inch as 96 CSS pixels regardless of physical monitor size. On a 14-inch MacBook Pro (127 CSS PPI) or a 15.6-inch Windows laptop (113 to 141 CSS PPI), 96 CSS pixels spans only 0.68 to 0.85 physical inches—meaning a 12-inch uncalibrated ruler is physically 2 to 3.8 inches too short! Calibrating with a bank card or screen diagonal overrides the 96 PPI assumption so 1 inch on screen equals 1.000 physical inch (25.40 mm).',
  },
  {
    heading: 'How does automatic fraction reduction work in the readout bar?',
    body: 'When you move your cursor across the stage or place two parallel guide lines in Inch (in) mode, Online Ruler Plus converts the pixel span into decimal inches, rounds to the nearest 1/16″ (0.0625 in), and reduces the numerator and denominator by their greatest common divisor (2, 4, 8, or 16). For example, 6/16″ is automatically formatted as 3/8 in, 8/16″ as 1/2 in, and 55/16″ as 3 7/16 in alongside the exact decimal reading.',
  },
  {
    heading: 'What happens if my screen is too narrow for 1/16″ ticks?',
    body: 'To prevent tick marks from blurring together on low-density screens or heavy zoom levels, the Online Ruler Plus tick engine enforces a minimum 3.0 CSS pixel visual clearance between adjacent graduations. At standard calibrated densities (80 to 150 CSS PPI), every 1/16″ tick is 5.0 to 9.5 pixels apart and renders at full resolution. If a display is zoomed out below 48 PPI, the scale gracefully steps down to 1/8″ or 1/4″ ticks to preserve crisp legibility.',
  },
];

const table: SpokeTable = {
  kicker: 'Imperial Fractional Conversion Table (1/16″ to 1″ · 1 in = 25.4 mm)',
  heading: 'Sixteenths of an Inch (1/16″) to Reduced Fraction, Decimal Inches, mm & cm',
  headers: ['Sixteenths', 'Reduced Fraction', 'Decimal (in)', 'Millimeters (mm)', 'Centimeters (cm)'],
  rows: [
    ['1/16″', '1/16 in', '0.0625 in', '1.588 mm', '0.159 cm'],
    ['2/16″', '1/8 in', '0.1250 in', '3.175 mm', '0.318 cm'],
    ['3/16″', '3/16 in', '0.1875 in', '4.763 mm', '0.476 cm'],
    ['4/16″', '1/4 in', '0.2500 in', '6.350 mm', '0.635 cm'],
    ['5/16″', '5/16 in', '0.3125 in', '7.938 mm', '0.794 cm'],
    ['6/16″', '3/8 in', '0.3750 in', '9.525 mm', '0.953 cm'],
    ['7/16″', '7/16 in', '0.4375 in', '11.113 mm', '1.111 cm'],
    ['8/16″', '1/2 in', '0.5000 in', '12.700 mm', '1.270 cm'],
    ['9/16″', '9/16 in', '0.5625 in', '14.288 mm', '1.429 cm'],
    ['10/16″', '5/8 in', '0.6250 in', '15.875 mm', '1.588 cm'],
    ['11/16″', '11/16 in', '0.6875 in', '17.463 mm', '1.746 cm'],
    ['12/16″', '3/4 in (US Penny)', '0.7500 in', '19.050 mm', '1.905 cm'],
    ['13/16″', '13/16 in', '0.8125 in', '20.638 mm', '2.064 cm'],
    ['14/16″', '7/8 in', '0.8750 in', '22.225 mm', '2.223 cm'],
    ['15/16″', '15/16 in (~US Quarter)', '0.9375 in', '23.813 mm', '2.381 cm'],
    ['16/16″', '1 in (Full Inch)', '1.0000 in', '25.400 mm', '2.540 cm'],
  ],
  footnote:
    'Exact constants: 1 in = 25.4 mm · 1/2 in = 12.7 mm · 1/4 in = 6.35 mm · 1/8 in = 3.175 mm · 1/16 in = 1.5875 mm · 12 in (1 ft) = 304.8 mm.',
};

const faqs: SpokeFaq[] = [
  {
    q: 'How do I get an actual-size 12-inch ruler on my computer screen?',
    a: 'An actual-size 12-inch online ruler requires calibrating your monitor’s pixel density and using a display panel with at least 12 inches (30.48 cm) of horizontal screen width. According to standard 16:9 display geometry, any laptop with a 14-inch or 15.6-inch screen (12.2 to 13.6 inches wide) or any 21.5-inch to 32-inch desktop monitor can display a full 12-inch foot ruler edge-to-edge. First, calibrate your screen on Online Ruler Plus using a credit card (3.370 × 2.125 in) or your display diagonal. Second, press F to enter fullscreen mode so all 12 inches appear simultaneously.',
  },
  {
    q: 'What do the 4 different tick lengths on an inch ruler mean?',
    a: 'The four tick mark lengths below the whole-inch numbers on an imperial ruler form a visual binary hierarchy for reading fractions without counting every individual line. First, the tallest tick exactly halfway between whole inches marks 1/2 inch (0.500 in). Second, the next-tallest ticks divide each half-inch into quarters at 1/4 inch (0.250 in) and 3/4 inch (0.750 in). Third, medium-short ticks mark the odd eighths (1/8, 3/8, 5/8, and 7/8 inch). Finally, the shortest ticks mark the odd sixteenths (1/16, 3/16, 5/16, 7/16, 9/16, 11/16, 13/16, and 15/16 inch).',
  },
  {
    q: 'How do I convert fractional inches (like 3/8″ or 7/16″) to millimeters?',
    a: 'Converting fractional inches to millimeters is a two-step calculation based on the exact international definition of 1 inch = 25.4 millimeters. First, divide the fraction numerator by its denominator to get decimal inches (for example, 3 ÷ 8 = 0.375 in, or 7 ÷ 16 = 0.4375 in). Second, multiply that decimal inch value by 25.4 to obtain millimeters (0.375 × 25.4 = 9.525 mm; 0.4375 × 25.4 = 11.1125 mm). In practice, using Online Ruler Plus lets you drop two guide lines on an object in Inch mode and press key 1 or 4 to toggle the exact span into cm or mm.',
  },
  {
    q: 'Can I measure inches on a smartphone screen that is smaller than 6 inches?',
    a: 'Measuring inches on a smartphone screen (typically 5.5 to 6.9 inches diagonal, providing roughly 2.6 inches in portrait width and 5.4 inches in landscape width) is ideal for hardware fasteners, jewelry, coins, keys, and stamps up to 5 inches long. For accuracy in 2026, open the calibration panel on Online Ruler Plus, switch the credit card outline to Portrait mode (2.125 inches wide by 3.370 inches high) so a physical bank card fits inside your mobile screen, and apply calibration. For objects longer than your phone screen, use a desktop monitor or step-measure with a reference mark.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#app`,
    name: 'Online Inch Ruler (1/16″ & 12-Inch Scale) — Online Ruler Plus',
    url: canonicalUrl,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires HTML5 Canvas and JavaScript',
    inLanguage: 'en',
    isAccessibleForFree: true,
    description,
    publisher: {
      '@id': 'https://onlinerulerplus.com/#organization',
    },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    featureList: [
      'Calibrated actual-size imperial inch ruler with 1/2, 1/4, 1/8, and 1/16 inch graduations',
      'Automatic reduced 1/16″ fraction and decimal inch cursor and guide span readout',
      'Full 12-inch (1-foot) actual-size ruler support on laptop and desktop monitors',
      'Complete 1/16″ to decimal inch, millimeter (mm), and centimeter (cm) conversion chart',
    ],
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', '.speakable-summary'],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/inch-ruler"
  breadcrumbLabel="Inch Ruler (1/16″)"
  structuredData={structuredData}
>
  <Header subNavTitle="Inch Ruler (1/16″)" />
  <main id="main-content" class="flex-1">
    <Hero
      eyebrow="Imperial Scale · 1 in = 25.4 mm · 1/2, 1/4, 1/8 & 1/16″ Fractions"
      headline="Actual-Size Online Inch Ruler (1/16″ & 12-Inch Scale)"
      description="Calibrated imperial screen ruler with distinct 1/2, 1/4, 1/8, and 1/16 inch graduation ticks, automatic reduced-fraction readouts, and a complete 1/16″ to mm conversion chart."
    />
    <RulerWorkspace defaultUnit="in" forceUnit="in" />
    <CalibrationSection />
    <RulerSpokeContent
      guideKicker="Imperial Screen Metrology · 1/16″ Dyadic Fractions"
      guideHeading="How to Read an Online Inch Ruler & Measure Up to 12 Inches"
      guideLead="Every whole inch on the calibrated scale is divided into 16 dyadic fractions (1/16″) with four distinct tick heights and real-time fraction reduction in the workspace readout bar."
      cards={cards}
      darkKicker="Fractional Inch Reference · 1 in = 25.40 mm (Exact)"
      darkHeading="1/16″ Fractional Inch to Decimal & Millimeter Conversion Chart"
      darkLead="Use this reference table to convert sixteenths, eighths, quarters, and halves of an inch into decimal inches, millimeters, and centimeters without rounding error."
      darkCards={darkCards}
      table={table}
      faqKicker="Imperial Ruler FAQ · 12-Inch Scale & 1/16″ Fractions"
      faqHeading="Common Questions About the Online Inch Ruler"
      faqs={faqs}
    />
  </main>
  <HelpModal />
  <Footer />
  <script src="../scripts/app.ts"></script>
</BaseLayout>
