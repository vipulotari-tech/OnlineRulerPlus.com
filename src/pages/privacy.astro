---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HelpModal from '../components/HelpModal.astro';
import Footer from '../components/Footer.astro';

const title = 'Privacy Policy | Online Ruler Plus (100% Client-Side)';
const description =
  'Privacy Policy for OnlineRulerPlus.com. All ruler measurements, guide coordinates, and display calibrations are processed and stored locally in your browser.';
const canonicalUrl = 'https://onlinerulerplus.com/privacy';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  name: 'Privacy Policy — Online Ruler Plus',
  description,
  url: canonicalUrl,
  inLanguage: 'en',
  lastReviewed: '2026-11-14',
  publisher: {
    '@id': 'https://onlinerulerplus.com/#organization',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/privacy"
  breadcrumbLabel="Privacy Policy"
  structuredData={structuredData}
>
  <Header subNavTitle="Privacy Policy" subNavCtaHref="/#ruler-tool" subNavCtaLabel="Open Ruler" />
  <main id="main-content" class="flex-1">
    <section class="apple-page-hero border-b border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <p class="type-kicker">Legal &amp; Data Governance · Zero-Tracking Architecture</p>
        <h1 class="mt-2 type-hero-display text-ink">
          Privacy Policy
        </h1>
        <p class="speakable-summary mt-3 max-w-[62ch] type-lead-airy text-ink-muted-80">
          Online Ruler Plus processes 100% of screen calibrations and object measurements locally in your browser with zero server uploads, zero camera prompts, and zero tracking cookies.
        </p>
        <p class="mt-3 font-mono text-xs text-ink-muted-48">Effective Date: November 14, 2026</p>
      </div>
    </section>

    <section class="apple-tile-parchment">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
          <section class="apple-utility-card">
            <p class="type-kicker">01 · Local Execution</p>
            <h2 class="mt-2 type-tagline text-ink">How are ruler measurements and calibrations processed?</h2>
            <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
              Client-side measurement processing means that every action you take on OnlineRulerPlus.com—including credit card alignment, screen diagonal calculation, device density detection, guide line placement, and protractor angle reading—executes entirely inside your local web browser via static JavaScript and HTML5 Canvas. Unlike cloud-based utilities, none of your physical measurements, display dimensions, or calibration constants are ever transmitted to any remote server or third-party API in 2026.
            </p>
          </section>

          <section class="apple-utility-card">
            <p class="type-kicker">02 · Browser Storage</p>
            <h2 class="mt-2 type-tagline text-ink">What data is stored in browser localStorage?</h2>
            <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
              To restore your calibrated display scale and workspace settings on repeat visits without requiring user accounts or tracking cookies, Online Ruler Plus uses your browser’s native <code class="font-mono text-ink">window.localStorage</code> under four scoped keys: <code class="font-mono text-ink">orp:calibration:v1</code> (per-display <code class="font-mono text-ink">devicePxPerMm</code> profiles), <code class="font-mono text-ink">orp:preferences:v1</code> (active unit, edges, and thickness), <code class="font-mono text-ink">orp:history:v1</code> (up to 15 saved guide spans), and <code class="font-mono text-ink">orp:theme</code> (light or dark appearance). You can erase these keys at any time using the Reset Calibration and Clear History buttons.
            </p>
          </section>

          <section class="apple-utility-card">
            <p class="type-kicker">03 · Zero Permissions</p>
            <h2 class="mt-2 type-tagline text-ink">Does Online Ruler Plus access cameras, sensors, or trackers?</h2>
            <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
              Online Ruler Plus never requests access to your device webcam, microphone, GPS geolocation, clipboard, or contacts, and never embeds third-party advertising networks or behavioral profiling scripts. If you voluntarily contact our team via email at <a href="mailto:support@onlinerulerplus.com" class="text-link underline">support@onlinerulerplus.com</a>, your email address and message content are used solely to reply to your inquiry and are never sold or shared with external parties.
            </p>
          </section>
        </div>
      </div>
    </section>
  </main>
  <HelpModal />
  <Footer />
  <script src="../scripts/app.ts"></script>
</BaseLayout>
