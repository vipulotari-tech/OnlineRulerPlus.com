---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HelpModal from '../components/HelpModal.astro';
import Footer from '../components/Footer.astro';

const title = 'Contact & Display Profile Submissions | Online Ruler Plus';
const description =
  'Contact Online Ruler Plus to submit a display density profile, report a calibration bug, suggest accessibility fixes, or ask metrology questions.';
const canonicalUrl = 'https://onlinerulerplus.com/contact';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${canonicalUrl}#contact`,
  name: 'Contact Online Ruler Plus & Submit Display Profiles',
  description,
  url: canonicalUrl,
  inLanguage: 'en',
  mainEntity: {
    '@id': 'https://onlinerulerplus.com/#organization',
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/contact"
  breadcrumbLabel="Contact"
  structuredData={structuredData}
>
  <Header subNavTitle="Contact" subNavCtaHref="/#ruler-tool" subNavCtaLabel="Open Ruler" />
  <main id="main-content" class="flex-1">
    <section class="apple-page-hero border-b border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <p class="type-kicker">Contact &amp; Hardware Database Contributions</p>
            <h1 class="mt-2 type-hero-display text-ink">
              Contact Online Ruler Plus
            </h1>
            <p class="speakable-summary mt-3 max-w-[62ch] type-lead-airy text-ink-muted-80">
              Reach out to our engineering team to contribute a verified display density profile, report a browser calibration issue, or ask technical screen metrology questions.
            </p>
          </div>
          <div class="shrink-0">
            <a href="/#ruler-tool" class="apple-btn-primary">
              Open Online Ruler
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="apple-tile-parchment">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
          <article class="apple-utility-card flex flex-col justify-between">
            <div>
              <p class="type-kicker">01 · Technical Support</p>
              <h2 class="mt-2 type-tagline text-ink">How do you contact Online Ruler Plus support?</h2>
              <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
                Technical support for Online Ruler Plus handles calibration questions, WCAG 2.2 accessibility feedback, and cross-browser rendering reports across Chrome, Safari, Edge, and Firefox. When reporting a ruler rendering or zoom rescaling issue, please include your operating system version, browser name and zoom percentage, and whether you calibrated via ISO/IEC 7810 ID-1 credit card or visible screen diagonal. Because Online Ruler Plus performs measurement math locally in your browser, we never automatically collect device diagnostics unless you include them in your message.
              </p>
            </div>
            <p class="mt-5 pt-4 border-t border-hairline font-mono text-sm font-semibold text-link">
              <a href="mailto:support@onlinerulerplus.com" class="hover:underline">
                support@onlinerulerplus.com
              </a>
            </p>
          </article>

          <article class="apple-utility-card flex flex-col justify-between">
            <div>
              <p class="type-kicker">02 · Hardware Database</p>
              <h2 class="mt-2 type-tagline text-ink">How do you submit a new device display profile?</h2>
              <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
                Display profile submission is our verification workflow for expanding the Auto-Detect Device reference list in Online Ruler Plus. To submit a laptop, desktop monitor, tablet, or smartphone panel, first calibrate your display using a physical 85.60 × 53.98 mm ISO/IEC 7810 ID-1 bank card at 100% browser zoom. Second, open the 3. Auto-Detect Device tab in the calibration section and copy the four hardware telemetry values reported by your browser: <code class="font-mono text-ink">screen.width × screen.height</code>, <code class="font-mono text-ink">devicePixelRatio</code>, platform family, and your verified CSS PPI / <code class="font-mono text-ink">pxPerMm</code> reading.
              </p>
            </div>
            <p class="mt-5 pt-4 border-t border-hairline type-caption font-semibold text-link">
              <a href="/#calibration" class="hover:underline">
                Inspect your device telemetry in Auto-Detect →
              </a>
            </p>
          </article>

          <article class="apple-utility-card flex flex-col justify-between">
            <div>
              <p class="type-kicker">03 · Self-Service Troubleshooting</p>
              <h2 class="mt-2 type-tagline text-ink">Where can you solve common calibration issues immediately?</h2>
              <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
                Most on-screen measurement discrepancies are caused by non-100% browser zoom during diagonal entry, Windows or macOS HiDPI display scaling overrides, or dragging a browser window from a laptop screen onto an external monitor without switching calibration profiles. Before emailing support, review our <a href="/calibration-guide" class="text-link underline">Screen Calibration &amp; PPI Guide</a>, check the 16-question <a href="/faq" class="text-link underline">Frequently Asked Questions</a> knowledge base, or follow the 3-step <a href="/how-to-use" class="text-link underline">How to Use manual</a> to verify your ruler with a US Quarter (24.26 mm) or 1 Euro coin (23.25 mm).
              </p>
            </div>
            <p class="mt-5 pt-4 border-t border-hairline type-caption font-semibold text-link">
              <a href="/faq" class="hover:underline">
                Browse 16 Calibration &amp; PPI FAQs →
              </a>
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="apple-tile-light border-t border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <article class="apple-utility-card">
            <p class="type-kicker">04 · Bug Report Checklist</p>
            <h2 class="mt-2 type-tagline text-ink">What details help resolve calibration or layout issues fastest?</h2>
            <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
              To help our engineering maintainers reproduce rendering, fractional scaling, or protractor interaction behavior reliably, please include five items in your email to <a href="mailto:support@onlinerulerplus.com" class="text-link underline">support@onlinerulerplus.com</a>: (1) your exact device model and external monitor size if applicable, (2) OS display scaling percentage (such as Windows 125% or macOS Default Retina), (3) browser name and zoom level, (4) the active calibration readout displayed inside the Status Badge, and (5) steps to reproduce the issue on desktop or touch viewports.
            </p>
          </article>

          <article class="apple-utility-card">
            <p class="type-kicker">05 · Policy, Privacy &amp; Accessibility Requests</p>
            <h2 class="mt-2 type-tagline text-ink">How are privacy, legal, and accessibility notices handled?</h2>
            <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
              All inquiries concerning privacy rights, cookie consent controls, intellectual property notices, metrology documentation corrections, and keyboard/screen-reader accessibility are reviewed directly through <a href="mailto:support@onlinerulerplus.com" class="text-link underline">support@onlinerulerplus.com</a>. We review incoming technical and compliance correspondence regularly and only use submitted contact details to respond to your request and maintain accurate documentation across OnlineRulerPlus.com. See our <a href="/privacy" class="text-link underline">Privacy Policy</a> and <a href="/terms" class="text-link underline">Terms of Use</a> for full governance details.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>
  <HelpModal />
  <Footer />
  <script src="../scripts/app.ts"></script>
</BaseLayout>
