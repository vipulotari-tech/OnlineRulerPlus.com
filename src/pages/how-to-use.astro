---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HelpModal from '../components/HelpModal.astro';
import Footer from '../components/Footer.astro';

const title = 'How to Use an Online Ruler | Screen Measurement Manual';
const description =
  'Step-by-step guide for calibrating your screen with a credit card or diagonal, placing guides, reading 1/16″ fractions, and printing rulers at 100%.';
const canonicalUrl = 'https://onlinerulerplus.com/how-to-use';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    '@id': `${canonicalUrl}#article`,
    headline: 'How to Use Online Ruler Plus: Step-by-Step Screen Measurement Manual',
    description,
    url: canonicalUrl,
    datePublished: '2026-11-14',
    dateModified: '2026-11-14',
    inLanguage: 'en',
    author: {
      '@id': 'https://onlinerulerplus.com/#organization',
    },
    publisher: {
      '@id': 'https://onlinerulerplus.com/#organization',
    },
    mainEntityOfPage: canonicalUrl,
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', '.speakable-summary'],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    '@id': `${canonicalUrl}#howto`,
    name: 'How to Measure Physical Objects Using Online Ruler Plus',
    description,
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Calibrate your display density',
        text: 'Hold a standard ISO/IEC 7810 ID-1 bank or ID card (85.60 × 53.98 mm) flat against the calibration box and adjust the slider until the border matches your card, or enter your visible screen diagonal in inches at 100% browser zoom.',
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Select your measurement unit and active ruler edges',
        text: 'Choose Centimeters (cm), Millimeters (mm), Inches (in), or CSS Pixels (px), and toggle Top, Bottom, Left, Right, or Dual cm/in ruler scales.',
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Align at the 0 datum and drop parallel guide lines',
        text: 'Align one edge of your physical object with the 0 datum line (16px inset from the bezel) and click the ruler or gridded stage to place draggable guide lines for automatic ΔX/ΔY span calculation.',
      },
    ],
  },
];

const shortcuts = [
  { key: '1', action: 'Switch to Centimeters (cm)', useCase: 'Everyday lengths with 1 mm minor ticks and 0.5 cm midpoints' },
  { key: '2', action: 'Switch to Fractional Inches (in)', useCase: 'US sizing, woodworking, fabric cuts, and 1/16″ fraction readouts' },
  { key: '3', action: 'Switch to CSS Pixels (px)', useCase: 'UI alignment, responsive breakpoints, and viewport width checks' },
  { key: '4 / M', action: 'Switch to Millimeters (mm)', useCase: 'M2–M10 bolts, jewelry rings, watch lugs, and fine gaps' },
  { key: 'D', action: 'Toggle Dual cm / in Scale', useCase: 'Simultaneous metric and imperial reading without unit switching' },
  { key: 'G', action: 'Add Vertical / Horizontal Guide', useCase: 'Drop draggable boundary lines for ΔX / ΔY subtraction' },
  { key: 'C', action: 'Toggle Crosshair Overlay', useCase: 'Track live cursor X/Y coordinates across the canvas stage' },
  { key: 'P', action: 'Toggle 180° Angle Protractor', useCase: 'Measure corners, chamfers, and slopes to 0.1° resolution' },
  { key: 'F', action: 'Enter / Exit Fullscreen', useCase: 'Maximize measurable physical span across edge-to-edge glass' },
  { key: 'Esc', action: 'Clear Active Guides & Modals', useCase: 'Reset guide pairs rapidly before measuring the next object' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/how-to-use"
  breadcrumbLabel="How to Use"
  ogType="article"
  structuredData={structuredData}
>
  <Header subNavTitle="How to Use" subNavCtaHref="/#ruler-tool" subNavCtaLabel="Open Ruler" />
  <main id="main-content" class="flex-1">
    <!-- Compact Page Hero -->
    <section class="apple-page-hero border-b border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <p class="type-kicker">
              User Manual · Precision Screen Metrology · Updated November 2026
            </p>
            <h1 class="mt-2 type-hero-display text-ink">
              How to Use Online Ruler Plus
            </h1>
            <p class="speakable-summary mt-3 max-w-[62ch] type-lead-airy text-ink-muted-80">
              Online Ruler Plus is a client-side physical measurement workspace that converts your screen into a 1:1 calibrated ruler. Follow these steps to calibrate once and measure in centimeters, millimeters, and 1/16″ inches.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a href="/#ruler-tool" class="apple-btn-primary">Open Online Ruler</a>
            <a href="/#calibration" class="apple-btn-secondary-pill">Go to Calibration</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core 3-Step Workflow -->
    <section class="apple-tile-parchment">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
          <article class="apple-utility-card flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-primary font-mono text-xs font-semibold text-on-primary">1</span>
                <span class="type-kicker">Step 01 · Calibration</span>
              </div>
              <h2 class="mt-4 type-tagline text-ink">How do you calibrate your screen density first?</h2>
              <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
                Screen density calibration is the essential first step that replaces your browser’s 96 CSS PPI default with your display’s true millimeter pixel pitch. Scroll to the Calibrate Your Screen section on any ruler page and choose your preferred reference method: hold a standard ISO/IEC 7810 ID-1 payment or ID card (85.60 × 53.98 mm) flat against the screen and adjust the slider or arrow keys until the box matches your card width; enter your display panel’s visible diagonal in inches (such as 14, 15.6, 24, or 27 inches) at 100% browser zoom; or run Auto-Detect Device. Click Apply Calibration to save the profile locally in your browser.
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-hairline">
              <a href="/#calibration" class="type-caption font-semibold text-link hover:underline">
                Open Credit Card Calibration →
              </a>
            </div>
          </article>

          <article class="apple-utility-card flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-primary font-mono text-xs font-semibold text-on-primary">2</span>
                <span class="type-kicker">Step 02 · Units &amp; Edges</span>
              </div>
              <h2 class="mt-4 type-tagline text-ink">How do you choose measurement units and active edges?</h2>
              <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
                Unit and edge configuration is controlled via the segmented instrument pods at the top of the workspace or via single-key shortcuts. Select your linear unit: press key 1 for Centimeters (cm) with 0.5 cm and 1 mm subdivisions, key 2 for Inches (in) with 1/2, 1/4, 1/8, and 1/16 inch dyadic fractions, key 3 for W3C CSS Pixels (px), or key 4 / M for Millimeters (mm). You can also enable Dual cm/in mode to display metric and imperial graduations side by side. Toggle Top, Bottom, Left, Right, or All Edges depending on where you want to hold your object against the screen.
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-hairline">
              <div class="flex flex-wrap gap-3 type-caption font-semibold text-link">
                <a href="/cm-ruler" class="hover:underline">cm Ruler</a>
                <span>·</span>
                <a href="/inch-ruler" class="hover:underline">Inch Ruler</a>
                <span>·</span>
                <a href="/mm-ruler" class="hover:underline">mm Ruler</a>
              </div>
            </div>
          </article>

          <article class="apple-utility-card flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-primary font-mono text-xs font-semibold text-on-primary">3</span>
                <span class="type-kicker">Step 03 · Alignment &amp; Guides</span>
              </div>
              <h2 class="mt-4 type-tagline text-ink">How do you align at zero and measure spans with guides?</h2>
              <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
                Zero-datum alignment means placing the starting edge of your physical object directly over the 0 graduation line inside the ruler strip (inset 16 CSS pixels from the bezel corner) rather than pressing against a raised plastic monitor bezel. Align the left or top end of your item with the 0 dashed datum hairline, then click any ruler strip or inside the gridded stage to drop a draggable blue guide line at the opposite end of your object. When two parallel guides are placed on screen, Online Ruler Plus computes the exact point-to-point delta span (ΔX or ΔY) and lets you save it to Measurement History.
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-hairline">
              <a href="/calibration-guide" class="type-caption font-semibold text-link hover:underline">
                Read Calibration &amp; PPI Guide →
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Advanced Tools & Printable Scale Verification (Light Tile #ffffff) -->
    <section class="apple-tile-light border-t border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <article class="apple-utility-card">
            <p class="type-kicker">Overlay Instruments · Floating Ruler &amp; Protractor</p>
            <h2 class="mt-2 type-tagline text-ink">
              How do you use the floating ruler and 180° angle protractor?
            </h2>
            <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
              Interactive overlay instruments let you measure diagonal features and angles directly inside the workspace without rotating your laptop or physical item. Click the + Floating Ruler button in the toolbar to spawn a movable, 360-degree rotatable ruler bar that you can drag over any region of the stage and fine-tune by angle handle. Press keyboard shortcut P (or click Protractor) to activate the 180-degree optical angle protractor overlay. Drag the protractor vertex onto the corner of your part and align the adjustable ray arm to inspect bevels or corners from 0° to 180° in 0.1° increments. Press C to toggle the cursor-following crosshair or Esc to clear active guides.
            </p>
          </article>

          <article class="apple-utility-card">
            <p class="type-kicker">Printable Actual-Size Ruler · 100% Scale Check</p>
            <h2 class="mt-2 type-tagline text-ink">
              How do you print an actual-size ruler at 100% scale?
            </h2>
            <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
              Printing an actual-size ruler requires disabling automatic page scaling in your browser print dialog so your printer preserves true physical dimensions. According to ISO 216 (A4: 210 × 297 mm) and ANSI Letter (8.5 × 11.0 in / 215.9 × 279.4 mm) paper geometry, default settings like Fit to Printable Area or Shrink to Fit reduce printed scales by roughly 3% to 8%. When printing Online Ruler Plus (via Ctrl+P on Windows/Linux or Cmd+P on macOS), open More Settings, set Scale to Actual Size or Custom 100%, choose Default or None margins, and verify your printout against an 85.60 mm ISO/IEC 7810 ID-1 bank card before measuring materials.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Practical Real-World Workflows (Parchment Tile #f5f5f7) -->
    <section class="apple-tile-parchment border-t border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="type-kicker">Practical Field Workflows · Hardware, Crafts &amp; Document Layout</p>
          <h2 class="mt-1.5 type-display-lg text-ink">
            Step-by-Step Recipes for Common Measurement Tasks
          </h2>
          <p class="mt-3 max-w-2xl type-body text-ink-muted-80">
            Different physical items create distinct alignment challenges—curved coins roll, short threaded screws sit awkwardly against corners, and long prints exceed narrow viewports. Use these verified workflows to keep readings repeatable and gentle on your display glass.
          </p>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <article class="apple-utility-card">
            <p class="type-kicker">Recipe 01 · Circular Parts, Coins &amp; Jewelry</p>
            <h3 class="mt-2 type-tagline text-ink">Measuring outer diameter with tangent vertical guides</h3>
            <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
              Trying to line a round coin, washer, O-ring, or ring shank up with tick zero often hides the outer curve behind glare. Instead, lay the circular object near the center of the light gridded stage—or over a thin transparent protective sheet if the ring has sharp metal prongs. Click anywhere along the top ruler strip to drop Guide 1 and nudge it until the vertical hairline kisses the left tangent of the circle. Click again to drop Guide 2 on the right tangent. Online Ruler Plus automatically calculates ΔX (Right minus Left) in millimeters, centimeters, or decimal/fractional inches without requiring zero alignment.
            </p>
          </article>

          <article class="apple-utility-card">
            <p class="type-kicker">Recipe 02 · Screws, Bolts &amp; Watch Lugs</p>
            <h3 class="mt-2 type-tagline text-ink">Measuring metric thread length and watch strap width</h3>
            <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
              For small hardware fasteners (M2 through M10 machine screws, PCB standoffs, or watch spring-bar lugs between 18 mm and 24 mm), switch to the <a href="/mm-ruler" class="text-link underline">Millimeter Ruler (mm)</a> where every 1 mm division is marked clearly. Rest a piece of sticky note or clear acetate film over the glass so sharp threads never scratch anti-reflective coatings. Align the underside of a flat-head fastener (or overall head-to-tip height for countersunk screws) against Guide 1, then drag Guide 2 to the thread tip. Cross-check pitch count across 10 mm to avoid mistaking an M3-0.5 bolt for a #4-40 imperial fastener.
            </p>
          </article>

          <article class="apple-utility-card">
            <p class="type-kicker">Recipe 03 · Woodworking, Crafts &amp; 1/16″ Fractions</p>
            <h3 class="mt-2 type-tagline text-ink">Reading reduced 1/16″ imperial fractions reliably</h3>
            <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
              When working with U.S. quilting templates, brass fittings, paper stock, or carpentry sketches, switch to the <a href="/inch-ruler" class="text-link underline">Inch Ruler (1/16″)</a>. Each 25.4 mm inch block is divided into four visual tick tiers: half-inch (1/2″), quarter-inch (1/4″ and 3/4″), odd eighths (1/8″, 3/8″, 5/8″, 7/8″), and shortest sixteenth marks. Moving your cursor or dragging a guide line displays the nearest reduced fraction automatically alongside decimal inches, eliminating mental counting errors such as reading 5/8″ as 10/16″ or confusing 9/16″ with 1/2″.
            </p>
          </article>

          <article class="apple-utility-card">
            <p class="type-kicker">Recipe 04 · Upright Objects &amp; Tall Smartphones</p>
            <h3 class="mt-2 type-tagline text-ink">Using vertical edges and stepping spans longer than your screen</h3>
            <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
              When checking the standing height of bottles, keycaps, display stand risers, or vertical card proportions, open the <a href="/vertical-ruler" class="text-link underline">Vertical Ruler</a> with Left and Right edge strips active. Press F to enter Fullscreen mode so browser tabs and bookmarks no longer shorten your usable vertical axis. If an object—such as a 35 cm binder or poster margin—is slightly wider than your display, align the start with zero, apply a small piece of low-tack painter’s tape on the object precisely opposite a whole graduation like 25.0 cm, reposition that tape mark back onto 0, and add the second partial span.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Keyboard Shortcuts & Error Prevention Checklist (Light Tile #ffffff) -->
    <section class="apple-tile-light border-t border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="type-kicker">Workspace Controls · Keyboard Reference</p>
            <h2 class="mt-1.5 type-display-lg text-ink">
              Complete Keyboard Shortcut Table
            </h2>
            <p class="mt-2.5 max-w-2xl type-body text-ink-muted-80">
              Keeping one hand on the physical object you are holding near the screen while switching units or spawning guides with single keystrokes avoids nudging your measurement out of alignment.
            </p>

            <div class="mt-6 overflow-x-auto rounded-[18px] border border-hairline bg-surface-primary p-4 sm:p-6">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-hairline font-mono text-xs text-ink-muted-48">
                    <th class="py-2.5 pr-4 font-semibold">Shortcut Key</th>
                    <th class="py-2.5 px-4 font-semibold">Workspace Action</th>
                    <th class="py-2.5 pl-4 font-semibold">When to Use</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-hairline type-caption text-ink-muted-80">
                  {
                    shortcuts.map((row) => (
                      <tr>
                        <td class="py-3 pr-4 font-mono font-semibold text-ink">{row.key}</td>
                        <td class="py-3 px-4 font-medium text-ink">{row.action}</td>
                        <td class="py-3 pl-4">{row.useCase}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="apple-utility-card h-full">
              <p class="type-kicker">Pre-Measurement Verification · 6-Point Checklist</p>
              <h2 class="mt-2 type-tagline text-ink">
                Six Checks Before Trusting a Critical Reading
              </h2>
              <p class="mt-2.5 type-body text-ink-muted-80">
                Before recording measurements for custom foam inserts, 3D-printed brackets, framing mats, or replacement fasteners, run through this quick six-point verification routine to rule out common visual and OS traps:
              </p>
              <ul class="mt-4 space-y-3 type-caption text-ink-muted-80">
                <li>
                  <strong class="text-ink">1. Check the Active Scale badge:</strong> Confirm it displays <code class="font-mono text-ink">Calibrated (card)</code> or <code class="font-mono text-ink">Calibrated (diagonal)</code> rather than uncalibrated <code class="font-mono text-ink">96 PPI Estimate</code>.
                </li>
                <li>
                  <strong class="text-ink">2. Verify 100% browser zoom during diagonal setup:</strong> Press <code class="font-mono text-ink">Ctrl+0</code> or <code class="font-mono text-ink">Cmd+0</code> before typing monitor inches; zoom freely afterward—calibrated <code class="font-mono text-ink">devicePxPerMm</code> compensates automatically.
                </li>
                <li>
                  <strong class="text-ink">3. Confirm secondary monitor profile:</strong> Moving a browser window from a laptop screen to an external desktop monitor changes physical PPI; re-verify against an ID-1 bank card (85.60 mm) or coin if switched displays.
                </li>
                <li>
                  <strong class="text-ink">4. Look squarely perpendicular to each tick:</strong> Cover glass on laptops, tablets, and phones creates a 0.3–1.0 mm visual offset if read sideways. Line your eye directly over each guide line.
                </li>
                <li>
                  <strong class="text-ink">5. Respect bezel thickness at zero:</strong> Never jam hard parts into raised plastic edges; use either the inset 0 datum dashed hairline or two interior guide lines (ΔX / ΔY).
                </li>
                <li>
                  <strong class="text-ink">6. Guard panel glass against scratches:</strong> Place thin film, paper, or clear tape under sharp steel calipers, threaded tips, or rough ceramics. Use certified vernier calipers for sub-0.2 mm tolerances.
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <HelpModal />
  <Footer />
  <script src="../scripts/app.ts"></script>
</BaseLayout>
