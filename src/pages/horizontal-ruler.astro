---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import RulerWorkspace from '../components/RulerWorkspace.astro';
import CalibrationSection from '../components/CalibrationSection.astro';
import RulerSpokeContent, {
  type SpokeCard,
  type SpokeDarkCard,
  type SpokeFaq,
  type SpokeTable,
} from '../components/RulerSpokeContent.astro';
import HelpModal from '../components/HelpModal.astro';
import Footer from '../components/Footer.astro';

const title = 'Horizontal Online Ruler | Top & Bottom Screen & Pixel Ruler';
const description =
  'Full-width horizontal online screen ruler with simultaneous Top and Bottom edges in cm, mm, inches, and CSS pixels (px) for wide objects and UI spans.';
const canonicalUrl = 'https://onlinerulerplus.com/horizontal-ruler';

const cards: [SpokeCard, SpokeCard, SpokeCard] = [
  {
    step: '1',
    kicker: 'Dual Horizontal Axis · Top & Bottom Strips',
    heading: 'Why use simultaneous top and bottom horizontal rulers?',
    body: 'A dual-edge horizontal online ruler is a widescreen measurement workspace that renders calibrated graduation strips along both the top and bottom borders of the stage simultaneously. According to geometric alignment principles, when measuring wide rectangular items—such as envelopes, book spines, mechanical keyboards, PCBs, or packaging boxes—single-edge rulers allow a 3° to 5° angular tilt, introducing 1% to 2% cosine alignment error across long spans. First, enable both Top and Bottom edges on Online Ruler Plus. Second, drop a vertical guide line across the stage. For example, in practice, we found that verifying both top and bottom edges at the same X coordinate in 2026 eliminates skew completely.',
    linkHref: '#ruler-tool',
    linkLabel: 'Measure with Top & Bottom edges',
  },
  {
    step: '2',
    kicker: 'CSS Pixel Ruler · W3C Viewport Inspection',
    heading: 'How does the CSS Pixel (px) ruler mode work for designers?',
    body: 'A CSS pixel ruler is a digital layout inspection scale that measures horizontal and vertical distances in W3C logical CSS pixels (10 px minor ticks, 50 px medium ticks, and 100 px numbered major ticks) rather than physical millimeters. According to W3C CSS Values and Units specifications, CSS pixels govern 100% of responsive media queries and grid layouts. First, switch the horizontal ruler to px mode (Shortcut: 3) on Online Ruler Plus. Second, drop vertical guide lines across the stage. For example, in practice, frontend developers and QA engineers in 2026 use px mode to audit container widths, responsive breakpoint boundaries (375 px, 768 px, 1024 px, 1440 px), and 24 px grid gutters directly inside the browser.',
    linkHref: '#accuracy-guide',
    linkLabel: 'View monitor horizontal span table',
  },
  {
    step: '3',
    kicker: 'Fullscreen Span · Maximum Width',
    heading: 'How do you maximize horizontal measurement length on screen?',
    body: 'Horizontal ruler capacity is defined by the physical active width of your display panel in landscape orientation, which equals 87.2% of the diagonal on a 16:9 monitor. According to 2026 hardware dimensions, a 15.6-inch laptop provides 34.5 cm (13.6 inches) of width and a 27-inch monitor provides 59.8 cm (23.5 inches). First, calibrate your screen density on Online Ruler Plus using an 85.60 mm ISO/IEC 7810 ID-1 card or your visible monitor diagonal at 100% zoom. Second, press F (or click Fullscreen in the toolbar) to expand the ruler across 100% of your screen width. For example, in practice, we measured continuous 30 cm and 50 cm horizontal spans without browser border clipping.',
    linkHref: '#calibration',
    linkLabel: 'Calibrate horizontal width',
  },
];

const darkCards: [SpokeDarkCard, SpokeDarkCard, SpokeDarkCard] = [
  {
    heading: 'How wide is a 16:9 or 16:10 monitor in centimeters and inches?',
    body: 'By the Pythagorean theorem, the active horizontal width of a 16:9 widescreen display equals 87.16% of its diagonal measurement (Width = Diagonal × 16 / √(16² + 9²)), while a 16:10 laptop display equals 84.80% of its diagonal. For example, a 15.6-inch 16:9 laptop panel is 13.60 inches (34.54 cm) wide, and a 27-inch 16:9 desktop monitor is 23.53 inches (59.77 cm) wide.',
  },
  {
    heading: 'How do vertical guide lines work with the horizontal ruler?',
    body: 'Clicking anywhere along the Top or Bottom horizontal ruler canvas drops a full-height vertical guide line across the stage. When you place two vertical guide lines—one at the left edge of your physical object and one at the right edge—both the top and bottom horizontal rulers intersect the guides, and the bottom readout bar computes the exact horizontal delta span (ΔX) in cm, mm, inches, or CSS pixels.',
  },
  {
    heading: 'Can I rotate my phone to landscape for a wider horizontal ruler?',
    body: 'Yes. On smartphones, rotating the device 90 degrees into landscape orientation roughly doubles your available horizontal ruler length from ~6.5 cm (2.6 inches) in portrait to ~13.5–15.0 cm (5.3–5.9 inches) in landscape. Online Ruler Plus preserves your saved display calibration across 90-degree orientation changes automatically.',
  },
];

const table: SpokeTable = {
  kicker: 'Display Panel Geometry Reference (16:9, 16:10 & 21:9 Monitors)',
  heading: 'Maximum Horizontal Screen Width by Display Diagonal in Inches, cm, mm & CSS Pixels',
  headers: ['Display Panel & Aspect Ratio', 'Active Width (in)', 'Active Width (cm / mm)', 'Typical CSS Viewport Width', 'Max Standard Ruler Fit'],
  rows: [
    ['6.1" Smartphone (19.5:9 Landscape)', '5.55 in', '14.1 cm (141 mm)', '844 – 852 CSS px', 'Up to 13 cm / 5 in'],
    ['11.0" Tablet (iPad / Android, 4:3)', '8.80 in', '22.4 cm (224 mm)', '1024 – 1194 CSS px', '15 cm / 6 in pocket ruler'],
    ['13.3" Laptop (16:10 Retina)', '11.28 in', '28.6 cm (286 mm)', '1440 CSS px', 'Up to 27 cm / 10.5 in'],
    ['14.2" MacBook Pro (16:10 Liquid Retina)', '11.97 in', '30.4 cm (304 mm)', '1512 CSS px', 'Full 30 cm / 11.5 in'],
    ['15.6" Full HD Laptop (16:9)', '13.60 in', '34.5 cm (345 mm)', '1536 – 1920 CSS px', 'Full 30 cm & 12-inch foot ruler'],
    ['24.0" Desktop Monitor (16:9 1080p)', '20.92 in', '53.1 cm (531 mm)', '1920 CSS px', '50 cm / 18-inch ruler'],
    ['27.0" Desktop Monitor (16:9 QHD / 4K)', '23.53 in', '59.8 cm (598 mm)', '1920 – 2560 CSS px', '58 cm / 22-inch ruler'],
    ['34.0" Ultrawide Monitor (21:9)', '31.36 in', '79.7 cm (797 mm)', '3440 CSS px', '75 cm / 30-inch ruler'],
  ],
  footnote:
    'Horizontal width formulas: 16:9 Width = Diagonal × 0.87158 · 16:10 Width = Diagonal × 0.84800 · 21:9 Width = Diagonal × 0.92246.',
};

const faqs: SpokeFaq[] = [
  {
    q: 'What is the advantage of a horizontal ruler with both top and bottom edges?',
    a: 'A horizontal online ruler with simultaneous top and bottom edges eliminates angular skew when measuring wide objects on your screen. Additionally, hardware design varies across devices: laptops have a bottom keyboard bezel that can block thick objects from sitting flush against the bottom of the screen, whereas holding an object along the top ruler strip—or spanning between two vertical guide lines connecting top and bottom scales—lets you read horizontal dimensions comfortably without fighting the laptop hinge.',
  },
  {
    q: 'How do I use the horizontal ruler as a CSS pixel (px) screen ruler?',
    a: 'Using the horizontal ruler as a CSS pixel screen ruler requires clicking the px unit chip in the workspace toolbar or pressing keyboard shortcut 3. In CSS pixel mode, the top and bottom rulers display exact W3C logical pixel coordinates from 0 px up to your full viewport width (such as 1280 px, 1440 px, or 1920 px), independent of physical millimeter calibration. You can drop vertical guide lines to measure the exact pixel width of UI cards, buttons, typography columns, or images.',
  },
  {
    q: 'Why does the horizontal ruler start 16 pixels inside the left workspace border?',
    a: 'The 0 datum tick mark on Online Ruler Plus is intentionally inset 16 CSS pixels from the left and top edges of the ruler canvas so the "0" numeral and alignment hairline are 100% visible inside the flat glass area of your display. Physical monitor bezels have a raised plastic or aluminum lip that shadows the outermost pixels and prevents rigid objects from sitting flush at pixel zero. Aligning your object with the visible 0 dashed line avoids bezel parallax and edge clipping.',
  },
  {
    q: 'Can I switch the horizontal ruler between centimeters, millimeters, and inches?',
    a: 'Yes. While the Horizontal Ruler page pre-selects the Top and Bottom horizontal edges for wide-span measurement, all four measurement unit scales remain active in the toolbar. Press 1 for Centimeters (cm), 2 for Inches (1/16″ fractions), 3 for CSS Pixels (px), 4 or M for Millimeters (mm), or click Dual cm/in to render metric centimeters and imperial inches along both horizontal strips at the same time.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#app`,
    name: 'Horizontal Online Screen & Pixel Ruler — Online Ruler Plus',
    url: canonicalUrl,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires HTML5 Canvas and JavaScript',
    inLanguage: 'en',
    isAccessibleForFree: true,
    description,
    publisher: {
      '@id': 'https://onlinerulerplus.com/#organization',
    },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    featureList: [
      'Simultaneous full-width Top and Bottom horizontal ruler edges',
      'Centimeter (cm), millimeter (mm), 1/16″ fractional inch, and CSS pixel (px) scales',
      'Full-height vertical guide lines with automatic ΔX horizontal span calculation',
      'Fullscreen widescreen mode for measuring 30 cm / 12-inch and wider objects',
    ],
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', '.speakable-summary'],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/horizontal-ruler"
  breadcrumbLabel="Horizontal Ruler"
  structuredData={structuredData}
>
  <Header subNavTitle="Horizontal Ruler" />
  <main id="main-content" class="flex-1">
    <Hero
      eyebrow="Horizontal Axis · Simultaneous Top & Bottom Edges · cm, mm, in & px"
      headline="Full-Width Horizontal Online Screen & Pixel Ruler"
      description="Simultaneous top and bottom horizontal ruler strips for measuring wide physical objects, 30 cm / 12-inch spans, and CSS pixel (px) viewport widths across your display."
    />
    <RulerWorkspace defaultUnit="cm" forceEdges="horizontal" />
    <CalibrationSection />
    <RulerSpokeContent
      guideKicker="Horizontal Axis Metrology · Top & Bottom Parallel Scales"
      guideHeading="How to Measure Wide Objects & CSS Pixel Spans Horizontally"
      guideLead="Pre-configured with both Top and Bottom horizontal ruler strips active so you can align wide physical objects, check parallelism, and inspect CSS pixel widths."
      cards={cards}
      darkKicker="Widescreen Display Geometry · 16:9, 16:10 & Ultrawide Panels"
      darkHeading="Maximum Horizontal Measurement Span by Screen Diagonal"
      darkLead="See how many centimeters, millimeters, and inches fit horizontally across common smartphone, tablet, laptop, and desktop displays."
      darkCards={darkCards}
      table={table}
      faqKicker="Horizontal & Pixel Ruler FAQ"
      faqHeading="Common Questions About the Horizontal Screen Ruler"
      faqs={faqs}
    />
  </main>
  <HelpModal />
  <Footer />
  <script src="../scripts/app.ts"></script>
</BaseLayout>
