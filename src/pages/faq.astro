---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { faqItems } from '../components/ContentSections.astro';
import HelpModal from '../components/HelpModal.astro';
import Footer from '../components/Footer.astro';

const title = 'Online Ruler FAQ | Calibration, PPI & 1/16″ Guide';
const description =
  'Answers to 16 common questions about online screen ruler calibration, CSS pixels vs physical PPI, 1/16″ inch fractions, multi-monitor setups, and mobile use.';
const canonicalUrl = 'https://onlinerulerplus.com/faq';

const extendedFaqs = [
  {
    q: 'How many centimeters are in 1 inch and in a 12-inch ruler?',
    a: 'Under the 1959 international yard and pound agreement (NIST and BIPM), 1 imperial inch is defined as exactly 2.54 centimeters (25.4 millimeters), and 1 centimeter equals 0.3937008 inches. Multiplying 12 inches by 2.54 cm/in shows that a standard 12-inch (1-foot) ruler equals exactly 30.48 centimeters (304.8 millimeters). Conversely, a standard 30 cm metric ruler equals 11.8110 inches (approximately 11 13/16 inches), which is 4.8 mm shorter than 1 foot. Using Online Ruler Plus, click the Dual cm/in chip in the toolbar to compare both scales simultaneously.',
  },
  {
    q: 'Why is the 0 mark inset 16 pixels from the edge of the ruler workspace?',
    a: 'The 0 datum line on Online Ruler Plus is intentionally inset 16 CSS pixels from the top and left borders of the canvas so the zero graduation tick and dashed alignment hairline sit entirely on flat, unobstructed glass. Physical laptop and desktop monitors have a raised plastic or aluminum bezel that shadows the outermost pixel column and prevents rigid objects from lying flat at pixel zero. Aligning your object with the visible 0 datum line inside the workspace eliminates bezel lip interference and corner parallax error.',
  },
  {
    q: 'How do I measure the diameter of a coin, ring, or circular object on screen?',
    a: 'Measuring the outer or inner diameter of a circular object such as a coin, ring, washer, or O-ring is most accurate when using two parallel guide lines on Online Ruler Plus. First, place the circular object flat on the gridded measurement stage inside the workspace. Second, click the top horizontal ruler to drop a vertical guide line tangent to the left edge of the circle, then click again to drop a second vertical guide line tangent to the right edge. The bottom readout bar subtracts the two X coordinates (ΔX) and displays the exact diameter in mm, cm, or 1/16″ inches.',
  },
  {
    q: 'Can I measure objects longer than my laptop or phone screen?',
    a: 'Maximum single-pass measurement length is bounded by your display panel’s physical width or height—for example, 14.1 cm on a 6.1-inch smartphone, 34.5 cm (13.6 in) on a 15.6-inch laptop, or 59.8 cm (23.5 in) on a 27-inch desktop monitor. First, press F to enter fullscreen mode so the ruler uses 100% of your screen width. Second, if an object exceeds your monitor width, place a small piece of painter’s tape or a pencil mark on the object at a whole graduation (such as 25.0 cm or 10.0 in), shift the mark back to the 0 line, and add the remaining length.',
  },
  {
    q: 'How do I use the 180-degree protractor and floating ruler overlays?',
    a: 'Online Ruler Plus includes two interactive stage overlays for non-axial geometry: a draggable Floating Ruler and a 180-degree Angle Protractor. Clicking + Floating Ruler in the workspace toolbar spawns an independent, calibrated ruler bar inside the stage that can be dragged by its body and rotated 360 degrees by its end handle to measure diagonal features. Pressing keyboard shortcut P (or clicking Protractor) opens a semicircular 0° to 180° protractor overlay with a draggable origin vertex and angle ray that reads angles to 0.1° resolution.',
  },
  {
    q: 'How do I print an actual-size ruler at 100% scale without shrinkage?',
    a: 'When printing a ruler from your browser (Ctrl+P on Windows/Linux or Cmd+P on macOS) or printing a PDF ruler template, printers default to Fit to Printable Area or Shrink to Fit, which reduces physical scale by 3% to 8%. To guarantee a 1:1 actual-size print in 2026, open More Settings in your print dialog, change Scale from Fit to Page to Actual Size or Custom 100%, and before measuring any part, hold a standard 85.60 mm (3.370 in) ISO/IEC 7810 ID-1 credit card against the printed ruler to confirm that 8.56 cm matches the card width.',
  },
  {
    q: 'What is Optical Parallax Error and how do I avoid it when measuring?',
    a: 'Optical parallax error is the apparent displacement of a physical object’s edge relative to the underlying LCD or OLED pixel grid when viewed from an oblique angle through the display’s protective cover glass. Because monitor and smartphone glass typically has a thickness of 0.5 mm to 1.5 mm between the surface and the light-emitting subpixels, viewing from a 30-degree side angle can shift your reading by 0.5 mm to 1.0 mm. Always position your eye directly perpendicular (90 degrees) above the graduation tick mark being read.',
  },
  {
    q: 'How do I use the CSS Pixel (px) ruler mode for web design and QA?',
    a: 'Pressing keyboard shortcut 3 (or clicking the px option chip in the unit selector pod) switches Online Ruler Plus into W3C CSS Pixel inspection mode. Unlike physical millimeter, centimeter, and inch modes—which scale according to your display’s calibrated pxPerMm density—CSS Pixel mode measures exact 1:1 logical viewport pixels with minor ticks every 10 px, medium ticks every 50 px, and numbered major ticks every 100 px. Designers and developers use px mode alongside vertical and horizontal guide lines to audit responsive breakpoints and component widths.',
  },
  {
    q: 'How do I reset my saved screen calibration or clear measurement history?',
    a: 'All calibration profiles, unit preferences, and saved span records live locally in your browser’s localStorage under the keys orp:calibration:v1, orp:preferences:v1, and orp:history:v1. To reset your active display’s calibration back to the automatic hardware estimate, scroll to the Calibrate Your Screen section and click the Reset Calibration button inside the Active Scale status card. To erase saved span entries, click the Clear button in the Measurement History card on the right side of the calibration section.',
  },
];

const allFaqItems = [...faqItems, ...extendedFaqs];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: allFaqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/faq"
  breadcrumbLabel="FAQ"
  structuredData={structuredData}
>
  <Header subNavTitle="FAQ" subNavCtaHref="/#ruler-tool" subNavCtaLabel="Open Ruler" />
  <main id="main-content" class="flex-1">
    <section class="apple-page-hero border-b border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <p class="type-kicker">
              Support &amp; Metrology Knowledge Base · 16 Verified Q&amp;As
            </p>
            <h1 class="mt-2 type-hero-display text-ink">
              Frequently Asked Questions
            </h1>
            <p class="speakable-summary mt-3 max-w-[62ch] type-lead-airy text-ink-muted-80">
              Complete technical answers covering display PPI calibration, ISO/IEC 7810 credit card alignment, metric and 1/16″ fractional inch scales, multi-monitor persistence, and mobile use.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a href="/#ruler-tool" class="apple-btn-primary">Open Online Ruler</a>
            <a href="/calibration-guide" class="apple-btn-secondary-pill">Calibration Guide</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Part 1: Core Calibration & Display Density Questions -->
    <section class="apple-tile-parchment">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="mb-6">
          <p class="type-kicker">Category 01 · Calibration, PPI &amp; Privacy</p>
          <h2 class="mt-1 type-display-md text-ink">
            Display Calibration, Zoom &amp; Device Compatibility
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
          {
            faqItems.map((item) => (
              <details open class="group apple-utility-card">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-ink">
                  <h3 class="type-body-strong text-ink">{item.q}</h3>
                  <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-canvas-parchment font-mono text-base text-link group-open:rotate-45 transition-transform">+</span>
                </summary>
                <p class="mt-3 max-w-[65ch] type-body text-ink-muted-80 border-t border-hairline pt-3">
                  {item.a}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Part 2: Measurement Techniques, Conversions & Overlay Tools -->
    <section class="apple-tile-light border-t border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="mb-6">
          <p class="type-kicker">Category 02 · Measurement Techniques &amp; Conversions</p>
          <h2 class="mt-1 type-display-md text-ink">
            Unit Conversions, Guide Lines, Overlays &amp; Printing
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
          {
            extendedFaqs.map((item) => (
              <details open class="group apple-utility-card">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-ink">
                  <h3 class="type-body-strong text-ink">{item.q}</h3>
                  <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-canvas-parchment font-mono text-base text-link group-open:rotate-45 transition-transform">+</span>
                </summary>
                <p class="mt-3 max-w-[65ch] type-body text-ink-muted-80 border-t border-hairline pt-3">
                  {item.a}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <HelpModal />
  <Footer />
  <script src="../scripts/app.ts"></script>
</BaseLayout>
