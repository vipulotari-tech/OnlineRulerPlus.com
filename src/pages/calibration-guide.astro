---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HelpModal from '../components/HelpModal.astro';
import Footer from '../components/Footer.astro';

const title = 'Screen Calibration & PPI Guide | Online Ruler Plus';
const description =
  'Technical guide to screen pixel density (PPI), W3C CSS pixels, ISO/IEC 7810 credit card calibration, worked PPI math, OS scaling, and parallax limits.';
const canonicalUrl = 'https://onlinerulerplus.com/calibration-guide';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${canonicalUrl}#article`,
  headline: 'Complete Screen Calibration & PPI Measurement Guide',
  description,
  url: canonicalUrl,
  datePublished: '2026-11-14',
  dateModified: '2026-11-14',
  inLanguage: 'en',
  author: {
    '@id': 'https://onlinerulerplus.com/#organization',
  },
  publisher: {
    '@id': 'https://onlinerulerplus.com/#organization',
  },
  mainEntityOfPage: canonicalUrl,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.speakable-summary'],
  },
};

const workedExamples = [
  {
    panel: '14.2" Laptop (Mac Retina / 2× DPR)',
    cssRes: '1512 × 982 CSS px (DPR 2.0)',
    diagCss: '1802.9 CSS px',
    cssPpi: '127.0 CSS PPI',
    pxPerMm: '5.000 CSS px/mm',
    devicePxPerMm: '10.000 device px/mm',
  },
  {
    panel: '15.6" Windows Laptop (125% OS Scale)',
    cssRes: '1536 × 864 CSS px (DPR 1.25)',
    diagCss: '1762.3 CSS px',
    cssPpi: '113.0 CSS PPI',
    pxPerMm: '4.448 CSS px/mm',
    devicePxPerMm: '5.560 device px/mm',
  },
  {
    panel: '24" 1080p Desktop Monitor (100%)',
    cssRes: '1920 × 1080 CSS px (DPR 1.0)',
    diagCss: '2202.9 CSS px',
    cssPpi: '91.8 CSS PPI',
    pxPerMm: '3.614 CSS px/mm',
    devicePxPerMm: '3.614 device px/mm',
  },
  {
    panel: '27" 4K UHD Monitor (150% OS Scale)',
    cssRes: '2560 × 1440 CSS px (DPR 1.5)',
    diagCss: '2937.2 CSS px',
    cssPpi: '108.8 CSS PPI',
    pxPerMm: '4.283 CSS px/mm',
    devicePxPerMm: '6.425 device px/mm',
  },
  {
    panel: '6.1" OLED Smartphone (3× DPR)',
    cssRes: '390 × 844 CSS px (DPR 3.0)',
    diagCss: '929.7 CSS px',
    cssPpi: '152.4 CSS PPI',
    pxPerMm: '6.000 CSS px/mm',
    devicePxPerMm: '18.000 device px/mm',
  },
];

const referenceItems = [
  { item: 'ISO/IEC 7810 ID-1 Bank / Credit Card (Width)', mm: '85.60 mm', inches: '3.370 in', standard: 'ISO/IEC 7810:2019 ID-1' },
  { item: 'ISO/IEC 7810 ID-1 Card (Height)', mm: '53.98 mm', inches: '2.125 in', standard: 'ISO/IEC 7810:2019 ID-1' },
  { item: 'US One-Cent Penny (Diameter)', mm: '19.05 mm', inches: '0.750 in (3/4″)', standard: 'United States Mint Spec' },
  { item: 'US Five-Cent Nickel (Diameter)', mm: '21.21 mm', inches: '0.835 in', standard: 'United States Mint Spec' },
  { item: '1 Euro Coin (Diameter)', mm: '23.25 mm', inches: '0.915 in', standard: 'European Central Bank' },
  { item: 'US Quarter Dollar Coin (Diameter)', mm: '24.26 mm', inches: '0.955 in', standard: 'United States Mint Spec' },
  { item: '2 Euro Coin (Diameter)', mm: '25.75 mm', inches: '1.014 in', standard: 'European Central Bank' },
  { item: 'Standard AA Battery (Length)', mm: '50.50 mm', inches: '1.988 in', standard: 'IEC R6 / ANSI 15' },
  { item: 'US Federal Reserve Note (Width)', mm: '155.96 mm', inches: '6.140 in', standard: 'Bureau of Engraving & Printing' },
  { item: 'ISO 216 A4 Paper (Short Edge)', mm: '210.00 mm', inches: '8.268 in', standard: 'ISO 216 Paper Series' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/calibration-guide"
  breadcrumbLabel="Calibration Guide"
  ogType="article"
  structuredData={structuredData}
>
  <Header subNavTitle="Calibration Guide" subNavCtaHref="/#calibration" subNavCtaLabel="Calibrate Now" />
  <main id="main-content" class="flex-1">
    <section class="apple-page-hero border-b border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <p class="type-kicker">Technical Reference · Display Optics &amp; W3C CSS Units · Updated November 2026</p>
            <h1 class="mt-2 type-hero-display text-ink">
              Complete Screen Calibration &amp; PPI Measurement Guide
            </h1>
            <p class="speakable-summary mt-3 max-w-[62ch] type-lead-airy text-ink-muted-80">
              Display calibration bridges the gap between abstract W3C 96-PPI CSS reference pixels and the physical millimeter pixel pitch of your hardware panel.
            </p>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a href="/#calibration" class="apple-btn-primary">Calibrate Your Screen</a>
            <a href="/#ruler-tool" class="apple-btn-secondary-pill">Open Online Ruler</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Foundations (3 cards) -->
    <section class="apple-tile-parchment">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
          <article class="apple-utility-card flex flex-col justify-between">
            <div>
              <p class="type-kicker">Section 01 · Pixel Pitch Math</p>
              <h2 class="mt-2 type-tagline text-ink">What is the difference between physical PPI and CSS pixels?</h2>
              <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
                Physical Pixels Per Inch (PPI) is a fixed hardware property determined by a display panel’s native pixel resolution and diagonal size in inches, calculated as <code class="font-mono text-ink">Physical PPI = √(W² + H²) / diagonalInches</code>. By contrast, a CSS pixel is an abstract angular unit defined by the W3C CSS Values and Units Module Level 4 specification at exactly 1/96 of a CSS inch (3.7795 CSS pixels per millimeter). When an operating system applies HiDPI scaling—such as <code class="font-mono text-ink">devicePixelRatio = 2</code> on Retina Macs or <code class="font-mono text-ink">1.25</code> to <code class="font-mono text-ink">1.5</code> on Windows laptops—each CSS pixel spans multiple physical subpixels. Online Ruler Plus calibrates in CSS pixels per millimeter (<code class="font-mono text-ink">pxPerMm</code>) and stores physical density (<code class="font-mono text-ink">devicePxPerMm = pxPerMm × dpr</code>) so your ruler stays consistent across browser zoom changes.
              </p>
            </div>
          </article>

          <article class="apple-utility-card flex flex-col justify-between">
            <div>
              <p class="type-kicker">Section 02 · Physical Standard</p>
              <h2 class="mt-2 type-tagline text-ink">Why is the ISO/IEC 7810 ID-1 card standard ideal for calibration?</h2>
              <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
                The ISO/IEC 7810:2019 ID-1 standard is the international dimensional specification governing bank cards, credit cards, driver licenses, and national identity cards worldwide. According to ISO/IEC 7810, every ID-1 card measures exactly 85.60 mm (3.370 in) in width, 53.98 mm (2.125 in) in height, and 0.76 mm in thickness, with a 3.18 mm (0.125 in) corner radius. Because card blanks are die-cut to sub-millimeter tolerances globally, matching an on-screen rectangle to a physical ID-1 card directly measures <code class="font-mono text-ink">pxPerMm = cardWidthPx / 85.60</code> on your screen. In practice, this optical alignment bypasses OS scaling distortion, multi-monitor EDID errors, and browser privacy restrictions without requiring hardware lookups.
              </p>
            </div>
          </article>

          <article class="apple-utility-card flex flex-col justify-between">
            <div>
              <p class="type-kicker">Section 03 · Scale Subdivisions</p>
              <h2 class="mt-2 type-tagline text-ink">
                How are metric millimeter and 1/16″ fractional graduations calculated?
              </h2>
              <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
                Ruler graduation rendering is governed by the international yard and pound agreement (NIST / BIPM), which defines 1 imperial inch as exactly 25.4 millimeters and 1 centimeter as 10 millimeters. In Centimeter (<a href="/cm-ruler" class="text-link underline">cm</a>) and Millimeter (<a href="/mm-ruler" class="text-link underline">mm</a>) modes, Online Ruler Plus generates minor ticks every 1.0 mm, medium ticks every 5.0 mm (0.5 cm), and labeled major ticks every 10.0 mm (1 cm). In Inch (<a href="/inch-ruler" class="text-link underline">in</a>) mode, every 25.4 mm inch interval is divided into 16 dyadic fractions of 1/16 inch (1.5875 mm): Level 1 marks 1/2 in (12.70 mm), Level 2 marks 1/4 and 3/4 in, Level 3 marks odd eighths, and Level 4 marks odd sixteenths.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Section 04 & 05 -->
    <section class="apple-tile-light border-t border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <article class="apple-utility-card">
            <p class="type-kicker">Section 04 · Secondary Verification Standards</p>
            <h2 class="mt-2 type-tagline text-ink">
              Which everyday coins, bills, and paper sizes verify screen calibration?
            </h2>
            <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
              After calibrating via credit card or display diagonal, you can cross-check physical scale accuracy using regulated everyday items. According to United States Mint specifications, a US One-Cent Penny measures 19.05 mm (exactly 0.750 in or 3/4 in) in diameter, a US Nickel measures 21.21 mm (0.835 in), and a US Quarter Dollar measures 24.26 mm (0.955 in). According to European Central Bank specifications, a 1 Euro coin measures 23.25 mm (0.915 in) and a 2 Euro coin measures 25.75 mm (1.014 in). For longer spans on desktop monitors, a US Federal Reserve Note measures 155.96 mm (6.14 in) wide, an IEC R6 AA battery measures 50.50 mm long, and an ISO 216 A4 sheet measures 210.0 mm across its short edge.
            </p>
          </article>

          <article class="apple-utility-card">
            <p class="type-kicker">Section 05 · Zoom &amp; Multi-Monitor Persistence</p>
            <h2 class="mt-2 type-tagline text-ink">
              How does Online Ruler Plus handle browser zoom and external monitors?
            </h2>
            <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
              Browser zoom and multi-monitor window movement alter <code class="font-mono text-ink">window.devicePixelRatio</code> and <code class="font-mono text-ink">window.screen</code> dimensions in real time. To prevent silent measurement drift, Online Ruler Plus converts your calibrated CSS scale (<code class="font-mono text-ink">pxPerMm</code>) into an invariant physical hardware density (<code class="font-mono text-ink">devicePxPerMm = pxPerMm × dpr</code>) keyed by display resolution signature in <code class="font-mono text-ink">localStorage</code>. When you zoom your browser on the same monitor, the display observer detects that the physical panel signature matches and divides <code class="font-mono text-ink">devicePxPerMm</code> by the new zoom ratio. If you drag the window onto a different external monitor, a status banner prompts you to verify calibration for that panel.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Section 06: Worked PPI Math & Reference Objects (Parchment Tile #f5f5f7) -->
    <section class="apple-tile-parchment border-t border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="type-kicker">Section 06 · Worked Calibration Calculations &amp; HiDPI Matrix</p>
          <h2 class="mt-1.5 type-display-lg text-ink">
            How CSS PPI, Physical PPI, and devicePxPerMm Relate Across Displays
          </h2>
          <p class="mt-3 max-w-2xl type-body text-ink-muted-80">
            Web browsers expose viewport CSS pixels rather than raw native LCD/OLED panel subpixels when HiDPI operating-system scaling is enabled. Using the Pythagorean diagonal formula on CSS pixels at 100% browser zoom yields exact <code class="font-mono text-ink">CSS px/mm</code> directly, while multiplying by <code class="font-mono text-ink">window.devicePixelRatio</code> yields zoom-invariant <code class="font-mono text-ink">devicePxPerMm</code>.
          </p>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-12">
          <div class="lg:col-span-7 overflow-x-auto rounded-[18px] border border-hairline bg-surface-primary p-4 sm:p-6">
            <h3 class="type-tagline text-ink">Worked Density Table by Display &amp; OS Scale</h3>
            <div class="mt-4 overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-hairline font-mono text-[11px] text-ink-muted-48">
                    <th class="py-2.5 pr-3 font-semibold">Display Configuration</th>
                    <th class="py-2.5 px-3 font-semibold">CSS Resolution</th>
                    <th class="py-2.5 px-3 font-semibold">Effective CSS PPI</th>
                    <th class="py-2.5 px-3 font-semibold">CSS px/mm</th>
                    <th class="py-2.5 pl-3 font-semibold">devicePxPerMm</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-hairline font-mono text-xs text-ink-muted-80">
                  {
                    workedExamples.map((row) => (
                      <tr>
                        <td class="py-3 pr-3 font-sans font-medium text-ink">{row.panel}</td>
                        <td class="py-3 px-3">{row.cssRes}</td>
                        <td class="py-3 px-3 text-link font-semibold">{row.cssPpi}</td>
                        <td class="py-3 px-3 text-ink">{row.pxPerMm}</td>
                        <td class="py-3 pl-3">{row.devicePxPerMm}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>

          <div class="lg:col-span-5 space-y-6">
            <article class="apple-utility-card">
              <p class="type-kicker">OS Scaling Caveat · Fractional &amp; Custom PPI</p>
              <h3 class="mt-2 type-tagline text-ink">Why card calibration outperforms guessed diagonal entry on scaled desktops</h3>
              <p class="mt-2.5 type-body text-ink-muted-80">
                Many users know they bought a "15-inch" or "27-inch" computer, yet real visible active panels often measure 15.6 inches, 16.0 inches, or 26.9 inches—and ultrawide or external monitors sometimes receive non-integer OS fractional scaling (Windows 125% or 150%, Linux Wayland fractional scaling, or macOS "More Space" scaled resolutions that render to a virtual framebuffer before downsampling). Those hidden framebuffers shift effective CSS PPI without changing the physical glass diagonal. Calibrating with a physical 85.60 mm ID-1 bank card measures the true end-to-end rendered pixel ratio on your screen directly, eliminating guesswork in under 15 seconds.
              </p>
            </article>

            <article class="apple-utility-card">
              <p class="type-kicker">Smartphone Constraints · Narrow Viewports</p>
              <h3 class="mt-2 type-tagline text-ink">Why mobile phones switch to Portrait Card Calibration (53.98 mm)</h3>
              <p class="mt-2.5 type-body text-ink-muted-80">
                A smartphone in portrait orientation typically measures 360 to 430 CSS pixels across (~58 to 72 mm physically). Because a landscape bank card is 85.60 mm wide, holding it horizontally overflows the phone screen and clips the alignment border. Whenever viewport width drops below landscape card bounds, Online Ruler Plus provides a dedicated <strong>Portrait Card Mode</strong> calibrated to the card’s short <strong>53.98 mm</strong> height (<code class="font-mono text-ink">pxPerMm = cardShortEdgePx / 53.98</code>), letting mobile users achieve crisp 1:1 physical accuracy vertically or rotate to landscape for longer runs.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 07: Optical Parallax Limits & Regulated Reference Object Table (Light Tile #ffffff) -->
    <section class="apple-tile-light border-t border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
          <div class="lg:col-span-5 space-y-6">
            <article class="apple-utility-card">
              <p class="type-kicker">Section 07 · Display Physics &amp; Accuracy Bounds</p>
              <h2 class="mt-2 type-tagline text-ink">
                Optical Cover-Glass Parallax &amp; Practical Tolerance Limits
              </h2>
              <p class="mt-2.5 type-body text-ink-muted-80">
                Every LCD, OLED, and Mini-LED panel separates its light-emitting subpixels from your physical object by outer cover glass, polarizer layers, or an air gap (roughly 0.5 mm to 1.5 mm thick depending on whether the panel is laminated). Because light refracts through glass (index <code class="font-mono text-ink">n ≈ 1.5</code>), viewing an object from an oblique angle <code class="font-mono text-ink">θ</code> introduces lateral parallax displacement approximately proportional to <code class="font-mono text-ink">glassThickness × sin(θ) / n</code>. At a 30-degree side tilt, even a perfectly calibrated monitor appears shifted by roughly 0.3 mm to 0.5 mm—nearly one-third of a millimeter graduation.
              </p>
              <p class="mt-3 type-body text-ink-muted-80">
                To keep readings repeatable within your screen’s sub-pixel resolution: align your line of sight straight perpendicular (90°) above the zero datum tick and again directly above the second guide line, calibrate with a rigid straight-edged ID-1 card rather than rounded paper corners, and switch to physical vernier calipers or micrometers whenever engineering tolerances are tighter than ±0.25 mm.
              </p>
            </article>
          </div>

          <div class="lg:col-span-7 overflow-x-auto rounded-[18px] border border-hairline bg-canvas-parchment p-4 sm:p-6">
            <h3 class="type-tagline text-ink">Published Physical Verification Objects Reference Table</h3>
            <p class="mt-1 type-caption text-ink-muted-80">
              After saving calibration, place any item below lightly on screen (avoiding sharp edges on coated glass) to verify scale agreement:
            </p>
            <div class="mt-4 overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-hairline font-mono text-[11px] text-ink-muted-48">
                    <th class="py-2.5 pr-3 font-semibold">Reference Object</th>
                    <th class="py-2.5 px-3 font-semibold">Metric (mm)</th>
                    <th class="py-2.5 px-3 font-semibold">Imperial (in)</th>
                    <th class="py-2.5 pl-3 font-semibold">Governing Standard</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-hairline font-mono text-xs text-ink-muted-80">
                  {
                    referenceItems.map((row) => (
                      <tr>
                        <td class="py-2.5 pr-3 font-sans font-medium text-ink">{row.item}</td>
                        <td class="py-2.5 px-3 text-link font-semibold">{row.mm}</td>
                        <td class="py-2.5 px-3 text-ink">{row.inches}</td>
                        <td class="py-2.5 pl-3 font-sans">{row.standard}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <HelpModal />
  <Footer />
  <script src="../scripts/app.ts"></script>
</BaseLayout>
