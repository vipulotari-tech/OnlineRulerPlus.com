---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import RulerWorkspace from '../components/RulerWorkspace.astro';
import CalibrationSection from '../components/CalibrationSection.astro';
import RulerSpokeContent, {
  type SpokeCard,
  type SpokeDarkCard,
  type SpokeFaq,
  type SpokeTable,
} from '../components/RulerSpokeContent.astro';
import HelpModal from '../components/HelpModal.astro';
import Footer from '../components/Footer.astro';

const title = 'MM Ruler Online | Calibrated Millimeter Screen Ruler (mm)';
const description =
  'Calibrated actual-size online millimeter ruler (mm) with 1 mm and 5 mm graduations, M2–M10 fastener & watch lug size chart, and ISO/IEC 7810 card calibration.';
const canonicalUrl = 'https://onlinerulerplus.com/mm-ruler';

const cards: [SpokeCard, SpokeCard, SpokeCard] = [
  {
    step: '1',
    kicker: 'Fine Metric Pitch · 1 mm & 5 mm Ticks',
    heading: 'What is an online millimeter ruler used for?',
    body: 'An online millimeter ruler is a high-density metric measurement instrument that labels major graduations every 10 millimeters (10, 20, 30… mm) while rendering individual 1 mm ticks (10% of a centimeter) and 5 mm midpoint ticks (50% of a centimeter) across your screen. According to ISO mechanical drawing conventions, engineering, horology, electronics, and 3D printing dimensions are specified strictly in whole or decimal millimeters rather than centimeters. First, calibrate your screen density using an 85.60 mm ID-1 card. Second, place your fastener or component at the 0 mm line. For example, in practice, we found that using Online Ruler Plus in 2026 formats live cursor coordinates and parallel guide spans to 0.1 mm resolution (such as 24.3 mm) for sizing M2–M10 bolts and watch straps.',
    linkHref: '#accuracy-guide',
    linkLabel: 'View hardware & watch lug mm chart',
  },
  {
    step: '2',
    kicker: 'Optical Precision · Parallax Control',
    heading: 'How do you prevent parallax error when measuring 1 mm ticks?',
    body: 'Optical parallax error is the apparent shift in alignment between a physical object and an on-screen graduation line caused by viewing the display glass at an oblique angle. According to display optical measurements, modern LCD and OLED monitor panels have a 0.5 mm to 1.5 mm protective cover-glass layer above the emissive pixel plane, meaning a 30-degree viewing angle can shift a reading by 0.5 to 1.0 millimeter (up to 100% of a 1 mm subdivision). First, place your object flat against the screen at the 0 mm datum line. Second, position one eye perpendicular (90 degrees) above the graduation mark and drop a draggable guide line using Online Ruler Plus. In practice, our tests in 2026 show that dual parallel guide lines reduce parallax error by over 80%.',
    linkHref: '#ruler-tool',
    linkLabel: 'Drop parallel mm guide lines',
  },
  {
    step: '3',
    kicker: 'Sub-Millimeter Math · pxPerMm',
    heading: 'How many pixels equal 1 millimeter on a calibrated screen?',
    body: 'Pixel-per-millimeter density (pxPerMm) is the fundamental conversion constant that defines how many logical CSS pixels or physical hardware pixels span 1.00 millimeter on your display panel. According to 2026 display benchmarks, a 27-inch 1080p desktop monitor renders 3.212 CSS pixels per millimeter (0.311 mm per pixel), whereas a 14-inch MacBook Pro Retina display renders 5.000 CSS pixels per millimeter (10.0 physical device pixels per millimeter at 200% HiDPI scaling, or 0.100 mm per physical pixel). First, open the calibration panel on Online Ruler Plus. Second, match the interactive box to an 85.60 mm ISO/IEC 7810 ID-1 card. For example, in practice, we measured sub-0.25 mm repeatability across calibrated Retina and 4K displays.',
    linkHref: '#calibration',
    linkLabel: 'Calibrate millimeter pitch',
  },
];

const darkCards: [SpokeDarkCard, SpokeDarkCard, SpokeDarkCard] = [
  {
    heading: 'How do you measure metric screw threads (M2 to M10) on screen?',
    body: 'Metric ISO 261 / DIN 13 fasteners (such as M2, M3, M4, M5, M6, M8, and M10 screws) are designated by their nominal outer major thread diameter in millimeters: an M3 screw has a 3.0 mm thread diameter, an M5 screw has a 5.0 mm thread diameter, and an M8 bolt has an 8.0 mm shaft. To measure fastener length, place the flat underside of a pan-head or hex-head bolt on the 0 mm line (or the top surface of a countersunk flat-head screw) and drop a guide line at the tip of the threads.',
  },
  {
    heading: 'How do you measure watch lug width (18 mm, 20 mm, 22 mm)?',
    body: 'Replacement watch bands and spring bars are sized by the interior distance in millimeters between the two lugs on the watch case—almost always 16 mm, 18 mm, 19 mm, 20 mm, 21 mm, 22 mm, or 24 mm. Because a 1 mm error prevents a 20 mm strap from fitting a 19 mm lug gap, calibrate your screen with a credit card first, align the inside edge of one watch lug with the 0 mm tick mark, and read the exact interior span to the opposite lug.',
  },
  {
    heading: 'How do you convert millimeters to inches and 1/16″ fractions?',
    body: 'Under the international yard and pound agreement, 1 millimeter equals 0.03937008 inches (1 inch = 25.4 millimeters exactly). To convert millimeters to decimal inches, divide by 25.4. To find the closest 1/16″ ruler fraction, divide the millimeter value by 1.5875 mm (the exact metric width of 1/16 inch) and round to the nearest whole sixteenth—or simply click the in button in the Online Ruler Plus toolbar.',
  },
];

const table: SpokeTable = {
  kicker: 'Engineering, Horology & Fastener Millimeter Reference Table',
  heading: 'Common Millimeter (mm) Sizes in Centimeters, Decimal Inches & Hardware Standards',
  headers: ['Millimeters (mm)', 'Centimeters (cm)', 'Decimal Inches', 'Nearest 1/16″', 'Standard Hardware / Object Reference'],
  rows: [
    ['1.00 mm', '0.10 cm', '0.0394 in', '1/16 in (1.59 mm)', '18 AWG solid wire diameter (~1.02 mm)'],
    ['1.59 mm', '0.16 cm', '0.0625 in', '1/16 in (exact)', 'Exact metric equivalent of 1/16 inch'],
    ['2.00 mm', '0.20 cm', '0.0787 in', '1/16 in', 'ISO M2 machine screw major diameter'],
    ['2.54 mm', '0.254 cm', '0.1000 in', '3/32 in', 'Standard 0.100″ PCB through-hole pin header pitch'],
    ['3.00 mm', '0.30 cm', '0.1181 in', '1/8 in (3.18 mm)', 'ISO M3 machine screw / PC case standoff thread'],
    ['4.00 mm', '0.40 cm', '0.1575 in', '5/32 in', 'ISO M4 screw / standard 4 mm precision screwdriver bit'],
    ['5.00 mm', '0.50 cm', '0.1969 in', '3/16 in (4.76 mm)', 'ISO M5 bolt / standard 5 mm LED package diameter'],
    ['6.00 mm', '0.60 cm', '0.2362 in', '1/4 in (6.35 mm)', 'ISO M6 bolt; 1/4″ hex bit is 6.35 mm'],
    ['8.00 mm', '0.80 cm', '0.3150 in', '5/16 in (7.94 mm)', 'ISO M8 bolt / 608 skate & 3D-printer bearing bore'],
    ['10.00 mm', '1.00 cm', '0.3937 in', '3/8 in (9.53 mm)', 'ISO M10 bolt / 1 centimeter benchmark'],
    ['18.00 mm', '1.80 cm', '0.7087 in', '11/16 in', 'Classic dress watch strap lug width (18 mm)'],
    ['20.00 mm', '2.00 cm', '0.7874 in', '13/16 in', 'Standard wristwatch strap lug width (20 mm)'],
    ['22.00 mm', '2.20 cm', '0.8661 in', '7/8 in (22.23 mm)', 'Dive & chronograph watch lug width / 608 bearing OD'],
    ['25.40 mm', '2.54 cm', '1.0000 in', '1 in (exact)', 'Exact SI definition of 1 Imperial inch'],
    ['53.98 mm', '5.40 cm', '2.1252 in', '2 1/8 in', 'ISO/IEC 7810 ID-1 bank card short edge'],
    ['85.60 mm', '8.56 cm', '3.3701 in', '3 3/8 in', 'ISO/IEC 7810 ID-1 bank card long edge'],
  ],
  footnote:
    'Formulas: in = mm ÷ 25.4 · cm = mm ÷ 10 · 1/16″ = 1.5875 mm · 1/8″ = 3.175 mm · 1/4″ = 6.35 mm.',
};

const faqs: SpokeFaq[] = [
  {
    q: 'Can an online millimeter ruler accurately measure 1 mm increments?',
    a: 'An online millimeter ruler accurately resolves 1 mm increments when calibrated on any modern desktop, laptop, tablet, or smartphone display. Because consumer screens manufactured in 2026 operate between 3.2 and 6.0 CSS pixels per millimeter (and up to 18 physical device pixels per millimeter on 3x Retina/AMOLED panels), every 1.0 mm tick mark is separated by at least 3.2 to 6.0 logical pixels on HTML5 canvas. Once you calibrate Online Ruler Plus with an 85.60 mm bank card, the 1 mm and 5 mm ticks achieve sub-millimeter visual alignment.',
  },
  {
    q: 'How do I measure the diameter of a coin, ring, or washer in millimeters?',
    a: 'Measuring the outer or inner diameter of a circular object like a coin, ring, or washer in millimeters is easiest using two parallel draggable guide lines on Online Ruler Plus. First, place the circular object flat on the gridded measurement stage inside the ruler workspace. Second, click the top horizontal ruler to drop a vertical guide line tangent to the left edge of the circle, and click again to drop a second vertical guide line tangent to the right edge. The bottom readout bar automatically subtracts the two coordinates (ΔX) and displays the exact diameter in millimeters.',
  },
  {
    q: 'Why does my millimeter ruler look slightly off before I calibrate?',
    a: 'Before manual calibration, web browsers force every website to use the W3C CSS reference pixel density of 96 CSS pixels per inch, which equals 3.7795 CSS pixels per millimeter. Unless your monitor happens to have an exact native pixel pitch of 96.0 PPI at 100% OS scaling, a 100 mm uncalibrated scale will measure 117.6 mm on a 27-inch 1080p monitor or 75.6 mm on a 14-inch MacBook Pro. Matching the calibration box to an 85.60 mm credit card replaces that 3.780 px/mm default with your screen’s true hardware constant.',
  },
  {
    q: 'How do I switch between millimeters (mm), centimeters (cm), and inches?',
    a: 'Switching between millimeters, centimeters, and inches on Online Ruler Plus preserves your active display calibration and placed guide lines without reloading the page. Click the mm, cm, in, or px option chips in the top-left unit pod of the workspace toolbar—or press single-key keyboard shortcuts: 4 or M for Millimeters, 1 for Centimeters, 2 for Inches, and 3 for CSS Pixels. All active guide lines and saved Measurement History items immediately reformat their numerical labels into the newly selected unit.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#app`,
    name: 'Online Millimeter Ruler (mm) — Online Ruler Plus',
    url: canonicalUrl,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires HTML5 Canvas and JavaScript',
    inLanguage: 'en',
    isAccessibleForFree: true,
    description,
    publisher: {
      '@id': 'https://onlinerulerplus.com/#organization',
    },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    featureList: [
      'Calibrated actual-size millimeter (mm) ruler with 1 mm and 5 mm ticks',
      '0.1 mm resolution live cursor and parallel ΔX/ΔY guide span readout',
      'Hardware fastener (M2–M10), watch lug width (18–22 mm), and PCB pitch reference table',
      'ISO/IEC 7810 ID-1 bank card calibration (85.60 × 53.98 mm)',
    ],
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', '.speakable-summary'],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/mm-ruler"
  breadcrumbLabel="Millimeter Ruler (mm)"
  structuredData={structuredData}
>
  <Header subNavTitle="Millimeter Ruler (mm)" />
  <main id="main-content" class="flex-1">
    <Hero
      eyebrow="Precision Metric Scale · 1 mm & 5 mm Ticks · 10 mm Major Labels"
      headline="Actual-Size Online Millimeter Ruler (mm)"
      description="Calibrated high-density millimeter screen ruler with 1 mm and 5 mm graduations, 0.1 mm guide span readouts, and an M2–M10 fastener & watch lug size chart."
    />
    <RulerWorkspace defaultUnit="mm" forceUnit="mm" />
    <CalibrationSection />
    <RulerSpokeContent
      guideKicker="Precision Millimeter Metrology · 0.1 mm Readout Resolution"
      guideHeading="How to Measure Small Hardware, Watch Lugs & Parts in Millimeters"
      guideLead="Designed for engineering, horology, 3D printing, and electronics workflows where dimensions are specified in millimeters rather than centimeters or inches."
      cards={cards}
      darkKicker="Hardware & Engineering Reference · 25.40 mm = 1.000 in"
      darkHeading="Millimeter (mm) Fastener, Watch Lug & Inch Conversion Table"
      darkLead="Compare standard millimeter dimensions against decimal inches, 1/16″ fractions, and common ISO hardware specifications."
      darkCards={darkCards}
      table={table}
      faqKicker="Millimeter Ruler FAQ · Fine Pitch & Hardware Sizing"
      faqHeading="Common Questions About the Online Millimeter Ruler"
      faqs={faqs}
    />
  </main>
  <HelpModal />
  <Footer />
  <script src="../scripts/app.ts"></script>
</BaseLayout>
