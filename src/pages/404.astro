---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HelpModal from '../components/HelpModal.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_LOCALE, localizedPath } from '../i18n/config.ts';
import { getDict } from '../i18n/index.ts';
import { BLOG_CATEGORIES } from '../lib/blog.ts';

const locale = DEFAULT_LOCALE;
const dict = getDict(locale);

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) =>
    (b.data.updatedDate ?? b.data.pubDate).getTime() -
    (a.data.updatedDate ?? a.data.pubDate).getTime(),
);

const quickTools = [
  { href: '/cm-ruler', label: 'CM Ruler', kind: 'Instrument' },
  { href: '/mm-ruler', label: 'MM Ruler', kind: 'Instrument' },
  { href: '/inch-ruler', label: 'Inch Ruler', kind: 'Instrument' },
  { href: '/horizontal-ruler', label: 'Horizontal Ruler', kind: 'Instrument' },
  { href: '/vertical-ruler', label: 'Vertical Ruler', kind: 'Instrument' },
  { href: '/photo-ruler', label: 'Photo Measurement', kind: 'Instrument' },
  { href: '/protractor', label: '360° Protractor', kind: 'Instrument' },
  { href: '/circle-ruler', label: 'Circle & Diameter Gauge', kind: 'Instrument' },
  { href: '/quadrant', label: 'XY Quadrant Ruler', kind: 'Instrument' },
  { href: '/screen-size-detector', label: 'Screen PPI Detector', kind: 'Calibration' },
  { href: '/printable-ruler', label: 'Printable Rulers', kind: 'Print PDF' },
  { href: '/calibration-guide', label: 'Calibration Guide', kind: 'Guide' },
];

const searchableItems = [
  { href: '/', label: 'Online Ruler (Main Workspace)', kind: 'Homepage' },
  ...quickTools,
  { href: '/how-to-use', label: 'How to Use an Online Ruler', kind: 'Guide' },
  { href: '/faq', label: 'Frequently Asked Questions', kind: 'FAQ' },
  { href: '/blog', label: 'Measurement Blog Index', kind: 'Blog' },
  ...BLOG_CATEGORIES.map((cat) => ({
    href: `/blog/${cat.slug}`,
    label: cat.name,
    kind: 'Category',
  })),
  ...posts.map((post) => ({
    href: `/blog/${post.id}`,
    label: post.data.title,
    kind: 'Article',
  })),
];
---

<BaseLayout
  locale={locale}
  title="404 — Page Not Found | OnlineRulerPlus.com"
  description="The requested page could not be found on OnlineRulerPlus.com. Launch the calibrated on-screen ruler, search tools, or browse measurement guides."
  omitCanonical={true}
  robots="noindex, nofollow"
>
  <Header
    locale={locale}
    subNavTitle={dict.brandName}
    subNavCtaHref={localizedPath(locale, '/')}
    subNavCtaLabel={dict.nav.defaultSubNavCta}
  />

  <main id="main-content" class="flex-1 flex items-center py-14 sm:py-20">
    <section class="mx-auto w-full max-w-[840px] px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-parchment px-3.5 py-1 font-mono text-xs font-semibold text-link">
        <span class="h-1.5 w-1.5 rounded-full bg-link" aria-hidden="true"></span>
        <span>404 · PAGE NOT FOUND</span>
      </div>

      <h1 class="mt-5 type-display-lg text-ink">
        Page Not Found
      </h1>

      <p class="mt-3 mx-auto max-w-xl type-body text-ink-muted-80">
        The URL you requested does not exist on OnlineRulerPlus.com. Return to the calibrated workspace, search tools and guides below, or explore one of our measurement categories.
      </p>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a href={localizedPath(locale, '/')} class="apple-btn-primary px-5 py-2.5">
          Open Online Ruler
        </a>
        <a href="/blog" class="apple-btn-secondary-pill px-5 py-2.5">
          Browse Measurement Blog
        </a>
        <a href={localizedPath(locale, '/how-to-use')} class="apple-btn-secondary-pill px-5 py-2.5">
          Visual Field Guide
        </a>
      </div>

      <div class="mt-9 rounded-[16px] border border-hairline bg-canvas-parchment p-5 text-left">
        <label
          for="notfound-search"
          class="block font-mono text-[11px] font-semibold uppercase tracking-wider text-ink-muted-48"
        >
          Search Tools & Measurement Guides
        </label>
        <input
          id="notfound-search"
          type="search"
          data-404-search
          placeholder="Search rulers, PPI calibration, printable charts, or blog articles..."
          class="mt-2 w-full rounded-[10px] border border-hairline bg-canvas-elevated px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-muted-48 focus:border-primary-focus focus:outline-none"
        />
        <ul
          data-404-results
          hidden
          class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2"
          aria-live="polite"
        >
          {searchableItems.map((item) => (
            <li data-search-item data-search-text={`${item.label} ${item.kind} ${item.href}`.toLowerCase()}>
              <a
                href={item.href}
                class="flex items-center justify-between gap-2 rounded-[10px] border border-hairline bg-canvas-elevated px-3.5 py-2 text-xs font-medium text-ink hover:border-primary-focus hover:text-link transition-colors"
              >
                <span class="truncate">{item.label}</span>
                <span class="shrink-0 font-mono text-[10px] uppercase text-ink-muted-48">{item.kind}</span>
              </a>
            </li>
          ))}
        </ul>
        <p data-404-empty hidden class="mt-3 text-xs text-ink-muted-80">
          No matching tool or article found. Try keywords like &ldquo;inch&rdquo;, &ldquo;cm&rdquo;, &ldquo;ppi&rdquo;, or &ldquo;calibration&rdquo;.
        </p>

        <div data-404-default>
          <p class="mt-5 font-mono text-[11px] font-semibold uppercase tracking-wider text-ink-muted-48">
            Popular Instruments
          </p>
          <div class="mt-2.5 grid grid-cols-2 gap-2 sm:grid-cols-3">
            {quickTools.slice(0, 6).map((tool) => (
              <a
                href={localizedPath(locale, tool.href)}
                class="rounded-[10px] border border-hairline bg-canvas-elevated px-3.5 py-2.5 text-xs font-medium text-ink hover:border-primary-focus hover:text-link transition-colors"
              >
                {tool.label} →
              </a>
            ))}
          </div>

          <p class="mt-5 font-mono text-[11px] font-semibold uppercase tracking-wider text-ink-muted-48">
            Guide Categories
          </p>
          <div class="mt-2.5 grid grid-cols-1 gap-2 sm:grid-cols-2">
            {BLOG_CATEGORIES.map((cat) => (
              <a
                href={`/blog/${cat.slug}`}
                class="rounded-[10px] border border-hairline bg-canvas-elevated px-3.5 py-2.5 text-xs font-medium text-ink hover:border-primary-focus hover:text-link transition-colors"
              >
                {cat.name} →
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <HelpModal locale={locale} />
  <Footer locale={locale} />
  <script is:inline>
    (() => {
      const input = document.querySelector('[data-404-search]');
      const resultsList = document.querySelector('[data-404-results]');
      const defaultBlock = document.querySelector('[data-404-default]');
      const emptyMsg = document.querySelector('[data-404-empty]');
      if (!input || !resultsList || !defaultBlock || !emptyMsg) return;
      const items = Array.from(resultsList.querySelectorAll('[data-search-item]'));
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        if (!q) {
          resultsList.hidden = true;
          emptyMsg.hidden = true;
          defaultBlock.hidden = false;
          return;
        }
        defaultBlock.hidden = true;
        let matches = 0;
        for (const li of items) {
          const text = li.getAttribute('data-search-text') || '';
          const show = text.includes(q);
          li.hidden = !show || matches >= 8;
          if (show) matches += 1;
        }
        resultsList.hidden = matches === 0;
        emptyMsg.hidden = matches > 0;
      });
    })();
  </script>
  <script src="../scripts/app.ts"></script>
</BaseLayout>
