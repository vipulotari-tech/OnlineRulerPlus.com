---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HelpModal from '../components/HelpModal.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_LOCALE, localizedPath } from '../i18n/config.ts';
import { getDict } from '../i18n/index.ts';

const locale = DEFAULT_LOCALE;
const dict = getDict(locale);

const quickTools = [
  { href: '/cm-ruler', label: 'CM Ruler' },
  { href: '/mm-ruler', label: 'MM Ruler' },
  { href: '/inch-ruler', label: 'Inch Ruler' },
  { href: '/photo-ruler', label: 'Photo Measurement' },
  { href: '/protractor', label: '360° Protractor' },
  { href: '/calibration-guide', label: 'Calibration Guide' },
];
---

<BaseLayout
  locale={locale}
  title="404 — Page Not Found | OnlineRulerPlus.com"
  description="The requested page could not be found on OnlineRulerPlus.com. Launch the calibrated on-screen ruler or browse measurement guides."
  canonicalPath="/404"
  robots="noindex, follow"
>
  <Header
    locale={locale}
    subNavTitle={dict.brandName}
    subNavCtaHref={localizedPath(locale, '/')}
    subNavCtaLabel={dict.nav.defaultSubNavCta}
  />

  <main id="main-content" class="flex-1 flex items-center py-16 sm:py-24">
    <section class="mx-auto w-full max-w-[780px] px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-parchment px-3.5 py-1 font-mono text-xs font-semibold text-link">
        <span class="h-1.5 w-1.5 rounded-full bg-link" aria-hidden="true"></span>
        <span>404 · ROUTE NOT FOUND</span>
      </div>

      <h1 class="mt-5 type-display-lg text-ink">
        This page could not be found.
      </h1>

      <p class="mt-3 mx-auto max-w-xl type-body text-ink-muted-80">
        The URL you entered does not match a measurement tool or guide on OnlineRulerPlus.com. Jump back into the calibrated workspace or open one of our core instruments below.
      </p>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a href={localizedPath(locale, '/')} class="apple-btn-primary px-5 py-2.5">
          Open Online Ruler
        </a>
        <a href={localizedPath(locale, '/how-to-use')} class="apple-btn-secondary-pill px-5 py-2.5">
          Visual Field Guide
        </a>
      </div>

      <div class="mt-10 rounded-[16px] border border-hairline bg-canvas-parchment p-5 text-left">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-wider text-ink-muted-48">
          Popular Instruments
        </p>
        <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
          {quickTools.map((tool) => (
            <a
              href={localizedPath(locale, tool.href)}
              class="rounded-[10px] border border-hairline bg-canvas-elevated px-3.5 py-2.5 text-xs font-medium text-ink hover:border-primary-focus hover:text-link transition-colors"
            >
              {tool.label} →
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <HelpModal locale={locale} />
  <Footer locale={locale} />
  <script src="../scripts/app.ts"></script>
</BaseLayout>
