---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import HelpModal from '../../components/HelpModal.astro';
import Footer from '../../components/Footer.astro';
import DiagramFigure from '../../components/DiagramFigure.astro';
import {
  LOCALE_META,
  getLocaleStaticPaths,
  localizedPath,
  type Locale,
} from '../../i18n/config.ts';
import { getDict } from '../../i18n/index.ts';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const dict = getDict(locale);
const page = dict.pages.screenDetector;
const meta = LOCALE_META[locale];

const siteOrigin = Astro.site ? Astro.site.origin : 'https://onlinerulerplus.com';
const routePath = localizedPath(locale, '/screen-size-detector');
const canonicalUrl = `${siteOrigin}${routePath}`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#app`,
    name: page.schemaName,
    url: canonicalUrl,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    inLanguage: meta.bcp47,
    isAccessibleForFree: true,
    description: page.description,
    publisher: { '@id': `${siteOrigin}/#organization` },
  },
];

const DIAGONAL_PRESETS = [13.3, 14, 15.6, 16, 21.5, 24, 27, 32, 34];
---

<BaseLayout
  locale={locale}
  title={page.title}
  description={page.description}
  canonicalPath="/screen-size-detector"
  breadcrumbLabel={page.breadcrumbLabel}
  structuredData={structuredData}
>
  <Header
    locale={locale}
    subNavTitle={page.subNavTitle}
    subNavCtaHref={localizedPath(locale, '/#ruler-tool')}
    subNavCtaLabel={page.openRulerBtn}
  />
  <main id="main-content" class="flex-1">
    <section class="apple-page-hero border-b border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <p class="type-kicker">{page.heroKicker}</p>
            <h1 class="mt-2 type-hero-display text-ink">{page.heroHeadline}</h1>
            <p class="speakable-summary mt-3 max-w-[62ch] type-lead-airy text-ink-muted-80">
              {page.heroSummary}
            </p>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <a href={localizedPath(locale, '/#ruler-tool')} class="apple-btn-primary">
              {page.openRulerBtn}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="screen-detector-app" class="apple-tile-parchment border-b border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          <!-- Left: Live Browser Signals -->
          <div class="apple-utility-card lg:col-span-6">
            <p class="type-kicker">{page.liveCardKicker}</p>
            <h2 class="mt-1 type-tagline text-ink">{page.liveCardHeading}</h2>

            <dl class="mt-5 divide-y divide-hairline font-mono text-xs sm:text-sm">
              <div class="flex items-center justify-between py-2.5 gap-3">
                <dt class="text-ink-muted-80">{page.labelCssRes}</dt>
                <dd id="det-css-res" class="font-semibold text-ink">—</dd>
              </div>
              <div class="flex items-center justify-between py-2.5 gap-3">
                <dt class="text-ink-muted-80">{page.labelPhysRes}</dt>
                <dd id="det-phys-res" class="font-semibold text-ink">—</dd>
              </div>
              <div class="flex items-center justify-between py-2.5 gap-3">
                <dt class="text-ink-muted-80">{page.labelViewport}</dt>
                <dd id="det-viewport" class="font-semibold text-ink">—</dd>
              </div>
              <div class="flex items-center justify-between py-2.5 gap-3">
                <dt class="text-ink-muted-80">{page.labelDpr}</dt>
                <dd id="det-dpr" class="font-semibold text-ink">—</dd>
              </div>
              <div class="flex items-center justify-between py-2.5 gap-3">
                <dt class="text-ink-muted-80">{page.labelAspect}</dt>
                <dd id="det-aspect" class="font-semibold text-ink">—</dd>
              </div>
              <div class="flex items-center justify-between py-2.5 gap-3">
                <dt class="text-ink-muted-80">{page.labelZoom}</dt>
                <dd id="det-vv-scale" class="font-semibold text-ink">—</dd>
              </div>
              <div class="flex items-center justify-between py-2.5 gap-3">
                <dt class="text-ink-muted-80">{page.labelCalStatus}</dt>
                <dd id="det-cal-status" class="font-semibold text-link">—</dd>
              </div>
              <div class="flex items-center justify-between py-2.5 gap-3">
                <dt class="text-ink-muted-80">{page.labelCalBasis}</dt>
                <dd id="det-cal-basis" class="text-right text-ink-muted-80">—</dd>
              </div>
            </dl>
          </div>

          <!-- Right: Interactive Diagonal & Pixel Pitch Calculator -->
          <div class="apple-utility-card lg:col-span-6 flex flex-col justify-between">
            <div>
              <p class="type-kicker">{page.geomCardKicker}</p>
              <h2 class="mt-1 type-tagline text-ink">{page.geomCardHeading}</h2>

              <div class="mt-4">
                <span class="block font-mono text-[11px] font-semibold text-ink-muted-48">{page.presetsLabel}</span>
                <div class="mt-2 flex flex-wrap gap-2">
                  {DIAGONAL_PRESETS.map((diag) => (
                    <button
                      type="button"
                      data-detector-diag={String(diag)}
                      data-active={diag === 24 ? 'true' : 'false'}
                      aria-pressed={diag === 24 ? 'true' : 'false'}
                      class="apple-option-chip font-mono text-xs"
                    >
                      {diag}″
                    </button>
                  ))}
                </div>
              </div>

              <div class="mt-4 flex flex-wrap items-end gap-3">
                <div class="flex-1 min-w-[180px]">
                  <label for="detector-diagonal-input" class="block type-caption-strong text-ink">
                    {page.customDiagLabel}
                  </label>
                  <input
                    id="detector-diagonal-input"
                    type="number"
                    min="3"
                    max="100"
                    step="0.1"
                    value="24"
                    class="mt-1.5 apple-input-pill w-full font-mono"
                  />
                </div>
                <button id="btn-detector-save-cal" type="button" class="apple-btn-primary">
                  {page.applyBtn}
                </button>
              </div>

              <p
                id="detector-saved-banner"
                role="status"
                class="hidden mt-3 rounded-[12px] border border-primary/30 bg-link-soft px-3.5 py-2 font-mono text-xs font-semibold text-link"
              >
                {page.savedBanner}
              </p>

              <dl class="mt-5 divide-y divide-hairline font-mono text-xs sm:text-sm">
                <div class="flex items-center justify-between py-2 gap-3">
                  <dt class="text-ink-muted-80">{page.labelCalcWidth}</dt>
                  <dd id="det-calc-width" class="font-semibold text-ink">—</dd>
                </div>
                <div class="flex items-center justify-between py-2 gap-3">
                  <dt class="text-ink-muted-80">{page.labelCalcHeight}</dt>
                  <dd id="det-calc-height" class="font-semibold text-ink">—</dd>
                </div>
                <div class="flex items-center justify-between py-2 gap-3">
                  <dt class="text-ink-muted-80">{page.labelCalcCssPpi}</dt>
                  <dd id="det-calc-css-ppi" class="font-semibold text-link">—</dd>
                </div>
                <div class="flex items-center justify-between py-2 gap-3">
                  <dt class="text-ink-muted-80">{page.labelCalcDevPpi}</dt>
                  <dd id="det-calc-dev-ppi" class="font-semibold text-ink">—</dd>
                </div>
                <div class="flex items-center justify-between py-2 gap-3">
                  <dt class="text-ink-muted-80">{page.labelCalcPitch}</dt>
                  <dd id="det-calc-pitch" class="font-semibold text-ink">—</dd>
                </div>
              </dl>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {page.guideCards.map((card) => (
            <article class="apple-utility-card">
              <p class="type-kicker">{card.kicker}</p>
              <h3 class="mt-1 type-body-strong text-ink">{card.heading}</h3>
              <p class="mt-2 type-caption text-ink-muted-80">{card.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="detector-visual-reference" class="apple-tile-light">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="max-w-3xl">
          <p class="type-kicker">{dict.visuals.sections.detectorVisualKicker}</p>
          <h2 class="mt-1.5 type-display-md text-ink">{dict.visuals.sections.detectorVisualHeading}</h2>
          <p class="mt-2 max-w-2xl type-body text-ink-muted-80">{dict.visuals.sections.detectorVisualLead}</p>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <DiagramFigure
            svgSrc="/visuals/diagrams/09-screen-dpi-ppi-accuracy.svg"
            kicker={dict.visuals.diagrams.d09.kicker}
            title={dict.visuals.diagrams.d09.title}
            alt={dict.visuals.diagrams.d09.alt}
            caption={dict.visuals.diagrams.d09.caption}
          />
          <DiagramFigure
            svgSrc="/visuals/diagrams/02-credit-card-calibration.svg"
            kicker={dict.visuals.diagrams.d02.kicker}
            title={dict.visuals.diagrams.d02.title}
            alt={dict.visuals.diagrams.d02.alt}
            caption={dict.visuals.diagrams.d02.caption}
          />
        </div>
      </div>
    </section>
  </main>
  <HelpModal locale={locale} />
  <Footer locale={locale} />
  <script src="../../scripts/app.ts"></script>
</BaseLayout>
