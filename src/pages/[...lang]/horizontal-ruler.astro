---
import SpokeRulerPage from '../../components/SpokeRulerPage.astro';
import { getLocaleStaticPaths, type Locale } from '../../i18n/config.ts';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
---

<SpokeRulerPage
  locale={locale}
  canonicalPath="/horizontal-ruler"
  pageKey="horizontalRuler"
  defaultUnit="cm"
  forceEdges="horizontal"
/>
