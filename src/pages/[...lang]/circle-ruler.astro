---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import HelpModal from '../../components/HelpModal.astro';
import Footer from '../../components/Footer.astro';
import {
  LOCALE_META,
  getLocaleStaticPaths,
  localizedPath,
  type Locale,
} from '../../i18n/config.ts';
import { getDict } from '../../i18n/index.ts';
import { CIRCLE_PRESETS } from '../../lib/ruler/circle-gauge.ts';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { locale } = Astro.props as { locale: Locale };
const dict = getDict(locale);
const page = dict.pages.circleRuler;
const meta = LOCALE_META[locale];

const siteOrigin = Astro.site ? Astro.site.origin : 'https://onlinerulerplus.com';
const routePath = localizedPath(locale, '/circle-ruler');
const canonicalUrl = `${siteOrigin}${routePath}`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${canonicalUrl}#app`,
    name: page.schemaName,
    url: canonicalUrl,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires HTML5 Canvas and JavaScript',
    inLanguage: meta.bcp47,
    isAccessibleForFree: true,
    description: page.description,
    screenshot: `${siteOrigin}/og-image.png`,
    publisher: { '@id': `${siteOrigin}/#organization` },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1'],
    },
  },
];
---

<BaseLayout
  locale={locale}
  title={page.title}
  description={page.description}
  canonicalPath="/circle-ruler"
  breadcrumbLabel={page.breadcrumbLabel}
  structuredData={structuredData}
>
  <Header
    locale={locale}
    subNavTitle={page.subNavTitle}
    subNavCtaHref={localizedPath(locale, '/#calibration')}
    subNavCtaLabel={dict.nav.defaultSubNavCta}
  />
  <main id="main-content" class="flex-1">
    <section class="apple-page-hero border-b border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl">
            <p class="type-kicker">{page.heroKicker}</p>
            <h1 class="mt-2 type-hero-display text-ink">{page.heroHeadline}</h1>
            <p class="speakable-summary mt-3 max-w-[62ch] type-lead-airy text-ink-muted-80">
              {page.heroSummary}
            </p>
          </div>
          <a href={localizedPath(locale, '/#ruler-tool')} class="apple-btn-primary shrink-0">
            {dict.pages.screenDetector.openRulerBtn}
          </a>
        </div>
      </div>
    </section>

    <section id="circle-gauge-app" class="apple-tile-parchment border-b border-hairline">
      <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          <!-- Left Canvas -->
          <div class="apple-utility-card lg:col-span-7 flex flex-col items-center">
            <div class="w-full overflow-hidden rounded-[14px] border border-hairline bg-canvas">
              <canvas id="circle-gauge-canvas" class="block w-full cursor-ew-resize touch-none"></canvas>
            </div>

            <div class="mt-4 w-full space-y-3">
              <div class="flex items-center justify-between gap-2">
                <label for="circle-diameter-slider" class="type-caption-strong text-ink">
                  {page.diameterLabel}
                </label>
                <span id="cg-cal-ppi" class="font-mono text-xs text-ink-muted-80">96.0 PPI</span>
              </div>

              <div class="flex flex-wrap sm:flex-nowrap items-center gap-2">
                <button id="circle-minus-btn" type="button" class="apple-btn-pearl px-3 font-mono text-xs shrink-0" aria-label="Decrease diameter 0.5 mm">−0.5</button>
                <input
                  id="circle-diameter-slider"
                  type="range"
                  min="1"
                  max="150"
                  step="0.1"
                  value="24.26"
                  aria-label={page.diameterLabel}
                  class="order-first w-full sm:order-none sm:w-auto sm:flex-1 min-w-0 min-h-[44px] sm:min-h-0 accent-primary cursor-pointer"
                />
                <input
                  id="circle-diameter-input"
                  type="number"
                  min="1"
                  max="150"
                  step="0.01"
                  value="24.26"
                  aria-label={page.diameterLabel}
                  class="h-[44px] sm:h-[34px] flex-1 sm:flex-none sm:w-24 min-w-[80px] rounded-full border border-hairline bg-canvas px-3 text-center font-mono text-base sm:text-xs font-semibold text-ink"
                />
                <button id="circle-plus-btn" type="button" class="apple-btn-pearl px-3 font-mono text-xs shrink-0" aria-label="Increase diameter 0.5 mm">+0.5</button>
              </div>
            </div>
          </div>

          <!-- Right Presets & Readout -->
          <div class="apple-utility-card lg:col-span-5 flex flex-col justify-between space-y-5">
            <div>
              <p class="type-kicker">{page.presetsLabel}</p>
              <div class="mt-2.5 flex flex-wrap gap-1.5">
                {CIRCLE_PRESETS.map((p) => (
                  <button
                    type="button"
                    data-circle-preset={String(p.diameterMm)}
                    data-active={p.id === 'quarter' ? 'true' : 'false'}
                    aria-pressed={p.id === 'quarter' ? 'true' : 'false'}
                    class="apple-option-chip font-mono text-xs"
                  >
                    {p.label}
                  </button>
                ))}
              </div>
            </div>

            <div>
              <h2 class="type-body-strong text-ink">{page.readoutTitle}</h2>
              <dl class="mt-3 divide-y divide-hairline font-mono text-xs sm:text-sm">
                <div class="flex items-center justify-between py-2 gap-3">
                  <dt class="text-ink-muted-80">{page.labelDiameter}</dt>
                  <dd id="cg-dia-mm" class="font-semibold text-link">24.26 mm</dd>
                </div>
                <div class="flex items-center justify-between py-2 gap-3">
                  <dt class="text-ink-muted-80">{page.labelRadius}</dt>
                  <dd id="cg-rad-mm" class="font-semibold text-ink">12.13 mm</dd>
                </div>
                <div class="flex items-center justify-between py-2 gap-3">
                  <dt class="text-ink-muted-80">{page.labelCircumference}</dt>
                  <dd id="cg-circ-mm" class="font-semibold text-ink">76.22 mm</dd>
                </div>
                <div class="flex items-center justify-between py-2 gap-3">
                  <dt class="text-ink-muted-80">{page.labelArea}</dt>
                  <dd id="cg-area-mm" class="font-semibold text-ink">462.2 mm²</dd>
                </div>
                <div class="flex items-center justify-between py-2 gap-3">
                  <dt class="text-ink-muted-80">{page.labelDiameterIn}</dt>
                  <dd id="cg-dia-in" class="font-semibold text-ink">0.955 in</dd>
                </div>
                <div class="flex items-center justify-between py-2 gap-3">
                  <dt class="text-ink-muted-80">{page.labelPixels}</dt>
                  <dd id="cg-px" class="font-semibold text-ink">92 px</dd>
                </div>
                <div class="flex items-center justify-between py-2 gap-3">
                  <dt class="text-ink-muted-80">{page.labelRingSize}</dt>
                  <dd id="cg-ring-match" class="font-semibold text-ink">—</dd>
                </div>
              </dl>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {page.guideCards.map((card) => (
            <article class="apple-utility-card">
              <p class="type-kicker">{card.kicker}</p>
              <h3 class="mt-1 type-body-strong text-ink">{card.heading}</h3>
              <p class="mt-2 type-caption text-ink-muted-80">{card.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <HelpModal locale={locale} />
  <Footer locale={locale} />
  <script src="../../scripts/app.ts"></script>
</BaseLayout>
