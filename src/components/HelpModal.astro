---
import { DEFAULT_LOCALE, type Locale } from '../i18n/config.ts';
import { getDict } from '../i18n/index.ts';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const hm = getDict(locale).helpModal;
---

<div
  id="help-shortcuts-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="help-modal-title"
  aria-hidden="true"
  class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 backdrop-blur-xs"
>
  <div class="apple-utility-card w-full max-w-lg">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="type-kicker">
          {hm.kicker}
        </p>
        <h2 id="help-modal-title" class="mt-1 type-tagline text-ink">
          {hm.title}
        </h2>
      </div>
      <button
        type="button"
        data-help-close
        aria-label={hm.closeAria}
        class="apple-btn-pearl font-mono text-xs"
      >
        {hm.escLabel}
      </button>
    </div>

    <div class="mt-4 divide-y divide-hairline border-t border-b border-hairline">
      {
        hm.shortcuts.map((s) => (
          <div class="flex items-center justify-between gap-3 py-2.5 type-caption">
            <span class="text-ink-muted-80">{s.action}</span>
            <kbd class="shrink-0 rounded-[5px] border border-hairline bg-canvas-parchment px-2 py-0.5 font-mono text-xs font-semibold text-ink">
              {s.key}
            </kbd>
          </div>
        ))
      }
    </div>

    <div class="mt-5 flex flex-wrap items-center justify-between gap-3 type-caption">
      <label class="inline-flex cursor-pointer items-center gap-2 text-ink">
        <input
          id="toggle-shortcuts-enabled"
          type="checkbox"
          checked
          class="h-4 w-4 rounded-[5px] accent-primary"
        />
        <span>{hm.enableShortcuts}</span>
      </label>
      <button
        type="button"
        data-help-close
        class="apple-btn-primary-compact"
      >
        {hm.gotIt}
      </button>
    </div>
  </div>
</div>
