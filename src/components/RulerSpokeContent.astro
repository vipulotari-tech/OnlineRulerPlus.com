---
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../i18n/config.ts';
import { getDict } from '../i18n/index.ts';
import DiagramFigure from './DiagramFigure.astro';
import MotionWalkthrough, { type WalkthroughSceneId } from './MotionWalkthrough.astro';
import { SPOKE_GUIDE_LINKS } from '../lib/blog.ts';

export interface SpokeCard {
  step: string;
  kicker: string;
  heading: string;
  body: string;
  linkHref: string;
  linkLabel: string;
}

export interface SpokeDarkCard {
  heading: string;
  body: string;
}

export interface SpokeTable {
  kicker: string;
  heading: string;
  headers: string[];
  rows: string[][];
  footnote: string;
}

export interface SpokeFaq {
  q: string;
  a: string;
}

interface Props {
  locale?: Locale;
  guideKicker: string;
  guideHeading: string;
  guideLead: string;
  cards: readonly SpokeCard[];
  darkKicker: string;
  darkHeading: string;
  darkLead: string;
  darkCards: readonly SpokeDarkCard[];
  table: {
    readonly kicker: string;
    readonly heading: string;
    readonly headers: readonly string[];
    readonly rows: readonly (readonly string[])[];
    readonly footnote: string;
  };
  faqKicker: string;
  faqHeading: string;
  faqs: readonly SpokeFaq[];
  pageKey?: 'cmRuler' | 'mmRuler' | 'inchRuler' | 'horizontalRuler' | 'verticalRuler' | 'photoRuler' | 'protractor';
}

const {
  locale = DEFAULT_LOCALE,
  pageKey,
  guideKicker,
  guideHeading,
  guideLead,
  cards,
  darkKicker,
  darkHeading,
  darkLead,
  darkCards,
  table,
  faqKicker,
  faqHeading,
  faqs,
} = Astro.props;

const dict = getDict(locale);
const shared = dict.spokeShared;
const v = dict.visuals;

const spokeVisualConfig: Record<
  NonNullable<Props['pageKey']>,
  {
    diagramPath: string;
    diagramMeta: typeof v.diagrams.d03;
    walkthroughScenes?: WalkthroughSceneId[];
    secondDiagramPath?: string;
    secondDiagramMeta?: typeof v.diagrams.d03;
    captureBase?: string;
    captureMeta?: typeof v.captures.photoMeasure;
  }
> = {
  cmRuler: {
    diagramPath: '/visuals/diagrams/03-cm-mm-inch-comparison.svg',
    diagramMeta: v.diagrams.d03,
    walkthroughScenes: ['ticks', 'line'],
  },
  mmRuler: {
    diagramPath: '/visuals/diagrams/03-cm-mm-inch-comparison.svg',
    diagramMeta: v.diagrams.d03,
    walkthroughScenes: ['ticks', 'calibration'],
  },
  inchRuler: {
    diagramPath: '/visuals/diagrams/04-inch-fractions.svg',
    diagramMeta: v.diagrams.d04,
    secondDiagramPath: '/visuals/diagrams/03-cm-mm-inch-comparison.svg',
    secondDiagramMeta: v.diagrams.d03,
  },
  horizontalRuler: {
    diagramPath: '/visuals/diagrams/06-xy-guides-crosshair.svg',
    diagramMeta: v.diagrams.d06,
    walkthroughScenes: ['line', 'drag'],
  },
  verticalRuler: {
    diagramPath: '/visuals/diagrams/06-xy-guides-crosshair.svg',
    diagramMeta: v.diagrams.d06,
    captureBase: '/visuals/captures/workspace-guides',
    captureMeta: v.captures.workspaceGuides,
  },
  photoRuler: {
    diagramPath: '/visuals/diagrams/05-photo-measurement.svg',
    diagramMeta: v.diagrams.d05,
    captureBase: '/visuals/captures/photo-measure',
    captureMeta: v.captures.photoMeasure,
  },
  protractor: {
    diagramPath: '/visuals/diagrams/07-protractor-angle-measurement.svg',
    diagramMeta: v.diagrams.d07,
    walkthroughScenes: ['protractor'],
  },
};

const activeVisual = pageKey ? spokeVisualConfig[pageKey] : null;
const spokeBlogLinks = locale === 'en' && pageKey ? (SPOKE_GUIDE_LINKS[pageKey] ?? []) : [];
---

<!-- SECTION 1: INTENT-SPECIFIC MEASUREMENT GUIDE (Light White Tile #ffffff) -->
<section
  id="how-it-works"
  aria-labelledby="spoke-guide-heading"
  class="apple-tile-light border-t border-hairline"
>
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="type-kicker">{guideKicker}</p>
        <h2 id="spoke-guide-heading" class="mt-1.5 type-display-lg text-ink">
          {guideHeading}
        </h2>
        <p class="mt-3 max-w-2xl type-body text-ink-muted-80">
          {guideLead}
        </p>
      </div>
      <div class="shrink-0">
        <a href={localizedPath(locale, '/how-to-use')} class="apple-btn-secondary-pill">
          {dict.home.howManualBtn}
        </a>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        cards.map((card) => (
          <article class="apple-utility-card flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-primary font-mono text-xs font-semibold text-on-primary">
                  {card.step}
                </span>
                <span class="type-kicker">{card.kicker}</span>
              </div>
              <h3 class="mt-4 type-tagline text-ink">{card.heading}</h3>
              <p class="mt-2.5 max-w-[65ch] type-body text-ink-muted-80">
                {card.body}
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-hairline">
              <a href={localizedPath(locale, card.linkHref)} class="type-caption font-semibold text-link hover:underline">
                {card.linkLabel} →
              </a>
            </div>
          </article>
        ))
      }
    </div>

    {activeVisual && (
      <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2 items-start">
        <DiagramFigure
          svgSrc={activeVisual.diagramPath}
          kicker={activeVisual.diagramMeta.kicker}
          title={activeVisual.diagramMeta.title}
          alt={activeVisual.diagramMeta.alt}
          caption={activeVisual.diagramMeta.caption}
        />
        {activeVisual.walkthroughScenes && (
          <MotionWalkthrough
            locale={locale}
            scenes={activeVisual.walkthroughScenes}
            compact
            id={`spoke-motion-${pageKey}`}
          />
        )}
        {activeVisual.secondDiagramPath && activeVisual.secondDiagramMeta && (
          <DiagramFigure
            svgSrc={activeVisual.secondDiagramPath}
            kicker={activeVisual.secondDiagramMeta.kicker}
            title={activeVisual.secondDiagramMeta.title}
            alt={activeVisual.secondDiagramMeta.alt}
            caption={activeVisual.secondDiagramMeta.caption}
          />
        )}
        {activeVisual.captureBase && activeVisual.captureMeta && (
          <DiagramFigure
            type="capture"
            srcBase={activeVisual.captureBase}
            width={1200}
            height={pageKey === 'photoRuler' ? 533 : 534}
            kicker={activeVisual.captureMeta.kicker}
            title={activeVisual.captureMeta.title}
            alt={activeVisual.captureMeta.alt}
            caption={activeVisual.captureMeta.caption}
          />
        )}
      </div>
    )}
  </div>
</section>

<!-- SECTION 2: CONVERSION & REFERENCE BENCHMARK TABLE (Dark Charcoal Tile #272729) -->
<section
  id="accuracy-guide"
  aria-labelledby="spoke-dark-heading"
  class="apple-tile-dark"
>
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="font-mono text-xs font-semibold text-primary-on-dark">
          {darkKicker}
        </p>
        <h2 id="spoke-dark-heading" class="mt-1.5 type-display-lg text-on-dark">
          {darkHeading}
        </h2>
        <p class="mt-3 max-w-2xl type-body text-body-muted">
          {darkLead}
        </p>
      </div>
      <div class="shrink-0">
        <a href={localizedPath(locale, '/calibration-guide')} class="apple-btn-primary">
          {shared.calibrationGuideBtn}
        </a>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-12">
      <div class="space-y-6 lg:col-span-5">
        {
          darkCards.map((dc) => (
            <div class="rounded-[18px] border border-white/12 bg-surface-tile-2 p-6">
              <h3 class="type-tagline text-on-dark">{dc.heading}</h3>
              <p class="mt-2.5 max-w-[65ch] type-caption text-body-muted">
                {dc.body}
              </p>
            </div>
          ))
        }
      </div>

      <div class="rounded-[18px] border border-white/12 bg-surface-tile-2 p-6 lg:col-span-7 flex flex-col justify-between">
        <div>
          <span class="font-mono text-xs font-semibold text-primary-on-dark">
            {table.kicker}
          </span>
          <h3 id="spoke-table-heading" class="mt-1 type-tagline text-on-dark">
            {table.heading}
          </h3>

          <div
            role="region"
            tabindex="0"
            aria-labelledby="spoke-table-heading"
            class="mt-5 overflow-x-auto focus-visible:rounded-[8px]"
          >
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-white/15 font-mono text-[11px] text-body-muted">
                  {
                    table.headers.map((h, idx) => (
                      <th
                        class:list={[
                          'py-2.5 font-semibold',
                          idx === 0 ? 'pr-3' : idx === table.headers.length - 1 ? 'pl-3' : 'px-3',
                        ]}
                      >
                        {h}
                      </th>
                    ))
                  }
                </tr>
              </thead>
              <tbody class="divide-y divide-white/10 font-mono text-xs">
                {
                  table.rows.map((row) => (
                    <tr>
                      {row.map((cell, idx) => (
                        <td
                          class:list={[
                            'py-2.5',
                            idx === 0
                              ? 'pr-3 font-sans font-medium text-on-dark'
                              : idx === 1
                                ? 'px-3 font-semibold text-primary-on-dark'
                                : idx === row.length - 1
                                  ? 'pl-3 text-body-muted'
                                  : 'px-3 text-on-dark',
                          ]}
                        >
                          {cell}
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <p class="mt-5 border-t border-white/12 pt-4 type-fine-print text-body-muted">
          {table.footnote}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 3: RELATED RULER MODES CROSS-NAVIGATION (Parchment Tile #f5f5f7) -->
<section
  id="ruler-modes"
  aria-labelledby="spoke-modes-heading"
  class="apple-tile-parchment border-t border-hairline"
>
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="type-kicker">{shared.modesKicker}</p>
        <h2 id="spoke-modes-heading" class="mt-1.5 type-display-lg text-ink">
          {shared.modesHeading}
        </h2>
      </div>
      <a href={localizedPath(locale, '/')} class="apple-btn-secondary-pill shrink-0">
        {shared.modesAllEdgeBtn}
      </a>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        shared.modeTiles.map((tile) => (
          <a href={localizedPath(locale, tile.href)} class="apple-utility-card hover:border-primary-focus transition-colors">
            <p class="type-kicker">{tile.kicker}</p>
            <h3 class="mt-1 type-body-strong text-ink">{tile.title}</h3>
            <p class="mt-1 type-fine-print text-ink-muted-80">{tile.desc}</p>
          </a>
        ))
      }
    </div>

    {spokeBlogLinks.length > 0 && (
      <div class="mt-6 rounded-[18px] border border-hairline bg-canvas p-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="type-kicker">Related Editorial Guides</p>
          <p class="mt-0.5 type-caption text-ink-muted-80">Deep-dive walkthroughs and conversion charts for this ruler mode.</p>
        </div>
        <div class="flex flex-wrap gap-2.5">
          {spokeBlogLinks.map((guide) => (
            <a href={guide.href} class="apple-btn-secondary-pill text-xs">
              {guide.label}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<!-- SECTION 4: PAGE-SPECIFIC FAQS (Light White Tile #ffffff) -->
<section
  id="faq"
  aria-labelledby="spoke-faq-heading"
  class="apple-tile-light border-t border-hairline"
>
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="type-kicker">{faqKicker}</p>
        <h2 id="spoke-faq-heading" class="mt-1.5 type-display-lg text-ink">
          {faqHeading}
        </h2>
      </div>
      <a href={localizedPath(locale, '/faq')} class="apple-btn-secondary-pill shrink-0">
        {shared.allFaqsBtn}
      </a>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 lg:grid-cols-2">
      {
        faqs.map((item) => (
          <details open class="group apple-utility-card">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-ink">
              <h3 class="type-body-strong text-ink">{item.q}</h3>
              <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-canvas-parchment font-mono text-base text-link group-open:rotate-45 transition-transform">
                +
              </span>
            </summary>
            <p class="mt-3 max-w-[65ch] type-caption text-ink-muted-80 border-t border-hairline pt-3">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
