---
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../i18n/config.ts';
import { getDict } from '../i18n/index.ts';
import { formatTemplate } from '../i18n/runtime.ts';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const dict = getDict(locale);
const f = dict.footer;
const year = new Date().getFullYear();
const copyrightLine = formatTemplate(f.copyright, { year });
---

<!-- Apple footer component: #f5f5f7 Parchment background, 56px-64px vertical padding, aligned to 1440px grid -->
<footer class="mt-auto bg-canvas-parchment py-[56px] sm:py-[64px] text-ink-muted-80">
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
    <p class="border-b border-hairline pb-5 type-fine-print text-ink-muted-48">
      {f.footnote}
    </p>

    <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-12">
      <!-- Brand Summary Column (4 cols) -->
      <div class="lg:col-span-4 pr-4">
        <a href={localizedPath(locale, '/')} class="inline-flex items-center gap-2 text-ink type-body-strong">
          <svg class="h-4 w-4 text-link shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="1.5" y="4.5" width="17" height="11" rx="2" stroke="currentColor" stroke-width="1.5" />
            <path d="M5 4.5V10M8.5 4.5V8M12 4.5V10.5M15.5 4.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span>Online Ruler Plus</span>
        </a>
        <p class="mt-2.5 max-w-xs type-caption text-ink-muted-80">
          {f.tagline}
        </p>
      </div>

      <div class="lg:col-span-2">
        <p class="type-caption-strong text-ink">
          {f.colModes}
        </p>
        <ul class="mt-2 sm:mt-3 space-y-1 sm:space-y-2.5 type-caption text-ink-muted-80">
          <li><a href={localizedPath(locale, '/')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.modeAllEdge}</a></li>
          <li><a href={localizedPath(locale, '/cm-ruler')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.modeCm}</a></li>
          <li><a href={localizedPath(locale, '/mm-ruler')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.modeMm}</a></li>
          <li><a href={localizedPath(locale, '/inch-ruler')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.modeInch}</a></li>
          <li><a href={localizedPath(locale, '/horizontal-ruler')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.modeHorizontal}</a></li>
          <li><a href={localizedPath(locale, '/vertical-ruler')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.modeVertical}</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <p class="type-caption-strong text-ink">
          {f.colGuides}
        </p>
        <ul class="mt-2 sm:mt-3 space-y-1 sm:space-y-2.5 type-caption text-ink-muted-80">
          <li><a href={localizedPath(locale, '/#calibration')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.guideCard}</a></li>
          <li><a href={localizedPath(locale, '/how-to-use')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.guideHowTo}</a></li>
          <li><a href={localizedPath(locale, '/calibration-guide')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.guidePpi}</a></li>
          <li><a href={localizedPath(locale, '/faq')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.guideFaq}</a></li>
          <li><a href="/blog" class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.guideBlog}</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <p class="type-caption-strong text-ink">
          {f.colTools}
        </p>
        <ul class="mt-2 sm:mt-3 space-y-1 sm:space-y-2.5 type-caption text-ink-muted-80">
          <li><a href={localizedPath(locale, '/photo-ruler')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.toolPhoto}</a></li>
          <li><a href={localizedPath(locale, '/protractor')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.toolProtractor}</a></li>
          <li><a href={localizedPath(locale, '/circle-ruler')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.toolCircle}</a></li>
          <li><a href={localizedPath(locale, '/quadrant')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.toolQuadrant}</a></li>
          <li><a href={localizedPath(locale, '/printable-ruler')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.toolPrintable}</a></li>
          <li><a href={localizedPath(locale, '/screen-size-detector')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.toolDetector}</a></li>
          <li><a href={localizedPath(locale, '/cm-ruler#ruler-tool')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.toolGuides}</a></li>
          <li><a href={localizedPath(locale, '/horizontal-ruler#ruler-tool')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.toolPx}</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <p class="type-caption-strong text-ink">
          {f.colLegal}
        </p>
        <ul class="mt-2 sm:mt-3 space-y-1 sm:space-y-2.5 type-caption text-ink-muted-80">
          <li><a href={localizedPath(locale, '/about')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.legalAbout}</a></li>
          <li><a href={localizedPath(locale, '/contact')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.legalContact}</a></li>
          <li><a href={localizedPath(locale, '/privacy')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.legalPrivacy}</a></li>
          <li><a href={localizedPath(locale, '/terms')} class="inline-flex min-h-[36px] sm:min-h-0 items-center py-0.5 hover:text-link hover:underline">{f.legalTerms}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-hairline pt-5 type-fine-print text-ink-muted-48 sm:flex-row sm:items-center">
      <p>{copyrightLine}</p>
      <p class="font-mono text-[11px]">
        {f.constants}
      </p>
    </div>
  </div>
</footer>
