---
interface Props {
  subNavTitle?: string;
  subNavCtaHref?: string;
  subNavCtaLabel?: string;
}

const {
  subNavTitle = 'Screen Ruler Workspace',
  subNavCtaHref = '/#calibration',
  subNavCtaLabel = 'Calibrate',
} = Astro.props;

const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { href: '/cm-ruler', label: 'cm Ruler' },
  { href: '/mm-ruler', label: 'mm Ruler' },
  { href: '/inch-ruler', label: 'Inch Ruler' },
  { href: '/horizontal-ruler', label: 'Horizontal' },
  { href: '/vertical-ruler', label: 'Vertical' },
  { href: '/how-to-use', label: 'How to Use' },
  { href: '/calibration-guide', label: 'Calibration Guide' },
  { href: '/faq', label: 'FAQ' },
];

const displaySubNavTitle =
  subNavTitle === 'Online Ruler Plus' && rawPath === '/'
    ? 'Screen Ruler Workspace'
    : subNavTitle;
---

<!-- Row 1: Apple global-nav (#000000 true black, 44px height, 12px/400/-0.12px links) -->
<header class="sticky top-0 z-40">
  <div class="h-[44px] w-full bg-surface-black text-on-dark">
    <div class="mx-auto flex h-full max-w-[1440px] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
      <!-- Brand Mark -->
      <a
        href="/"
        aria-current={rawPath === '/' ? 'page' : undefined}
        class="inline-flex h-[44px] shrink-0 items-center gap-2 whitespace-nowrap text-on-dark type-nav-link font-semibold focus-visible:rounded-[5px]"
        aria-label="Online Ruler Plus Home"
      >
        <svg class="h-4 w-4 text-primary-on-dark shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <rect x="1.5" y="4.5" width="17" height="11" rx="2" stroke="currentColor" stroke-width="1.5" />
          <path d="M5 4.5V10M8.5 4.5V8M12 4.5V10.5M15.5 4.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <span class="tracking-[-0.12px]">Online Ruler Plus</span>
      </a>

      <!-- Desktop Global Nav Links (visible >= 834px per DESIGN.md tablet-landscape breakpoint) -->
      <nav aria-label="Global" class="apple-nav-desktop items-center gap-0.5 xl:gap-1.5">
        {
          navItems.map((item) => {
            const isActive = rawPath === item.href;
            return (
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'inline-flex h-[44px] items-center whitespace-nowrap px-1.5 xl:px-2.5 type-nav-link transition-colors relative',
                  isActive
                    ? 'text-on-dark font-semibold after:absolute after:bottom-0 after:inset-x-1.5 xl:after:inset-x-2.5 after:h-[2px] after:rounded-full after:bg-primary-on-dark'
                    : 'text-body-muted hover:text-on-dark',
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Right Utility Cluster: Shortcuts (H), Theme (D), and Mobile Menu Trigger (<= 833px) -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-help-toggle
          aria-expanded="false"
          aria-controls="help-shortcuts-modal"
          class="inline-flex h-[32px] items-center gap-1.5 rounded-[8px] bg-[#1d1d1f] hover:bg-[#2a2a2c] px-2.5 sm:px-3 type-nav-link text-on-dark cursor-pointer"
          title="Keyboard shortcuts & instructions (H)"
        >
          <span>Shortcuts</span>
          <kbd class="hidden xs:inline rounded-[5px] bg-[#2a2a2c] px-1.5 py-0.5 font-mono text-[10px] text-body-muted">H</kbd>
        </button>

        <button
          type="button"
          data-theme-toggle
          aria-pressed="false"
          aria-label="Switch theme (D)"
          class="inline-flex h-[32px] items-center gap-1.5 rounded-[8px] bg-[#1d1d1f] hover:bg-[#2a2a2c] px-2.5 sm:px-3 type-nav-link text-on-dark cursor-pointer"
          title="Toggle dark mode (D)"
        >
          <svg class="h-3.5 w-3.5 dark:hidden" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="3.2" stroke="currentColor" stroke-width="1.4" />
            <path d="M8 1.5v1.8M8 12.7v1.8M1.5 8h1.8M12.7 8h1.8M3.4 3.4l1.3 1.3M11.3 11.3l1.3 1.3M12.6 3.4l-1.3 1.3M4.7 11.3l-1.3 1.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
          <svg class="hidden h-3.5 w-3.5 dark:inline" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13.2 9.8A5.5 5.5 0 0 1 6.2 2.8a5.5 5.5 0 1 0 7 7Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
          </svg>
          <span class="hidden sm:inline">Theme</span>
          <kbd class="hidden sm:inline rounded-[5px] bg-[#2a2a2c] px-1.5 py-0.5 font-mono text-[10px] text-body-muted">D</kbd>
        </button>

        <button
          type="button"
          data-mobile-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-nav-tray"
          aria-label="Toggle navigation menu"
          class="apple-nav-mobile h-[44px] w-[44px] items-center justify-center text-on-dark cursor-pointer"
        >
          <svg class="h-4 w-4" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M2 5.5h14M2 12.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Row 2: Apple sub-nav-frosted (52px height, Parchment 80% + backdrop blur, Tagline left, section jump links & primary pill CTA right) -->
  <div class="apple-subnav-frosted h-[48px] sm:h-[52px] w-full">
    <div class="mx-auto flex h-full max-w-[1440px] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 min-w-0">
        <a href={rawPath === '/' ? '#ruler-tool' : '/'} class="type-tagline text-[17px] sm:text-[21px] text-ink truncate">
          {displaySubNavTitle}
        </a>
        <span class="hidden xl:inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border border-hairline bg-canvas/80 px-2.5 py-0.5 font-mono text-[11px] text-ink-muted-80">
          <span class="h-1.5 w-1.5 rounded-full bg-link"></span>
          <span data-cal-ppi class="font-semibold text-ink">96.0 PPI</span>
          <span class="text-ink-muted-48">·</span>
          <span data-cal-status-label data-status="estimated">Estimated calibration</span>
        </span>
      </div>

      <div class="flex items-center gap-4 shrink-0">
        <div class="apple-nav-desktop items-center gap-5 type-button-utility text-ink-muted-80">
          <a href="/#ruler-tool" class="hover:text-link transition-colors py-1">Workspace</a>
          <a href="/#calibration" class="hover:text-link transition-colors py-1">Calibration</a>
          <a href="/#how-it-works" class="hover:text-link transition-colors py-1">How It Works</a>
          <a href="/#accuracy-guide" class="hover:text-link transition-colors py-1">PPI Table</a>
        </div>

        <a
          href={subNavCtaHref}
          data-open-calibration={subNavCtaHref.includes('#calibration') ? 'card' : undefined}
          class="apple-btn-primary-compact"
        >
          {subNavCtaLabel}
        </a>
      </div>
    </div>
  </div>

  <!-- Collapsible Mobile Navigation Tray (<= 833px) -->
  <div
    id="mobile-nav-tray"
    class="hidden border-b border-hairline bg-surface-black px-6 py-5 text-on-dark"
  >
    <nav aria-label="Mobile Navigation" class="grid grid-cols-2 gap-x-4 gap-y-1.5 type-caption">
      <a
        href="/"
        aria-current={rawPath === '/' ? 'page' : undefined}
        class:list={[
          'py-2 font-medium',
          rawPath === '/' ? 'text-primary-on-dark font-semibold' : 'text-on-dark hover:text-primary-on-dark',
        ]}
      >
        Home Workspace
      </a>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={rawPath === item.href ? 'page' : undefined}
            class:list={[
              'py-2',
              rawPath === item.href
                ? 'text-primary-on-dark font-semibold'
                : 'text-body-muted hover:text-on-dark',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/about" class="py-2 text-body-muted hover:text-on-dark">About</a>
      <a href="/contact" class="py-2 text-body-muted hover:text-on-dark">Contact</a>
      <a href="/privacy" class="py-2 text-body-muted hover:text-on-dark">Privacy Policy</a>
      <a href="/terms" class="py-2 text-body-muted hover:text-on-dark">Terms of Use</a>
    </nav>
  </div>
</header>
