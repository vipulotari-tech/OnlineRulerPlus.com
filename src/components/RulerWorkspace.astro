---
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../i18n/config.ts';
import { getDict, renderInlineMarkup } from '../i18n/index.ts';
import UnitConverterBar from './UnitConverterBar.astro';

interface Props {
  locale?: Locale;
  defaultUnit?: 'cm' | 'mm' | 'in' | 'px';
  forceUnit?: 'cm' | 'mm' | 'in' | 'px';
  forceEdges?: 'horizontal' | 'vertical' | 'all' | 'top-left';
  initialPhotoMode?: boolean;
  initialProtractor?: boolean;
  compactEmbed?: boolean;
}

const {
  locale = DEFAULT_LOCALE,
  defaultUnit = 'cm',
  forceUnit,
  forceEdges,
  initialPhotoMode = false,
  initialProtractor = false,
  compactEmbed = false,
} = Astro.props;

const dict = getDict(locale);
const w = dict.workspace;
const embedRoute = localizedPath(locale, '/embed');

const initUnit = forceUnit ?? defaultUnit;
const initEdges = {
  top: forceEdges !== 'vertical',
  bottom: forceEdges === 'horizontal' || forceEdges === 'all',
  left: forceEdges !== 'horizontal',
  right: forceEdges === 'vertical' || forceEdges === 'all',
};
const initThickness = 48;
const offTop = initEdges.top ? initThickness : 0;
const offBottom = initEdges.bottom ? initThickness : 0;
const offLeft = initEdges.left ? initThickness : 0;
const offRight = initEdges.right ? initThickness : 0;
---

<section
  id="ruler-tool"
  tabindex="-1"
  aria-labelledby="workspace-sr-heading"
  class="order-1 sm:order-2 mx-auto w-full max-w-[1440px] px-2 pt-2 pb-6 sm:px-6 sm:pt-1 sm:pb-10 lg:px-8 focus:outline-none"
>
  <h2 id="workspace-sr-heading" class="sr-only">
    {w.srHeading}
  </h2>

  <!-- Display / Zoom Warning Banner -->
  <div
    id="display-change-banner"
    role="status"
    aria-live="polite"
    data-tone="info"
    class="mb-3 hidden flex items-center justify-between gap-3 rounded-[14px] border border-hairline bg-canvas-parchment px-4 py-2.5 type-caption text-ink data-[tone=warning]:border-warning data-[tone=warning]:bg-warning-soft data-[tone=warning]:text-warning-deep"
  >
    <div class="flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-link shrink-0"></span>
      <span id="display-change-text" class="font-semibold"></span>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      <a
        href={compactEmbed ? localizedPath(locale, '/#calibration') : '#calibration'}
        target={compactEmbed ? '_blank' : undefined}
        rel={compactEmbed ? 'noopener noreferrer' : undefined}
        class="font-semibold text-link underline"
      >
        {w.verifyCalibrationLink}
      </a>
      <button
        id="btn-dismiss-banner"
        type="button"
        aria-label={w.dismissAria}
        class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-surface-pearl text-ink cursor-pointer"
      >
        ×
      </button>
    </div>
  </div>

  <!-- Workspace Control Bar (Grouped Segmented Instrument Pods) -->
  <div class="rounded-t-[18px] border border-b-0 border-hairline bg-canvas-parchment px-2 py-1.5 sm:px-3 sm:py-1.5">
    <div class="flex flex-nowrap sm:flex-wrap items-center justify-start sm:justify-between gap-1 sm:gap-1.5 overflow-x-auto sm:overflow-visible pb-0.5 sm:pb-0">
      <!-- Pod 1: Unit Selector -->
      <div class="apple-segmented-pod flex-nowrap! shrink-0 sm:shrink sm:max-w-full sm:flex-wrap!" role="group" aria-label={w.unitGroupAria}>
        <span class="hidden 2xl:inline px-1.5 font-mono text-[11px] font-semibold text-ink-muted-48">{w.unitLabel}</span>
        <button
          type="button"
          data-unit-btn="cm"
          aria-pressed="true"
          data-active="true"
          class="apple-option-chip"
          title={w.unitCmTitle}
        >
          cm
        </button>
        <button
          type="button"
          data-unit-btn="mm"
          aria-pressed="false"
          data-active="false"
          class="apple-option-chip"
          title={w.unitMmTitle}
        >
          mm
        </button>
        <button
          type="button"
          data-unit-btn="in"
          aria-pressed="false"
          data-active="false"
          class="apple-option-chip"
          title={w.unitInTitle}
        >
          in
        </button>
        <button
          type="button"
          data-unit-btn="px"
          aria-pressed="false"
          data-active="false"
          class="apple-option-chip"
          title={w.unitPxTitle}
        >
          px
        </button>
        <button
          id="btn-dual-unit"
          type="button"
          aria-pressed="false"
          data-active="false"
          class="apple-option-chip"
          title={w.dualUnitTitle}
        >
          {w.dualUnit}
        </button>
        <button
          id="btn-dual-cm-px"
          type="button"
          data-dual-preset="cm-px"
          aria-pressed="false"
          data-active="false"
          class="apple-option-chip font-mono"
          title={w.dualCmPxTitle ?? 'Dual cm + px scale'}
        >
          cm+px
        </button>
        <button
          id="btn-dual-in-px"
          type="button"
          data-dual-preset="in-px"
          aria-pressed="false"
          data-active="false"
          class="apple-option-chip font-mono"
          title={w.dualInPxTitle ?? 'Dual inch + px scale'}
        >
          in+px
        </button>
        <span
          id="inch-divisor-group"
          role="group"
          aria-label={w.inchPrecisionAria ?? 'Inch fraction precision'}
          class:list={[
            'items-center gap-0.5 pl-1 border-l border-hairline',
            initUnit === 'in' ? 'inline-flex' : 'hidden',
          ]}
        >
          <button type="button" data-inch-divisor="8" data-active="false" aria-pressed="false" class="apple-option-chip font-mono text-[11px] px-2">1/8</button>
          <button type="button" data-inch-divisor="16" data-active="true" aria-pressed="true" class="apple-option-chip font-mono text-[11px] px-2">1/16</button>
          <button type="button" data-inch-divisor="32" data-active="false" aria-pressed="false" class="apple-option-chip font-mono text-[11px] px-2">1/32</button>
        </span>
      </div>

      <!-- Pod 2: Edge Selector -->
      <div class="apple-segmented-pod flex-nowrap! shrink-0 sm:shrink sm:max-w-full sm:flex-wrap!" role="group" aria-label={w.edgesGroupAria}>
        <span class="hidden 2xl:inline px-1.5 font-mono text-[11px] font-semibold text-ink-muted-48">{w.edgesLabel}</span>
        <button
          type="button"
          data-edge-btn="top"
          aria-pressed="true"
          data-active="true"
          class="apple-option-chip"
        >
          {w.edgeTop}
        </button>
        <button
          type="button"
          data-edge-btn="bottom"
          aria-pressed="false"
          data-active="false"
          class="apple-option-chip"
        >
          {w.edgeBottom}
        </button>
        <button
          type="button"
          data-edge-btn="left"
          aria-pressed="true"
          data-active="true"
          class="apple-option-chip"
        >
          {w.edgeLeft}
        </button>
        <button
          type="button"
          data-edge-btn="right"
          aria-pressed="false"
          data-active="false"
          class="apple-option-chip"
        >
          {w.edgeRight}
        </button>
        <button
          type="button"
          data-edge-btn="all"
          aria-pressed="false"
          data-active="false"
          class="apple-option-chip"
        >
          {w.edgeAll}
        </button>
      </div>

      <!-- Pod 3: Precision Overlay Tools -->
      <div class="apple-segmented-pod flex-nowrap! shrink-0 sm:shrink sm:max-w-full sm:flex-wrap!" role="group" aria-label={w.toolsGroupAria}>
        <button
          id="btn-toggle-guides"
          type="button"
          aria-pressed="true"
          data-active="true"
          class="apple-option-chip"
          title={w.guidesTitle}
        >
          <span>{w.guides}</span>
          <kbd class="hidden xl:inline font-mono text-[10px] text-ink-muted-48">G</kbd>
        </button>
        <button
          id="btn-toggle-crosshair"
          type="button"
          aria-pressed="false"
          data-active="false"
          class="apple-option-chip"
          title={w.crosshairTitle}
        >
          <span>{w.crosshair}</span>
          <kbd class="hidden xl:inline font-mono text-[10px] text-ink-muted-48">C</kbd>
        </button>
        <button
          id="btn-add-floating-ruler"
          type="button"
          class="apple-btn-pearl"
          title={w.addFloatingTitle}
        >
          {w.addFloating}
        </button>
        <button
          id="btn-toggle-protractor"
          type="button"
          aria-pressed="false"
          data-active="false"
          class="apple-option-chip"
          title={w.protractorTitle}
        >
          <span>{w.protractor}</span>
          <kbd class="hidden xl:inline font-mono text-[10px] text-ink-muted-48">P</kbd>
        </button>
        <button
          id="btn-photo-mode"
          type="button"
          aria-pressed="false"
          data-active="false"
          class="apple-option-chip"
          title={w.photoModeTitle ?? 'Measure any photo or pasted Ctrl+V screenshot offline'}
        >
          <span>{w.photoMode ?? 'Photo / Ctrl+V'}</span>
        </button>
        <button
          id="btn-focus-mode"
          type="button"
          aria-pressed="false"
          data-active="false"
          data-label-enter={w.focusMode}
          data-label-exit={w.focusModeExit}
          class="hidden sm:inline-flex apple-option-chip"
          title={w.focusModeTitle}
        >
          <span>{w.focusMode}</span>
        </button>
        <button
          id="btn-fullscreen"
          type="button"
          aria-pressed="false"
          data-label-enter={w.fullscreen}
          data-label-exit={w.fullscreenExit}
          class="apple-btn-pearl"
          title={w.fullscreenTitle}
        >
          <span>{w.fullscreen}</span>
          <kbd class="hidden xl:inline font-mono text-[10px] text-ink-muted-48">F</kbd>
        </button>
        {!compactEmbed && (
          <>
            <button
              id="btn-popout-ruler"
              type="button"
              data-embed-href={embedRoute}
              class="hidden md:inline-flex apple-btn-pearl font-mono text-xs"
              title={w.popoutTitle ?? 'Open compact pop-out ruler window'}
            >
              {w.popoutBtn ?? 'Pop-Out'}
            </button>
            <button
              id="btn-embed-code"
              type="button"
              data-embed-href={embedRoute}
              aria-expanded="false"
              aria-controls="embed-snippet-popover"
              class="hidden md:inline-flex apple-btn-pearl font-mono text-xs"
              title={w.embedTitle ?? 'Get iframe embed code'}
            >
              {w.embedBtn ?? 'Embed'}
            </button>
          </>
        )}
        <button
          id="btn-clear-guides"
          type="button"
          class="hidden apple-btn-pearl text-error border-error"
          title={w.clearGuidesTitle}
        >
          {w.clearGuides}
        </button>
      </div>
    </div>

    <!-- Secondary Row: Calibration Telemetry, Guide Axis, Thickness & Opacity -->
    <div class="mt-1 sm:mt-1.5 flex flex-nowrap sm:flex-wrap items-center justify-between gap-1.5 border-t border-hairline pt-1 sm:pt-1.5 type-caption overflow-x-auto sm:overflow-visible">
      <div class="flex flex-nowrap sm:flex-wrap items-center gap-1.5 shrink-0 sm:shrink sm:max-w-full">
        <span
          data-cal-status-label
          data-status="estimated"
          class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border border-hairline bg-canvas px-2.5 py-0.5 font-mono text-[11px] font-semibold text-ink data-[status=manual]:border-primary-focus data-[status=manual]:text-link"
        >
          {w.calDefaultStatus}
        </span>
        <span class="font-mono text-xs text-ink-muted-80 whitespace-nowrap">
          <strong data-cal-ppi class="font-semibold text-ink">96.0 PPI</strong>
          <span class="hidden sm:inline mx-1 text-ink-muted-48">·</span>
          <span data-cal-device-label class="hidden sm:inline text-ink-muted-48">{w.calDefaultDevice}</span>
        </span>
        <a
          href={compactEmbed ? localizedPath(locale, '/#calibration') : '#calibration'}
          target={compactEmbed ? '_blank' : undefined}
          rel={compactEmbed ? 'noopener noreferrer' : undefined}
          data-open-calibration="card"
          class="inline-flex items-center gap-1 whitespace-nowrap rounded-full border border-primary/30 bg-link-soft px-2.5 py-0.5 font-mono text-[11px] font-semibold text-link hover:border-primary-focus transition-colors"
        >
          <span>{w.calibrateBtn}</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="flex flex-nowrap sm:flex-wrap items-center gap-1.5 sm:gap-2 text-ink-muted-80 shrink-0 sm:shrink sm:max-w-full">
        <!-- Guide placement axis -->
        <div class="flex flex-wrap items-center gap-1" role="group" aria-label={w.guideAxisAria}>
          <span class="font-mono text-[11px] text-ink-muted-48">{w.guideAxisLabel}</span>
          <button
            type="button"
            data-guide-axis-btn="x"
            aria-pressed="true"
            data-active="true"
            class="rounded-full border border-hairline bg-canvas px-2.5 py-0.5 font-mono text-[11px] text-ink cursor-pointer data-[active=true]:border-primary-focus data-[active=true]:bg-link-soft data-[active=true]:text-link data-[active=true]:font-semibold"
          >
            {w.axisVertical}
          </button>
          <button
            type="button"
            data-guide-axis-btn="y"
            aria-pressed="false"
            data-active="false"
            class="rounded-full border border-hairline bg-canvas px-2.5 py-0.5 font-mono text-[11px] text-ink cursor-pointer data-[active=true]:border-primary-focus data-[active=true]:bg-link-soft data-[active=true]:text-link data-[active=true]:font-semibold"
          >
            {w.axisHorizontal}
          </button>
          <button
            type="button"
            data-guide-axis-btn="both"
            aria-pressed="false"
            data-active="false"
            class="rounded-full border border-hairline bg-canvas px-2.5 py-0.5 font-mono text-[11px] text-ink cursor-pointer data-[active=true]:border-primary-focus data-[active=true]:bg-link-soft data-[active=true]:text-link data-[active=true]:font-semibold"
          >
            {w.axisBoth}
          </button>
        </div>

        <!-- Architectural & Engineering Scale Selector (P3) -->
        <label class="flex items-center gap-1.5 font-mono text-[11px]">
          <span class="text-ink-muted-48">{w.scaleLabel ?? 'Scale'}</span>
          <select
            id="select-arch-scale"
            aria-label={w.scaleAria ?? 'Architectural and engineering drawing scale'}
            class="rounded-[8px] border border-hairline bg-canvas px-2 py-0.5 font-mono text-[11px] text-ink cursor-pointer"
          >
            <option value="1:1" selected>1:1 (Actual)</option>
            <option value="1:10">1:10</option>
            <option value="1:20">1:20</option>
            <option value="1:48">1/4″ = 1′ (1:48)</option>
            <option value="1:50">1:50</option>
            <option value="1:100">1:100</option>
          </select>
        </label>

        <span
          id="scale-active-badge"
          class="hidden items-center gap-1.5 rounded-full border border-warning bg-warning-soft px-2.5 py-0.5 font-mono text-[11px] font-semibold text-warning-deep whitespace-nowrap"
        >
          <span id="scale-active-text">1:50 ACTIVE</span>
          <button
            id="btn-reset-scale"
            type="button"
            class="underline hover:no-underline cursor-pointer"
          >
            1:1
          </button>
        </span>

        <!-- Ruler thickness -->
        <label class="flex items-center gap-1.5 font-mono text-[11px]">
          <span class="text-ink-muted-48">{w.thicknessLabel}</span>
          <select
            id="select-thickness"
            aria-label={w.thicknessAria}
            class="rounded-[8px] border border-hairline bg-canvas px-2 py-0.5 font-mono text-[11px] text-ink cursor-pointer"
          >
            <option value="36">36px</option>
            <option value="48" selected>48px</option>
            <option value="64">64px</option>
          </select>
        </label>

        <!-- Ruler opacity -->
        <label class="hidden sm:flex items-center gap-1.5 font-mono text-[11px]">
          <span class="text-ink-muted-48">{w.opacityLabel}</span>
          <input
            id="slider-opacity"
            type="range"
            min="40"
            max="100"
            value="96"
            aria-label={w.opacityAria}
            class="w-16 accent-primary cursor-pointer"
          />
          <span id="label-opacity" class="w-8 text-right font-semibold text-ink">96%</span>
        </label>
      </div>
    </div>
  </div>

  <!-- Embed Iframe Code Generator Drawer (P2.3) -->
  {!compactEmbed && (
    <div
      id="embed-snippet-popover"
      class="hidden border border-b-0 border-hairline bg-canvas px-4 py-3"
    >
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
        <span class="font-mono text-xs font-semibold text-ink">
          {w.embedHeading ?? 'Embed Ad-Free Online Ruler (<iframe>)'}
        </span>
        <div class="flex items-center gap-2">
          <button
            id="btn-copy-embed"
            type="button"
            data-copied-label={w.embedCopied ?? 'Copied!'}
            class="apple-btn-primary h-[30px] px-3 text-xs"
          >
            {w.embedCopyBtn ?? 'Copy Code'}
          </button>
          <button
            id="btn-close-embed"
            type="button"
            aria-label={w.dismissAria}
            class="apple-btn-pearl h-[30px] px-2.5 text-xs"
          >
            ×
          </button>
        </div>
      </div>
      <textarea
        id="embed-snippet-textarea"
        readonly
        rows="2"
        aria-label={w.embedHeading ?? 'Embed HTML code'}
        class="w-full rounded-[10px] border border-hairline bg-canvas-parchment px-3 py-2 font-mono text-xs text-ink"
      ></textarea>
    </div>
  )}

  <!-- Main Ruler Surface Container -->
  <div
    id="ruler-workspace"
    data-default-unit={defaultUnit}
    data-force-unit={forceUnit}
    data-force-edges={forceEdges}
    data-init-photo={initialPhotoMode ? 'true' : undefined}
    data-init-protractor={initialProtractor ? 'true' : undefined}
    data-unit={defaultUnit}
    class:list={[
      'relative w-full overflow-hidden rounded-b-[18px] border border-hairline bg-canvas select-none',
      compactEmbed ? 'h-[340px] sm:h-[380px]' : 'h-[380px] sm:h-[520px] lg:h-[540px]',
    ]}
  >
    <!-- 4 Corner Origin Cells -->
    <div
      id="corner-top-left"
      style={`width: ${initThickness}px; height: ${initThickness}px;`}
      class:list={[
        'absolute left-0 top-0 z-20 flex items-center justify-center border-r border-b border-hairline bg-canvas-parchment font-mono text-[11px] font-semibold uppercase text-ink-muted-80',
        !(initEdges.top && initEdges.left) && 'hidden',
      ]}
    >
      {initUnit}
    </div>
    <div
      id="corner-top-right"
      style={`width: ${initThickness}px; height: ${initThickness}px;`}
      class:list={[
        'absolute right-0 top-0 z-20 border-l border-b border-hairline bg-canvas-parchment',
        !(initEdges.top && initEdges.right) && 'hidden',
      ]}
    ></div>
    <div
      id="corner-bottom-left"
      style={`width: ${initThickness}px; height: ${initThickness}px;`}
      class:list={[
        'absolute left-0 bottom-0 z-20 border-r border-t border-hairline bg-canvas-parchment',
        !(initEdges.bottom && initEdges.left) && 'hidden',
      ]}
    ></div>
    <div
      id="corner-bottom-right"
      style={`width: ${initThickness}px; height: ${initThickness}px;`}
      class:list={[
        'absolute right-0 bottom-0 z-20 border-l border-t border-hairline bg-canvas-parchment',
        !(initEdges.bottom && initEdges.right) && 'hidden',
      ]}
    ></div>

    <!-- 4 Calibrated Edge Ruler Canvases -->
    <canvas
      id="ruler-canvas-top"
      data-edge="top"
      aria-label={w.canvasTopAria}
      style={`left: ${offLeft}px; top: 0px; width: calc(100% - ${offLeft + offRight}px); height: ${initThickness}px;`}
      class:list={[
        'absolute z-10 border-b border-hairline cursor-crosshair',
        !initEdges.top && 'hidden',
      ]}
    ></canvas>
    <canvas
      id="ruler-canvas-bottom"
      data-edge="bottom"
      aria-label={w.canvasBottomAria}
      style={`left: ${offLeft}px; bottom: 0px; width: calc(100% - ${offLeft + offRight}px); height: ${initThickness}px;`}
      class:list={[
        'absolute z-10 border-t border-hairline cursor-crosshair',
        !initEdges.bottom && 'hidden',
      ]}
    ></canvas>
    <canvas
      id="ruler-canvas-left"
      data-edge="left"
      aria-label={w.canvasLeftAria}
      style={`left: 0px; top: ${offTop}px; width: ${initThickness}px; height: calc(100% - ${offTop + offBottom}px);`}
      class:list={[
        'absolute z-10 border-r border-hairline cursor-crosshair',
        !initEdges.left && 'hidden',
      ]}
    ></canvas>
    <canvas
      id="ruler-canvas-right"
      data-edge="right"
      aria-label={w.canvasRightAria}
      style={`right: 0px; top: ${offTop}px; width: ${initThickness}px; height: calc(100% - ${offTop + offBottom}px);`}
      class:list={[
        'absolute z-10 border-l border-hairline cursor-crosshair',
        !initEdges.right && 'hidden',
      ]}
    ></canvas>

    <!-- Inner Measurement Stage -->
    <div
      id="ruler-stage"
      style={`top: ${offTop}px; right: ${offRight}px; bottom: ${offBottom}px; left: ${offLeft}px;`}
      class="workspace-grid-bg absolute overflow-hidden cursor-crosshair"
    >
      <!-- Zero Origin Datum Hairlines (16px inset matching ruler 0 ticks) -->
      <div
        class="pointer-events-none absolute top-0 bottom-0 left-[16px] border-l border-dashed border-ink/25"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute left-0 right-0 top-[16px] border-t border-dashed border-ink/25"
        aria-hidden="true"
      ></div>

      <!-- Placed Guide Lines Layer -->
      <div id="guides-layer" class="absolute inset-0 pointer-events-none"></div>

      <!-- Draggable Floating Rulers Layer -->
      <div id="floating-rulers-layer" class="absolute inset-0 pointer-events-none"></div>

      <!-- Optional 180°/360° Protractor Layer (backdrop click-through; widget itself receives pointer events) -->
      <div id="protractor-layer" class="hidden absolute inset-0 pointer-events-none"></div>

      <!-- Cursor-Following Crosshair -->
      <div
        id="crosshair-x"
        class="pointer-events-none hidden absolute top-0 bottom-0 w-px bg-link/75 z-20"
      ></div>
      <div
        id="crosshair-y"
        class="pointer-events-none hidden absolute left-0 right-0 h-px bg-link/75 z-20"
      ></div>
      <div
        id="crosshair-badge"
        class="pointer-events-none hidden absolute z-30 rounded-full bg-primary px-2.5 py-0.5 font-mono text-[11px] font-semibold text-on-primary whitespace-nowrap"
      ></div>

      <!-- Center Instrument Datum Callout (automatically fades when overlays/guides are placed) -->
      <div
        id="stage-datum-hint"
        class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center p-4 text-center transition-opacity duration-200"
      >
        <div class="max-w-sm rounded-[14px] border border-hairline bg-canvas-parchment/90 backdrop-blur-xs px-4 py-3">
          <p class="font-mono text-[11px] font-semibold text-link">
            {w.datumTitle}
          </p>
          <p
            class="mt-1 type-fine-print text-ink-muted-80"
            set:html={renderInlineMarkup(w.datumBody, locale)}
          />
        </div>
      </div>

      <!-- Bottom Floating Sticky Readout Bar (Apple floating-sticky-bar grammar) -->
      <div
        data-stage-interactive
        class="apple-subnav-frosted absolute bottom-3 left-3 right-3 z-30 flex flex-wrap items-center justify-between gap-2 rounded-full border border-hairline px-4 py-2 type-caption"
      >
        <div class="flex items-center gap-3 min-w-0">
          <span class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-ink truncate">
            <span class="h-2 w-2 rounded-full bg-link shrink-0"></span>
            <span id="live-cursor-readout">{w.liveCursorInit}</span>
          </span>

          <div id="guide-span-readout" class="hidden flex items-center gap-2 border-l border-hairline pl-3 shrink-0">
            <span id="guide-span-value" class="font-mono text-xs font-semibold text-link"></span>
            <button
              id="btn-save-span"
              type="button"
              class="rounded-full bg-primary px-3 py-0.5 font-sans text-xs text-on-primary cursor-pointer"
            >
              {w.saveToHistory}
            </button>
          </div>
        </div>

        <div class="hidden md:flex items-center gap-2 font-mono text-[11px] text-ink-muted-48 shrink-0">
          <span set:html={renderInlineMarkup(w.keysHint, locale)} />
        </div>
      </div>
    </div>

    <!-- Client-Side Photo & Clipboard (Ctrl+V) Measurement Studio Overlay -->
    <div
      id="photo-measure-panel"
      role="region"
      aria-label={w.photoPanelAria ?? 'Client-side photo and clipboard measurement tool'}
      class="hidden absolute inset-0 z-40 flex flex-col bg-canvas"
    >
      <div class="flex flex-nowrap sm:flex-wrap items-center justify-between gap-1.5 sm:gap-2 border-b border-hairline bg-canvas-parchment px-2 py-1.5 sm:px-3 sm:py-2 overflow-x-auto sm:overflow-visible shrink-0 sm:shrink sm:max-w-full">
        <div class="flex flex-nowrap sm:flex-wrap items-center gap-1.5 shrink-0 sm:shrink sm:max-w-full">
          <input
            id="photo-file-input"
            type="file"
            accept="image/*"
            aria-label={w.photoChooseBtn}
            class="sr-only"
          />
          <button id="btn-photo-choose" type="button" class="apple-btn-pearl font-mono text-xs">
            {w.photoChooseBtn ?? 'Upload Photo'}
          </button>
          <button id="btn-photo-paste" type="button" class="apple-btn-pearl font-mono text-xs">
            {w.photoPasteBtn ?? 'Paste (Ctrl+V)'}
          </button>

          <span class="mx-1 h-4 w-px bg-hairline hidden sm:inline-block" aria-hidden="true"></span>

          <button
            type="button"
            data-photo-tool="calibrate"
            data-active="true"
            aria-pressed="true"
            class="apple-option-chip font-mono text-xs"
          >
            {w.photoToolCal ?? '1. Calibrate 2-pt'}
          </button>
          <button
            type="button"
            data-photo-tool="line"
            data-active="false"
            aria-pressed="false"
            class="apple-option-chip font-mono text-xs"
          >
            {w.photoToolLine ?? '2. Line'}
          </button>
          <button
            type="button"
            data-photo-tool="rect"
            data-active="false"
            aria-pressed="false"
            class="apple-option-chip font-mono text-xs"
          >
            {w.photoToolRect ?? '3. ΔX / ΔY Box'}
          </button>
        </div>

        <div class="flex flex-nowrap sm:flex-wrap items-center gap-1.5 shrink-0 sm:shrink sm:max-w-full">
          <label class="inline-flex items-center gap-1 font-mono text-xs text-ink">
            <span class="sr-only">{w.photoRefLenAria ?? 'Known reference length'}</span>
            <input
              id="photo-cal-length"
              type="number"
              min="0.1"
              max="100000"
              step="0.1"
              value="85.6"
              class="h-[32px] w-20 rounded-full border border-hairline bg-canvas px-2.5 text-center font-mono text-xs font-semibold text-ink"
            />
          </label>
          <select
            id="photo-cal-unit"
            aria-label={w.photoRefUnitAria ?? 'Reference unit'}
            class="h-[32px] rounded-full border border-hairline bg-canvas px-2 font-mono text-xs text-ink cursor-pointer"
          >
            <option value="mm" selected>mm</option>
            <option value="cm">cm</option>
            <option value="in">in</option>
          </select>
          <button id="btn-photo-apply-cal" type="button" class="apple-btn-primary h-[32px] px-3 text-xs">
            {w.photoApplyCalBtn ?? 'Apply Scale'}
          </button>
          <button id="btn-photo-card-preset" type="button" class="apple-btn-pearl font-mono text-xs" title="ISO ID-1 Card (85.6 mm)">
            ID-1
          </button>
          <button id="btn-photo-zoom-in" type="button" class="apple-btn-pearl font-mono text-xs px-2" aria-label="Zoom in photo">+</button>
          <button id="btn-photo-zoom-out" type="button" class="apple-btn-pearl font-mono text-xs px-2" aria-label="Zoom out photo">−</button>
          <button id="btn-photo-zoom-fit" type="button" class="apple-btn-pearl font-mono text-xs px-2">Fit</button>
          <button id="btn-photo-undo" type="button" class="apple-btn-pearl font-mono text-xs">{w.photoUndoBtn ?? 'Undo'}</button>
          <button id="btn-photo-clear" type="button" class="apple-btn-pearl font-mono text-xs">{w.photoClearBtn ?? 'Clear'}</button>
          <button id="btn-photo-export" type="button" disabled class="apple-btn-pearl font-mono text-xs text-link border-primary/30 disabled:opacity-40">
            {w.photoExportBtn ?? 'Export PNG'}
          </button>
          <button id="btn-photo-close" type="button" class="apple-btn-pearl font-mono text-xs">
            {w.photoCloseBtn ?? 'Exit'}
          </button>
        </div>
      </div>

      <div class="workspace-grid-bg relative flex-1 min-h-0 overflow-hidden">
        <canvas id="photo-measure-canvas" class="block h-full w-full cursor-crosshair touch-none"></canvas>
        <div
          id="photo-empty-state"
          class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center p-6 text-center"
        >
          <div class="max-w-md rounded-[16px] border border-dashed border-primary-focus/50 bg-canvas-parchment/95 px-6 py-5">
            <p class="font-mono text-xs font-semibold text-link">{w.photoEmptyTitle ?? '100% Client-Side Photo & Clipboard Ruler'}</p>
            <p class="mt-1.5 type-caption text-ink-muted-80">
              {w.photoEmptyDesc ?? 'Press Ctrl+V to paste a screenshot, drop an image here, or choose a file. Nothing is ever uploaded.'}
            </p>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-2 border-t border-hairline bg-canvas-parchment px-3 py-1.5 font-mono text-[11px]">
        <span id="photo-measure-readout" class="font-semibold text-ink truncate"></span>
        <span id="photo-cal-status" class="text-ink-muted-80 truncate"></span>
      </div>
    </div>
  </div>

  {!compactEmbed && <UnitConverterBar locale={locale} />}
</section>
