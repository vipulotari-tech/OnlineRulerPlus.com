---
import type { Locale } from '../i18n/config.ts';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 18 12"
  width="18"
  height="12"
  aria-hidden="true"
  class={`rounded-[2.5px] ring-1 shrink-0 ${className || 'ring-black/12 dark:ring-white/15'}`}
>
  {locale === 'en' && (
    <>
      <rect width="18" height="12" fill="#B22234" />
      <path d="M0 1.38h18M0 3.23h18M0 5.08h18M0 6.92h18M0 8.77h18M0 10.62h18" stroke="#FFFFFF" stroke-width="0.92" />
      <rect width="7.8" height="6.46" fill="#3C3B6E" />
      <circle cx="1.6" cy="1.5" r="0.45" fill="#FFFFFF" />
      <circle cx="3.9" cy="1.5" r="0.45" fill="#FFFFFF" />
      <circle cx="6.2" cy="1.5" r="0.45" fill="#FFFFFF" />
      <circle cx="2.75" cy="3.2" r="0.45" fill="#FFFFFF" />
      <circle cx="5.05" cy="3.2" r="0.45" fill="#FFFFFF" />
      <circle cx="1.6" cy="4.9" r="0.45" fill="#FFFFFF" />
      <circle cx="3.9" cy="4.9" r="0.45" fill="#FFFFFF" />
      <circle cx="6.2" cy="4.9" r="0.45" fill="#FFFFFF" />
    </>
  )}
  {locale === 'es' && (
    <>
      <rect width="18" height="12" fill="#AA151B" />
      <rect y="3" width="18" height="6" fill="#F1BF00" />
      <rect x="4" y="4.3" width="2.2" height="3.4" rx="0.5" fill="#AA151B" />
    </>
  )}
  {locale === 'fr' && (
    <>
      <rect width="6" height="12" fill="#0055A4" />
      <rect x="6" width="6" height="12" fill="#FFFFFF" />
      <rect x="12" width="6" height="12" fill="#EF4135" />
    </>
  )}
  {locale === 'de' && (
    <>
      <rect width="18" height="4" fill="#111111" />
      <rect y="4" width="18" height="4" fill="#DD0000" />
      <rect y="8" width="18" height="4" fill="#FFCE00" />
    </>
  )}
  {locale === 'it' && (
    <>
      <rect width="6" height="12" fill="#009246" />
      <rect x="6" width="6" height="12" fill="#FFFFFF" />
      <rect x="12" width="6" height="12" fill="#CE2B37" />
    </>
  )}
  {locale === 'pt' && (
    <>
      <rect width="7.2" height="12" fill="#006600" />
      <rect x="7.2" width="10.8" height="12" fill="#FF0000" />
      <circle cx="7.2" cy="6" r="2.2" fill="#FFCC00" />
      <rect x="6.4" y="5.1" width="1.6" height="1.8" rx="0.4" fill="#FFFFFF" />
    </>
  )}
  {locale === 'ja' && (
    <>
      <rect width="18" height="12" fill="#FFFFFF" />
      <circle cx="9" cy="6" r="3.4" fill="#BC002D" />
    </>
  )}
  {locale === 'ko' && (
    <>
      <rect width="18" height="12" fill="#FFFFFF" />
      <circle cx="9" cy="6" r="3" fill="#CD2E3A" />
      <path d="M6 6a3 3 0 0 0 6 0 1.5 1.5 0 0 1-3 0 1.5 1.5 0 0 0-3 0z" fill="#0047A0" />
      <path d="M3 2.5l1.6-1M3.6 3.3l1.6-1M13.4 9.5l1.6-1M14 10.3l1.6-1" stroke="#111111" stroke-width="0.7" />
    </>
  )}
  {locale === 'nl' && (
    <>
      <rect width="18" height="4" fill="#AE1C28" />
      <rect y="4" width="18" height="4" fill="#FFFFFF" />
      <rect y="8" width="18" height="4" fill="#21468B" />
    </>
  )}
  {locale === 'tr' && (
    <>
      <rect width="18" height="12" fill="#E30A17" />
      <circle cx="7.3" cy="6" r="3" fill="#FFFFFF" />
      <circle cx="8.1" cy="6" r="2.4" fill="#E30A17" />
      <polygon points="10.9,4.7 11.3,5.8 12.4,5.8 11.5,6.4 11.9,7.5 10.9,6.8 10,7.5 10.3,6.4 9.4,5.8 10.6,5.8" fill="#FFFFFF" />
    </>
  )}
  {locale === 'id' && (
    <>
      <rect width="18" height="6" fill="#CE1126" />
      <rect y="6" width="18" height="6" fill="#FFFFFF" />
    </>
  )}
  {locale === 'pl' && (
    <>
      <rect width="18" height="6" fill="#FFFFFF" />
      <rect y="6" width="18" height="6" fill="#DC143C" />
    </>
  )}
</svg>
