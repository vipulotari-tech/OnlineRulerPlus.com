---
import { DEFAULT_LOCALE, type Locale } from '../i18n/config.ts';
import { getDict } from '../i18n/index.ts';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const conv = getDict(locale).converter;
---

<div
  id="unit-converter-bar"
  class="mt-3 rounded-[14px] border border-hairline bg-canvas-parchment px-3 py-2.5 sm:px-4"
>
  <div class="flex flex-wrap items-center justify-between gap-2.5">
    <div class="flex items-center gap-2 shrink-0">
      <span class="font-mono text-[11px] font-semibold text-ink-muted-80">{conv.title}</span>
      <span id="conv-ppi-badge" class="rounded-full border border-hairline bg-canvas px-2 py-0.5 font-mono text-[10px] text-ink-muted-48">
        @ 96.0 PPI
      </span>
    </div>

    <div class="grid w-full grid-cols-2 gap-2 sm:w-auto sm:flex sm:flex-wrap sm:items-center font-mono text-xs">
      <label class="flex items-center gap-1.5 text-ink-muted-80">
        <span class="w-6 shrink-0">mm</span>
        <input
          id="conv-mm"
          type="number"
          min="0"
          step="0.1"
          aria-label={conv.mmAria}
          class="h-[44px] sm:h-[30px] w-full sm:w-20 rounded-full border border-hairline bg-canvas px-2.5 text-center text-base sm:text-xs font-semibold text-ink"
        />
      </label>

      <label class="flex items-center gap-1.5 text-ink-muted-80">
        <span class="w-6 shrink-0">cm</span>
        <input
          id="conv-cm"
          type="number"
          min="0"
          step="0.01"
          aria-label={conv.cmAria}
          class="h-[44px] sm:h-[30px] w-full sm:w-20 rounded-full border border-hairline bg-canvas px-2.5 text-center text-base sm:text-xs font-semibold text-ink"
        />
      </label>

      <label class="flex items-center gap-1.5 text-ink-muted-80">
        <span class="w-6 shrink-0">in</span>
        <input
          id="conv-in"
          type="number"
          min="0"
          step="0.001"
          aria-label={conv.inAria}
          class="h-[44px] sm:h-[30px] w-full sm:w-20 rounded-full border border-hairline bg-canvas px-2.5 text-center text-base sm:text-xs font-semibold text-ink"
        />
      </label>

      <label class="flex items-center gap-1.5 text-ink-muted-80">
        <span class="w-6 shrink-0">px</span>
        <input
          id="conv-px"
          type="number"
          min="0"
          step="1"
          aria-label={conv.pxAria}
          class="h-[44px] sm:h-[30px] w-full sm:w-20 rounded-full border border-hairline bg-canvas px-2.5 text-center text-base sm:text-xs font-semibold text-ink"
        />
      </label>

      <span class="col-span-2 pt-1 sm:col-span-1 sm:pt-0 sm:border-l sm:border-hairline sm:pl-2 text-[11px] font-semibold text-link" id="conv-frac-readout">
        3 3/8 in (3 3/8 in)
      </span>
    </div>
  </div>
</div>
