---
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../i18n/config.ts';
import { getDict, renderInlineMarkup } from '../i18n/index.ts';
import DiagramFigure from './DiagramFigure.astro';
import MotionWalkthrough from './MotionWalkthrough.astro';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const dict = getDict(locale);
const c = dict.home;
const v = dict.visuals;
---

<!-- SECTION 1: ONLINE RULER GUIDE -->
<section
  id="how-it-works"
  aria-labelledby="how-heading"
  class="apple-tile-light border-t border-hairline"
>
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="type-kicker">
          {c.howKicker}
        </p>
        <h2 id="how-heading" class="mt-1.5 type-display-lg text-ink">
          {c.howHeading}
        </h2>
        <p class="mt-3 max-w-3xl type-body text-ink-muted-80">
          {c.howLead}
        </p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a href={localizedPath(locale, '/how-to-use')} class="apple-btn-secondary-pill">
          {c.howManualBtn}
        </a>
        <a href="/blog" class="apple-btn-secondary-pill">
          {dict.nav.links.blog}
        </a>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        c.howCards.map((card) => (
          <article class="apple-utility-card flex flex-col justify-between">
            <div>
              <span class="type-kicker">{card.kicker}</span>
              <h3 class="mt-2 type-tagline text-ink">{card.heading}</h3>
              <p
                class="mt-2.5 type-caption text-ink-muted-80"
                set:html={renderInlineMarkup(card.body, locale)}
              />
            </div>
            {card.linkHref && card.linkLabel && (
              <a
                href={localizedPath(locale, card.linkHref)}
                data-open-calibration={card.isCardOpen ? 'card' : undefined}
                class="mt-4 type-caption font-semibold text-link hover:underline"
              >
                {card.linkLabel}
              </a>
            )}
          </article>
        ))
      }
    </div>

    <div class="mt-8">
      <MotionWalkthrough locale={locale} id="home-motion-walkthrough" />
    </div>
  </div>
</section>

<!-- SECTION 2: DISPLAY PIXEL DENSITY & PPI BENCHMARK TABLE (Dark Tile #272729) -->
<section
  id="accuracy-guide"
  aria-labelledby="accuracy-heading"
  class="apple-tile-dark"
>
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="font-mono text-xs font-semibold text-primary-on-dark">
          {c.accuracyKicker}
        </p>
        <h2 id="accuracy-heading" class="mt-1.5 type-display-lg text-on-dark">
          {c.accuracyHeading}
        </h2>
        <p class="mt-3 max-w-2xl type-body text-body-muted">
          {c.accuracyLead}
        </p>
      </div>
      <div class="shrink-0">
        <a href={localizedPath(locale, '/calibration-guide')} class="apple-btn-primary">
          {c.accuracyGuideBtn}
        </a>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-12">
      <!-- Left 4 Columns: Standards & Boundaries -->
      <div class="space-y-6 lg:col-span-4">
        <div class="rounded-[18px] border border-white/12 bg-surface-tile-2 p-6">
          <h3 class="type-tagline text-on-dark">
            {c.objectsTitle}
          </h3>
          <p class="mt-2.5 type-caption text-body-muted">
            {c.objectsBody}
          </p>
        </div>

        <div class="rounded-[18px] border border-white/12 bg-surface-tile-2 p-6">
          <h3 class="type-tagline text-on-dark">
            {c.limitsTitle}
          </h3>
          <p class="mt-2.5 type-caption text-body-muted">
            {c.limitsBody}
          </p>
        </div>
      </div>

      <!-- Right 8 Columns: Reference PPI Table -->
      <div class="rounded-[18px] border border-white/12 bg-surface-tile-2 p-6 lg:col-span-8 flex flex-col justify-between">
        <div>
          <div>
            <span class="font-mono text-xs font-semibold text-primary-on-dark">
              {c.ppiKicker}
            </span>
            <h3 id="ppi-table-heading" class="mt-1 type-tagline text-on-dark">
              {c.ppiHeading}
            </h3>
          </div>

          <div
            role="region"
            tabindex="0"
            aria-labelledby="ppi-table-heading"
            class="mt-5 overflow-x-auto focus-visible:rounded-[8px]"
          >
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-white/15 font-mono text-[11px] text-body-muted">
                  {c.ppiHeaders.map((header, i) => (
                    <th class:list={[
                      'py-2.5 font-semibold',
                      i === 0 ? 'pr-3' : i === c.ppiHeaders.length - 1 ? 'pl-3' : 'px-3',
                    ]}>
                      {header}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-white/10 font-mono text-xs">
                {
                  c.ppiRows.map((row) => (
                    <tr>
                      <td class="py-3 pr-3 font-sans font-medium text-on-dark">{row.device}</td>
                      <td class="py-3 px-3 text-body-muted">{row.res}</td>
                      <td class="py-3 px-3 font-semibold text-primary-on-dark">{row.ppi}</td>
                      <td class="py-3 px-3 text-on-dark">{row.pxMm}</td>
                      <td class="py-3 pl-3 text-body-muted">{row.err}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <p
          class="mt-5 border-t border-white/12 pt-4 type-fine-print text-body-muted [&_code]:text-on-dark"
          set:html={renderInlineMarkup(c.ppiFormula, locale)}
        />

        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-white/10 pt-3 font-mono text-[11px] text-body-muted">
          <span class="font-semibold text-on-dark">Standards:</span>
          <a
            href="https://www.nist.gov/pml/owm/si-units-length"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-on-dark hover:underline"
          >
            NIST SI Length (1 in = 25.4 mm)
          </a>
          <a
            href="https://www.bipm.org/en/measurement-units"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-on-dark hover:underline"
          >
            BIPM SI Brochure
          </a>
          <a
            href="https://www.w3.org/TR/css-values-3/#absolute-lengths"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-on-dark hover:underline"
          >
            W3C CSS 96 px/in
          </a>
          <a
            href="https://www.iso.org/standard/70483.html"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-on-dark hover:underline"
          >
            ISO/IEC 7810 ID-1
          </a>
        </div>
      </div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <DiagramFigure
        svgSrc="/visuals/diagrams/08-ruler-tape-caliper-comparison.svg"
        kicker={v.diagrams.d08.kicker}
        title={v.diagrams.d08.title}
        alt={v.diagrams.d08.alt}
        caption={v.diagrams.d08.caption}
      />
      <DiagramFigure
        svgSrc="/visuals/diagrams/09-screen-dpi-ppi-accuracy.svg"
        kicker={v.diagrams.d09.kicker}
        title={v.diagrams.d09.title}
        alt={v.diagrams.d09.alt}
        caption={v.diagrams.d09.caption}
      />
    </div>
  </div>
</section>

<!-- SECTION 3: DEDICATED RULER MODES & TOOLS (Parchment Tile #f5f5f7) -->
<section
  id="ruler-modes"
  aria-labelledby="modes-heading"
  class="apple-tile-parchment border-t border-hairline"
>
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="type-kicker">
        {c.modesKicker}
      </p>
      <h2 id="modes-heading" class="mt-1.5 type-display-lg text-ink">
        {c.modesHeading}
      </h2>
      <p class="mt-3 max-w-2xl type-body text-ink-muted-80">
        {c.modesLead}
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        c.modeCards.map((card, idx) => {
          const isLastStatic = idx === c.modeCards.length - 1 && card.href.startsWith('#');
          if (isLastStatic) {
            return (
              <div class="apple-utility-card flex flex-col justify-between">
                <div>
                  <span class="type-kicker">{card.kicker}</span>
                  <h3 class="mt-2 type-tagline text-ink">{card.heading}</h3>
                  <p class="mt-2 type-caption text-ink-muted-80">{card.body}</p>
                </div>
                <a href={localizedPath(locale, card.href)} class="mt-4 inline-flex items-center gap-1 type-caption font-semibold text-link hover:underline">
                  {card.linkLabel}
                </a>
              </div>
            );
          }
          return (
            <a href={localizedPath(locale, card.href)} class="apple-utility-card group flex flex-col justify-between hover:border-primary-focus transition-colors">
              <div>
                <span class="type-kicker">{card.kicker}</span>
                <h3 class="mt-2 type-tagline text-ink group-hover:text-link">{card.heading}</h3>
                <p class="mt-2 type-caption text-ink-muted-80">{card.body}</p>
              </div>
              <span class="mt-4 inline-flex items-center gap-1 type-caption font-semibold text-link">
                {card.linkLabel}
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<!-- SECTION 4: SEO FAQ ACCORDION (Light White Surface Tile #ffffff) -->
<section
  id="faq"
  aria-labelledby="faq-heading"
  class="apple-tile-light border-t border-hairline"
>
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="type-kicker">
          {c.faqKicker}
        </p>
        <h2 id="faq-heading" class="mt-1.5 type-display-lg text-ink">
          {c.faqHeading}
        </h2>
      </div>
      <a href={localizedPath(locale, '/faq')} class="apple-btn-secondary-pill shrink-0">
        {c.faqViewAllBtn}
      </a>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 lg:grid-cols-2">
      {
        c.faqs.map((item) => (
          <details open class="group apple-utility-card">
            <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-4 py-1 text-ink">
              <h3 class="type-body-strong text-ink">{item.q}</h3>
              <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-canvas-parchment font-mono text-base text-link group-open:rotate-45 transition-transform">
                +
              </span>
            </summary>
            <p class="mt-3 max-w-[65ch] type-caption text-ink-muted-80 border-t border-hairline pt-3">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
