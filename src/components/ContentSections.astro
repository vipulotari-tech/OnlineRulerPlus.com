<!-- SECTION 4: SEO FAQ ACCORDION (Light White Surface Tile #ffffff) -->
<section
  id="faq"
  aria-labelledby="faq-heading"
  class="apple-tile-light border-t border-hairline"
>
  <div class="mx-auto max-w-[1440px] px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="type-kicker">
          Frequently Asked Questions · Usage, Calibration &amp; Compatibility
        </p>
        <h2 id="faq-heading" class="mt-1.5 type-display-lg text-ink">
          Frequently Asked Questions About Online Rulers
        </h2>
      </div>
      <a href="/faq" class="apple-btn-secondary-pill shrink-0">
        View All 20 FAQs
      </a>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 lg:grid-cols-2">
      {
        faqItems.map((item) => (
          <details open class="group apple-utility-card">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-ink">
              <h3 class="type-body-strong text-ink">{item.q}</h3>
              <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-canvas-parchment font-mono text-base text-link group-open:rotate-45 transition-transform">
                +
              </span>
            </summary>
            <p class="mt-3 max-w-[65ch] type-caption text-ink-muted-80 border-t border-hairline pt-3">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
